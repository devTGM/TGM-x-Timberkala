      "settings": {
        "custom_liquid": "<style>\n/* ==========================\n   TIMBERKALA - ALSO AVAILABLE AT\n   PREMIUM BLACK MARQUEE\n========================== */\n\n.tk-stockists-section{\n  background:#000;\n  padding:24px 0;\n  overflow:hidden;\n}\n\n.tk-stockists-heading{\n  text-align:center;\n  color:#fff;\n  font-size:24px;\n  font-weight:500;\n  letter-spacing:3px;\n  text-transform:uppercase;\n  margin-bottom:24px;\n}\n\n.tk-stockists-heading span{\n  color:#d4af37;\n}\n\n/* Moving Logo Banner */\n.tk-logo-marquee{\n  width:100%;\n  overflow:hidden;\n  position:relative;\n}\n\n.tk-logo-track{\n  display:flex;\n  align-items:center;\n  gap:100px;\n  width:max-content;\n  animation:scrollLogos 30s linear infinite;\n}\n\n@keyframes scrollLogos{\n  from{\n    transform:translateX(0);\n  }\n  to{\n    transform:translateX(-50%);\n  }\n}\n\n/* Logos */\n.tk-logo{\n  height:140px;\n  width:auto;\n  object-fit:contain;\n  transition:all .4s ease;\n  opacity:0.95;\n}\n\n.tk-logo:hover{\n  transform:scale(1.08);\n  opacity:1;\n}\n\n/* Mobile */\n@media(max-width:768px){\n\n  .tk-stockists-section{\n    padding:18px 0;\n  }\n\n  .tk-stockists-heading{\n    font-size:18px;\n    letter-spacing:2px;\n    margin-bottom:18px;\n  }\n\n  .tk-logo-track{\n    gap:55px;\n  }\n\n  .tk-logo{\n    height:90px;\n  }\n}\n</style>\n\n<section class=\"tk-stockists-section\">\n\n  <h2 class=\"tk-stockists-heading\">\n    Also Available <span>At</span>\n  </h2>\n\n  <div class=\"tk-logo-marquee\">\n\n    <div class=\"tk-logo-track\">\n\n      <!-- Original Logos -->\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/Untitled_design_22.png?v=1770185590\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/2_f6982aaa-91a7-4419-a217-2e83458a56d0.png?v=1770184664\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/4_9b563f33-dfd2-43a9-8e3d-1553eb97c386.png?v=1770184664\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/1_cba8b45b-ac81-458b-9445-c23190569ed6.png?v=1770184664\" alt=\"Retail Partner\">\n\n      <!-- Duplicate for Smooth Infinite Loop -->\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/Untitled_design_22.png?v=1770185590\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/2_f6982aaa-91a7-4419-a217-2e83458a56d0.png?v=1770184664\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/4_9b563f33-dfd2-43a9-8e3d-1553eb97c386.png?v=1770184664\" alt=\"Retail Partner\">\n\n      <img class=\"tk-logo\" src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/1_cba8b45b-ac81-458b-9445-c23190569ed6.png?v=1770184664\" alt=\"Retail Partner\">\n\n    </div>\n\n  </div>\n\n</section>"
      }
