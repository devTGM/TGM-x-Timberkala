    "custom_liquid_zrmknp": {
      "type": "custom-liquid",
      "name": "Bed Room Living Room",
      "settings": {
        "custom_liquid": "<!-- ===== DESKTOP-ONLY Cinematic Split Section ===== -->\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n/* Scoped styles to prevent conflicts */\n#cineRoot {\n  --gold: #d4af37;\n  --gold-dark: #9c7c26;\n  --muted-white: rgba(255,255,255,0.95);\n  --btn-padding-x: 26px;\n  --btn-padding-y: 12px;\n}\n\n/* ===== Desktop layout ===== */\n#cineRoot {\n  display:flex;\n  width:100%;\n  min-height:90vh;\n  overflow:hidden;\n  font-family: \"Inter\", system-ui, Arial, sans-serif;\n  color: var(--muted-white);\n}\n#cineRoot .col {\n  flex:1;\n  position:relative;\n  overflow:hidden;\n  min-height:60vh;\n  display:block;\n}\n@keyframes zoomSlow { 0%{transform:scale(1)} 50%{transform:scale(1.08)} 100%{transform:scale(1)} }\n#cineRoot .bg {\n  position:absolute; inset:0;\n  background-size:cover; background-position:center;\n  animation: zoomSlow 22s ease-in-out infinite;\n  transform-origin:center;\n}\n#cineRoot .overlay {\n  position:absolute; inset:0;\n  background:linear-gradient(180deg, rgba(0,0,0,0.22), rgba(0,0,0,0.62));\n  z-index:1;\n}\n#cineRoot .content {\n  position:absolute;\n  left:50%; top:50%;\n  transform:translate(-50%,-50%);\n  z-index:2;\n  text-align:center;\n  padding:0 20px;\n  max-width:460px;\n}\n#cineRoot h2 {\n  margin:0 0 14px 0;\n  font-family:\"Inter\",\"Helvetica Neue\",Arial,sans-serif;\n  font-weight:700;\n  font-size: clamp(28px, 3.6vw, 48px);\n  letter-spacing:-0.5px;\n  line-height:1.08;\n  color:#fff;\n  text-shadow: 0 6px 20px rgba(0,0,0,0.6);\n}\n#cineRoot .divider {\n  width:74px; height:4px; margin:0 auto 18px;\n  border-radius:4px;\n  background: linear-gradient(90deg, var(--gold), var(--gold-dark));\n  box-shadow: 0 8px 22px rgba(212,175,55,0.28);\n}\n#cineRoot p {\n  margin:0 0 22px 0;\n  font-size:15px;\n  line-height:1.6;\n  color: var(--muted-white);\n}\n\n/* ===== GOLD OUTLINE BUTTON ===== */\n#cineRoot .gold-btn {\n  display:inline-flex;\n  align-items:center;\n  gap:10px;\n  padding: var(--btn-padding-y) var(--btn-padding-x);\n  border-radius:999px;\n  border:2px solid var(--gold);\n  background:transparent;\n  color:var(--muted-white);\n  font-weight:700;\n  letter-spacing:1px;\n  text-transform:uppercase;\n  text-decoration:none;\n  position:relative;\n  overflow:hidden;\n  cursor:pointer;\n  transition: transform .28s ease, color .28s ease, border-color .28s ease;\n  box-shadow: 0 6px 18px rgba(0,0,0,0.35), inset 0 -2px 0 rgba(255,255,255,0.02);\n  font-size:14px;\n  white-space: nowrap;\n}\n#cineRoot .gold-btn .arrow { display:inline-block; transform: translateX(0); transition: transform .28s ease; font-size:16px; line-height:1; }\n#cineRoot .gold-btn::before {\n  content: \"\";\n  position: absolute;\n  top: -10%; left: -60%;\n  width: 40%; height: 120%;\n  background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.14) 40%, rgba(255,255,255,0.6) 55%, rgba(255,255,255,0.12) 70%, rgba(255,255,255,0) 100%);\n  transform: skewX(-20deg);\n  filter: blur(3px);\n  opacity: 0.95;\n  animation: goldShineLoop 3.2s linear infinite;\n  pointer-events: none;\n}\n@keyframes goldShineLoop { 0% { left:-60%; opacity:0; } 10% { opacity:1; } 50% { left:120%; opacity:0.95; } 100% { left:120%; opacity:0; } }\n\n#cineRoot .gold-btn:hover { transform: translateY(-4px) scale(1.02); color: var(--gold); border-color: var(--gold-dark); box-shadow: 0 10px 30px rgba(0,0,0,0.45), 0 0 24px rgba(212,175,55,0.14); }\n#cineRoot .gold-btn:hover .arrow { transform: translateX(6px); }\n#cineRoot .gold-btn:focus { outline: 3px solid rgba(212,175,55,0.22); outline-offset: 4px; }\n\n/* ===== HIDE ON MOBILE ===== */\n@media (max-width: 768px) {\n  #cineRoot {\n    display: none !important;\n  }\n}\n</style>\n\n<!-- HTML markup for Desktop -->\n<div id=\"cineRoot\" class=\"cine-split\" role=\"region\" aria-label=\"Cinematic Split Showcase\">\n  <!-- Bedroom -->\n  <div class=\"col\" data-slide-index=\"0\">\n    <div class=\"bg\" style=\"background-image: url('https://www.timberkala.com/cdn/shop/files/DSC07849.jpg?v=1740811339&width=2000');\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"content\">\n      <h2>Bed Room</h2>\n      <div class=\"divider\"></div>\n      <p>Feel lively in your Bedroom with handcrafted, timeless furniture.</p>\n      <a href=\"https://www.timberkala.com/collections/artifacts\" class=\"gold-btn\" aria-label=\"Discover Bedroom\">\n        <span>Discover Bedroom</span><span class=\"arrow\">➝</span>\n      </a>\n    </div>\n  </div>\n\n  <!-- Living Room -->\n  <div class=\"col\" data-slide-index=\"1\">\n    <div class=\"bg\" style=\"background-image: url('https://www.timberkala.com/cdn/shop/files/DSC07470.jpg?v=1740807577&width=2000');\"></div>\n    <div class=\"overlay\"></div>\n    <div class=\"content\">\n      <h2>Living Room</h2>\n      <div class=\"divider\"></div>\n      <p>Refresh your living space with Timberkala’s statement pieces.</p>\n      <a href=\"https://www.timberkala.com/collections/animal-figurines\" class=\"gold-btn\" aria-label=\"Discover Living\">\n        <span>Discover Living</span><span class=\"arrow\">➝</span>\n      </a>\n    </div>\n  </div>\n</div>"
      }
    },
    "custom_liquid_jeA6QL": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<h2 class=\"mobile-heading\">\n  Discover Timber Kala in Action\n</h2>\n\n<style>\n.mobile-heading{\n  display:none;\n  background:#000;\n  color:#fff;\n  text-align:center;\n  padding:18px 20px;\n  margin:0;\n  font-size:20px;\n  font-weight:500;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  border-top:1px solid rgba(212,175,55,.25);\n  border-bottom:1px solid rgba(212,175,55,.25);\n}\n\n@media(max-width:768px){\n  .mobile-heading{\n    display:block;\n  }\n}\n</style>"
      }
    },
    "custom_liquid_g8bCyQ": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n:root{\n  --gold:#d4af37;\n  --black:#000;\n  --white:#fff;\n}\n/* SECTION */\n.tk-luxury-gallery{\n  background:#000;\n  padding:24px 14px;\n}\n.tk-gallery-inner{\n  max-width:1250px;\n  margin:auto;\n}\n/* HEADING */\n.tk-heading{\n  text-align:center;\n  color:#fff;\n  font-size:24px;\n  font-weight:500;\n  letter-spacing:3px;\n  text-transform:uppercase;\n  margin-bottom:22px;\n}\n.tk-heading:after{\n  content:\"\";\n  display:block;\n  width:80px;\n  height:1px;\n  background:var(--gold);\n  margin:12px auto 0;\n}\n/* GRID */\n.tk-grid{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:16px;\n}\n/* CARD */\n.tk-card{\n  position:relative;\n  overflow:hidden;\n  background:#111;\n  transition:.4s ease;\n}\n.tk-card:hover{\n  transform:translateY(-4px);\n}\n.tk-card img{\n  width:100%;\n  aspect-ratio:4/5;\n  object-fit:cover;\n  display:block;\n  transition:transform .8s ease;\n}\n.tk-card:hover img{\n  transform:scale(1.08);\n}\n/* DARK OVERLAY */\n.tk-overlay{\n  position:absolute;\n  inset:0;\n  background:linear-gradient(\n    to top,\n    rgba(0,0,0,.92) 0%,\n    rgba(0,0,0,.55) 40%,\n    transparent 100%\n  );\n}\n/* LARGE PREMIUM BUTTON */\n.tk-btn{\n  position:absolute;\n  left:50%;\n  bottom:22px;\n  transform:translateX(-50%);\n  z-index:2;\n  min-width:220px;\n  text-align:center;\n  text-decoration:none;\n  color:#fff;\n  border:1px solid var(--gold);\n  background:rgba(0,0,0,.45);\n  backdrop-filter:blur(8px);\n  padding:16px 26px;\n  font-size:14px;\n  font-weight:600;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  transition:.35s ease;\n}\n.tk-btn:hover{\n  background:var(--gold);\n  color:#000;\n}\n/* MOBILE */\n@media(max-width:768px){\n  .tk-luxury-gallery{\n    padding:18px 10px;\n  }\n  .tk-grid{\n    grid-template-columns:1fr;\n    gap:12px;\n  }\n  .tk-heading{\n    font-size:18px;\n    margin-bottom:16px;\n  }\n  .tk-btn{\n    min-width:240px;\n    padding:15px 22px;\n    font-size:13px;\n    letter-spacing:1.5px;\n  }\n}\n</style>\n<section class=\"tk-luxury-gallery\">\n  <div class=\"tk-gallery-inner\">\n    <h2 class=\"tk-heading\">Modern Made Simple</h2>\n    <div class=\"tk-grid\">\n      <!-- HANGINGS -->\n      <div class=\"tk-card\">\n        <img src=\"https://www.timberkala.com/cdn/shop/files/DSC08250.webp?v=1759836190&width=2048\" alt=\"Hangings\">\n        <div class=\"tk-overlay\"></div>\n        <a class=\"tk-btn\" href=\"/collections/hangings-1\">\n          HANGINGS\n        </a>\n      </div>\n      <!-- ANIMAL FIGURINES -->\n      <div class=\"tk-card\">\n        <img src=\"https://www.timberkala.com/cdn/shop/files/DSC08011.webp?v=1759923115&width=4096\" alt=\"Animal Figurines\">\n        <div class=\"tk-overlay\"></div>\n        <a class=\"tk-btn\" href=\"/collections/animal-figurines\">\n          ANIMAL FIGURINES\n        </a>\n      </div>\n      <!-- ANIMAL & BIRDS -->\n      <div class=\"tk-card\">\n        <img src=\"https://www.timberkala.com/cdn/shop/files/17.webp?v=1759735005&width=1000\" alt=\"Animal and Birds\">\n        <div class=\"tk-overlay\"></div>\n        <a class=\"tk-btn\" href=\"/collections/animal-and-birds\">\n          ANIMAL & BIRDS\n        </a>\n      </div>\n    </div>\n  </div>\n</section>"
      }
    },
    "custom_liquid_CHC3cf": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Timberkala Premium Responsive Section</title>\n    <style>\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n            background-color: #f8f9fa;\n        }\n\n        /* Main Section Wrapper with INCREASED Top Padding */\n        .timberkala-main-section {\n            padding: 100px 20px 60px 20px; /* Top me 100px padding, Bottom me 60px, Sides me 20px */\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        /* Joint Container - Single Corner Radius */\n        .joint-media-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr; /* Desktop: Left 50% Image, Right 50% Map */\n            border-radius: 24px; /* Poore structure ke corners ek sath curve honge */\n            overflow: hidden; /* Taaki corners perfect round dikhein aur edges cut na ho */\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);\n            background: #ffffff;\n        }\n\n        /* Responsive Blocks Height */\n        .media-block {\n            height: 480px; /* Desktop standard height */\n            display: flex;\n            width: 100%;\n        }\n\n        .media-block img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover; /* Image stretch nahi hogi, perfectly crop hokar fit hogi */\n            display: block;\n        }\n\n        .media-block iframe {\n            width: 100%;\n            height: 100%;\n            border: none;\n            display: block;\n        }\n\n        /* Premium Visit Text Line */\n        .visit-text-container {\n            text-align: center;\n            margin-top: 24px;\n            padding: 0 15px;\n        }\n\n        .visit-text-line {\n            font-size: 16px;\n            color: #333333;\n            font-weight: 500;\n            line-height: 1.6;\n            display: inline-block;\n        }\n\n        .visit-text-line a {\n            color: #d35400; /* Timber/Wood matching premium accent color */\n            text-decoration: none;\n            font-weight: 600;\n            border-bottom: 2px solid rgba(211, 84, 0, 0.2);\n            transition: all 0.3s ease;\n            padding-bottom: 2px;\n        }\n\n        .visit-text-line a:hover {\n            border-bottom-color: #d35400;\n            color: #ba4a00;\n        }\n\n        /* Mobile & Tablet Responsiveness */\n        @media (max-width: 768px) {\n            .timberkala-main-section {\n                padding: 60px 16px 40px 16px; /* Mobile par top padding 60px set ki hai balanced look ke liye */\n            }\n\n            .joint-media-container {\n                grid-template-columns: 1fr; /* Mobile par automatically ek ke niche ek stack ho jayega */\n                border-radius: 20px; /* Mobile screen ke liye balanced rounded corners */\n            }\n\n            .media-block {\n                height: 320px; /* Mobile par dono blocks ki height automatic optimize ho jayegi */\n            }\n\n            .visit-text-line {\n                font-size: 14px; /* Mobile friendly readable font size */\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <!-- Top Padding Wrapper -->\n    <div class=\"timberkala-main-section\">\n        \n        <!-- Joint Layout Section -->\n        <div class=\"joint-media-container\">\n            \n            <!-- Left Side: Image -->\n            <div class=\"media-block\">\n                <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/timberkala_section.webp?v=1779279582\" alt=\"Timberkala Showroom View\">\n            </div>\n\n            <!-- Right Side: Google Map -->\n            <div class=\"media-block\">\n                <iframe \n                    src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3506.2736184285144!2d77.4026859!3d28.5021359!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390ce62685555555%3A0x95cf7b3226db9775!2sTimberkala!5e0!3m2!1sen!2sin!4v1716212345678!5m2!1sen!2sin\" \n                    allowfullscreen=\"\" \n                    loading=\"lazy\" \n                    referrerpolicy=\"no-referrer-when-downgrade\">\n                </iframe>\n            </div>\n\n        </div>\n\n        <!-- Visit Us Call-To-Action Line -->\n        <div class=\"visit-text-container\">\n            <p class=\"visit-text-line\">\n                Experience our premium craftsmanship live — <a href=\"https://maps.app.goo.gl/TkM5tXtyGmXAf3VZ7\" target=\"\">Visit the Timberkala Store</a> or navigate using Google Maps.\n            </p>\n        </div>\n\n    </div>\n\n</body>\n</html>"
      }
    },
    "custom_liquid_ehFia3": {
