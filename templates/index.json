    "custom_liquid_D3Y4wx": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- ZERO-LEAK: Namespaced Premium Features (paste only AFTER removing old features block) -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\">\n\n<div class=\"tk-features\" aria-label=\"Premium features — Timberkala\">\n  <section class=\"tk-features__wrap\" aria-labelledby=\"tk-features-heading\">\n    <h2 id=\"tk-features-heading\" class=\"tk-features__sr-only\">Premium Features</h2>\n\n    <div class=\"tk-features__row\" role=\"list\">\n      \n      <!-- Free Shipping -->\n      <article class=\"tk-feature\" role=\"listitem\" aria-label=\"Free Shipping\">\n        <div class=\"tk-feature__icon\" aria-hidden=\"true\"><i class=\"fas fa-truck\"></i></div>\n        <div class=\"tk-feature__content\">\n          <h3 class=\"tk-feature__title\">Free Shipping</h3>\n          <p class=\"tk-feature__desc\">Free Shipping Above ₹2000 All Over India</p>\n        </div>\n      </article>\n\n      <!-- 100% Recycled Wood -->\n      <article class=\"tk-feature\" role=\"listitem\" aria-label=\"100% Recycled Wood\">\n        <div class=\"tk-feature__icon\" aria-hidden=\"true\"><i class=\"fas fa-tree\"></i></div>\n        <div class=\"tk-feature__content\">\n          <h3 class=\"tk-feature__title\">100% Recycled Wood</h3>\n          <p class=\"tk-feature__desc\">Eco-friendly & Sustainable Materials</p>\n        </div>\n      </article>\n\n      <!-- 5000+ Families Trust -->\n      <article class=\"tk-feature\" role=\"listitem\" aria-label=\"5000+ Families Trust\">\n        <div class=\"tk-feature__icon\" aria-hidden=\"true\"><i class=\"fas fa-users\"></i></div>\n        <div class=\"tk-feature__content\">\n          <h3 class=\"tk-feature__title\">5000+ Families Trust</h3>\n          <p class=\"tk-feature__desc\">Trusted by Families Across India</p>\n        </div>\n      </article>\n\n      <!-- Flexible Payment -->\n      <article class=\"tk-feature\" role=\"listitem\" aria-label=\"Flexible Payment\">\n        <div class=\"tk-feature__icon\" aria-hidden=\"true\"><i class=\"fas fa-credit-card\"></i></div>\n        <div class=\"tk-feature__content\">\n          <h3 class=\"tk-feature__title\">Flexible Payment</h3>\n          <p class=\"tk-feature__desc\">Pay with Multiple Credit Cards</p>\n        </div>\n      </article>\n\n    </div>\n  </section>\n</div>\n\n<style>\n/* --- All styles strictly scoped under .tk-features --- */\n.tk-features { \n  --tk-max-width: 1200px;\n  --tk-bg-box: #000;\n  --tk-text: #fff;\n  --tk-muted: #d1d1d1;\n  --tk-gap: 18px;\n  display: block;\n  box-sizing: border-box;\n  margin: 0;\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n}\n\n.tk-features__sr-only {\n  position: absolute !important;\n  width: 1px; height: 1px;\n  padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0 0 0 0);\n  white-space: nowrap; border: 0;\n}\n\n.tk-features__wrap {\n  background: transparent;\n  padding: 36px 16px;\n  box-sizing: border-box;\n}\n\n.tk-features__row {\n  max-width: var(--tk-max-width);\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: var(--tk-gap);\n  align-items: stretch;\n  box-sizing: border-box;\n}\n\n.tk-feature {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n  background: var(--tk-bg-box);\n  color: var(--tk-text);\n  padding: 20px;\n  box-sizing: border-box;\n  width: 100%;\n  min-height: 84px;\n  border-radius: 14px; /* smoother rounded edges */\n  border: 0;\n  text-align: left;\n  transition: transform .28s ease, box-shadow .28s ease;\n}\n\n.tk-feature:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 14px 36px rgba(0,0,0,0.15);\n}\n\n.tk-feature__icon {\n  width: 56px;\n  height: 40px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: #111;\n  color: var(--tk-text);\n  font-size: 22px;\n  flex-shrink: 0;\n  border-radius: 10px; /* soft rounded corners */\n}\n\n.tk-feature__content { min-width:0; }\n.tk-feature__title {\n  margin: 0 0 6px 0;\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--tk-text);\n  line-height: 1.15;\n}\n.tk-feature__desc {\n  margin: 0;\n  font-size: 13px;\n  color: var(--tk-muted);\n  line-height: 1.3;\n}\n\n.tk-feature:focus-within,\n.tk-feature:focus {\n  outline: 3px solid rgba(255,215,120,0.15);\n  outline-offset: 2px;\n}\n\n@media (max-width: 900px) {\n  .tk-feature { min-height: 76px; padding: 16px; border-radius: 12px; }\n  .tk-feature__icon { width: 52px; height: 36px; font-size: 20px; border-radius: 8px; }\n}\n@media (max-width: 560px) {\n  .tk-features__wrap { padding: 20px 12px; }\n  .tk-feature { padding: 12px; min-height: 64px; gap: 12px; border-radius: 10px; }\n  .tk-feature__icon { width: 48px; height: 36px; font-size: 18px; border-radius: 6px; }\n  .tk-feature__title { font-size: 15px; }\n  .tk-feature__desc { font-size: 12px; }\n}\n</style>"
      }
    },
    "custom_liquid_JM7at8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>About TimberKala — Example</title>\n  <style>\n    body { font-family: Inter, system-ui, Arial, sans-serif; margin:24px; color:#222; background:#fff; }\n    .about-card { max-width:900px; margin:0 auto; padding:28px; border-radius:8px; }\n    h2 { margin:0 0 12px; font-size:22px; color:#2b2b2b; }\n    p.lead { margin:0 0 16px; line-height:1.5; color:#444; }\n\n    .btn { display:inline-block; padding:10px 14px; border-radius:6px; border:1px solid #b19774; background:transparent; color:#b19774; text-decoration:none; cursor:pointer; font-weight:600; }\n    .btn:focus { outline:3px solid rgba(177,151,116,0.18); outline-offset:2px; }\n\n    .modal-overlay { position:fixed; inset:0; background:rgba(17,17,17,0.55); display:none; align-items:center; justify-content:center; z-index:1000; padding:20px; }\n    .modal-overlay.show { display:flex; }\n    .modal-panel { background:#fff; max-width:820px; width:100%; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,0.25); padding:20px 22px; max-height:85vh; overflow:auto; position:relative; }\n    .modal-header { display:flex; align-items:center; justify-content:space-between; gap:12px; }\n    .modal-title { font-size:18px; margin:0; color:#111; }\n    .modal-body { margin-top:12px; color:#333; line-height:1.6; }\n\n    .close-btn { background:transparent; border:0; font-size:22px; padding:6px 10px; cursor:pointer; color:#666; border-radius:6px; }\n    .close-btn:focus { outline:3px solid rgba(0,0,0,0.12); outline-offset:2px; }\n\n    /* list styling */\n    .modal-body ul { margin:8px 0 12px 20px; }\n\n    @media (max-width:520px){\n      .modal-panel { padding:16px; border-radius:8px; }\n      h2{ font-size:18px; }\n    }\n  </style>\n</head>\n<body>\n\n  <article class=\"about-card\" aria-labelledby=\"about-title\">\n    <h2 id=\"about-title\">About TimberKala</h2>\n\n    <p class=\"lead\">\n      TimberKala is a premium wooden décor brand celebrating creativity, individuality, and fine craftsmanship. With products that balance function and aesthetics, we aim to transform homes with uniquely designed, high-quality pieces made with love and precision.\n    </p>\n\n    <button id=\"readMoreBtn\" class=\"btn\" aria-expanded=\"false\" aria-controls=\"aboutModal\">\n      Read More\n    </button>\n  </article>\n\n  <!-- Modal structure: role=dialog, aria-labelledby points to first heading inside modal -->\n  <div id=\"aboutModal\" class=\"modal-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modalH1\" tabindex=\"-1\">\n    <div class=\"modal-panel\" role=\"document\">\n      <div class=\"modal-header\">\n        <!-- Visually we show a simple symbol on the right; main headings are inside body as requested -->\n        <button class=\"close-btn\" id=\"modalClose\" aria-label=\"Close dialog\">&times;</button>\n      </div>\n\n      <div class=\"modal-body\" id=\"modalContent\">\n        <!-- Content provided by user, with each requested =h2 rendered as an actual h2 -->\n        <h2 id=\"modalH1\">Modern Home Decoration Items by Timber Kala</h2>\n\n        <h2 class=\"sr-only\" style=\"display:none;\">Transform Your Space with Handcrafted Wooden Art</h2>\n        <!-- If you want \"Transform Your Space...\" to visually appear as a subtitle, keep it as a visible element.\n             The user asked headings to be H2 — I've rendered the main section headings as H2 below. -->\n        <h3 style=\"margin-top:8px; margin-bottom:6px; font-size:18px; color:#444;\">Transform Your Space with Handcrafted Wooden Art</h3>\n\n        <p>\n          At Timber Kala, we believe that your home should tell your story - warm, soulful, and beautifully designed. Our home decoration items are more than just decor; they are handcrafted pieces of art that bring life, warmth, and character to every corner of your house.\n        </p>\n\n        <p>\n          A well-decorated home doesn’t just look appealing - it feels alive. From the moment you step in, the right home decor products can set the mood to relax, unwind, and connect with your loved ones. Each of our creations is made by skilled artisans using sustainable wood, blending timeless craftsmanship with a modern aesthetic that lasts a lifetime.\n        </p>\n\n        <h2>Buy Home Decor Products Online - Crafted for Modern Indian Homes</h2>\n\n        <p>\n          Before you buy home decor products online, take a moment to understand your home’s theme - is it minimalist, rustic, contemporary, or traditional? Once you define your style, Timber Kala helps you find decor that complements your personality.\n        </p>\n\n        <p>\n          Every product at Timber Kala is made with 100% eco-friendly, termite-free wood and a deep respect for nature. With us, you don’t just decorate your home - you celebrate art, sustainability, and craftsmanship.\n        </p>\n\n        <h2>Explore the Best Home Decor Websites in India</h2>\n\n        <p>\n          We take pride in being among the best home decor websites in India, offering everything from wooden wall art to elegant showpieces that redefine modern living.\n        </p>\n\n        <p><strong>Discover our exclusive range of:</strong></p>\n        <ul>\n          <li>Wooden wall decor and sculptures</li>\n          <li>Handcrafted showpieces</li>\n          <li>Accent furniture and decor accessories</li>\n          <li>Decorative wall hangings</li>\n          <li>Functional art pieces made with purpose and beauty</li>\n        </ul>\n\n        <p>\n          Each piece is handcrafted to perfection, designed to blend seamlessly with modern interiors while preserving the raw beauty of natural wood.\n        </p>\n\n        <h2>Shop Home Decoration Items Online – Designed to Last a Lifetime</h2>\n\n        <p>\n          Looking for home decoration items online that reflect luxury, durability, and artistry? Timber Kala offers you timeless wooden decor that combines global design trends with Indian craftsmanship.\n        </p>\n\n        <p>\n          We ensure that each product embodies the seven elements of interior design - space, line, light, shape, color, pattern, and texture - so that every decor item enhances the elegance of your home effortlessly.\n        </p>\n\n        <p><strong>When you shop from our home decor store online, you enjoy:</strong></p>\n        <ul>\n          <li>100% handcrafted and eco-friendly wooden art</li>\n          <li>Free shipping anywhere in India</li>\n          <li>Safe and easy online ordering process</li>\n          <li>Dedicated customer support and simple return policy</li>\n        </ul>\n\n        <h2>Why Choose Timber Kala?</h2>\n\n        <p>\n          Timber Kala is not just another home decor store online - it’s a tribute to Indian artistry and sustainable design. Every item is thoughtfully crafted to bring “perfection from imperfection,” following the timeless Wabi-Sabi philosophy.\n      </p>\n\n        <p>\n          We offer you a collection where every curve, grain, and detail tells a story of tradition, craftsmanship, and contemporary design. Whether you’re decorating your living room, bedroom, or workspace, Timber Kala gives every space a soul.\n        </p>\n\n        <p>\n          So, begin your journey to transform your house into a warm, elegant home. Explore our range of wooden home decorative items today - because your space deserves art that lasts.\n        </p>\n      <h2>Our Bestsellers\n</h2>\n\n        <p>\n          Giraffe Tall Tracks\nA handcrafted wooden sculpture that captures the grace and poise of nature’s tallest creature. Perfect for adding height, warmth, and elegance to modern spaces.\n            </p>\n\n\n            <p>\nMukha Buddha for Decor\nA timeless piece symbolizing serenity and inner peace. Handcrafted with precision, it adds a calm, spiritual touch to your home décor.\n          </p>\n\n\n          <p>\nGlass on Wood Collection\nA unique fusion of wood and glass that creates balance, light, and modern sophistication in your living space.\n        </p>\n\n\n        <p>\nWind Chimes\nCrafted from sustainable wood to create soothing tones that invite peace and positivity into your home.\n         </p>\n\n\n        <p>\nGanesha’s Echo\nA divine wooden sculpture celebrating wisdom and new beginnings. Intricately carved to inspire faith and harmony in every corner.\n\n      </p>\n      \n       </div>\n\n      <div style=\"display:flex; justify-content:flex-end; margin-top:14px;\">\n        <button class=\"btn\" id=\"modalCloseFooter\">Close</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    (function(){\n      const openBtn = document.getElementById('readMoreBtn');\n      const overlay = document.getElementById('aboutModal');\n      const closeTop = document.getElementById('modalClose');\n      const closeFooter = document.getElementById('modalCloseFooter');\n      const focusableSelectors = 'a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), [tabindex]:not([tabindex=\"-1\"])';\n      let lastFocused = null;\n\n      function openModal() {\n        lastFocused = document.activeElement;\n        overlay.classList.add('show');\n        openBtn.setAttribute('aria-expanded','true');\n        overlay.setAttribute('tabindex','-1');\n        // focus first h2 inside modal for screen readers\n        setTimeout(()=> {\n          const firstHeading = overlay.querySelector('h2');\n          const firstFocusable = overlay.querySelectorAll(focusableSelectors)[0];\n          if(firstHeading){\n            // make heading focusable briefly to move focus there\n            firstHeading.setAttribute('tabindex','-1');\n            firstHeading.focus();\n            // remove the tabindex after brief delay to keep DOM clean\n            setTimeout(()=> firstHeading.removeAttribute('tabindex'), 50);\n          } else if (firstFocusable) {\n            firstFocusable.focus();\n          } else {\n            overlay.focus();\n          }\n        }, 10);\n        document.addEventListener('keydown', onKeyDown);\n      }\n\n      function closeModal() {\n        overlay.classList.remove('show');\n        openBtn.setAttribute('aria-expanded','false');\n        document.removeEventListener('keydown', onKeyDown);\n        if (lastFocused) lastFocused.focus();\n      }\n\n      function onKeyDown(e) {\n        if (e.key === 'Escape') {\n          closeModal();\n        }\n        if (e.key === 'Tab') {\n          const focusables = Array.from(overlay.querySelectorAll(focusableSelectors));\n          if (focusables.length === 0) return;\n          const first = focusables[0];\n          const last = focusables[focusables.length - 1];\n          if (e.shiftKey && document.activeElement === first) {\n            e.preventDefault();\n            last.focus();\n          } else if (!e.shiftKey && document.activeElement === last) {\n            e.preventDefault();\n            first.focus();\n          }\n        }\n      }\n\n      openBtn.addEventListener('click', openModal);\n      closeTop.addEventListener('click', closeModal);\n      closeFooter.addEventListener('click', closeModal);\n\n      overlay.addEventListener('click', function(e){\n        if (e.target === overlay) closeModal();\n      });\n\n      const panel = overlay.querySelector('.modal-panel');\n      if(panel) panel.addEventListener('click', (e)=> e.stopPropagation());\n\n      window.__TimberKalaModal = { openModal, closeModal };\n    })();\n  </script>\n</body>\n</html>"
      }
