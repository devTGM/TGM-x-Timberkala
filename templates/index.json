        "custom_liquid": "<div class=\"timberkala-hero-slider\">\n  \n  <!-- Slide 1 -->\n  <div class=\"tk-slide active\">\n    <a href=\"https://www.timberkala.com/collections/all-products\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/b_day_web_banner__jpg.webp?v=1773054950\" alt=\"Banner 1\" fetchpriority=\"high\">\n    </a>\n  </div>\n\n  <!-- Slide 2 -->\n  <div class=\"tk-slide\">\n    <a href=\"https://www.timberkala.com/collections/all-products\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/b_day_web_banner_2_jpg.webp?v=1773054950\" alt=\"Banner 2\">\n    </a>\n  </div>\n\n  <!-- Arrows -->\n  <button class=\"tk-prev\" onclick=\"changeSlide(-1)\">&#10094;</button>\n  <button class=\"tk-next\" onclick=\"changeSlide(1)\">&#10095;</button>\n\n  <!-- Dots -->\n  <div class=\"tk-dots\">\n    <span class=\"dot active\" onclick=\"currentSlide(0)\"></span>\n    <span class=\"dot\" onclick=\"currentSlide(1)\"></span>\n  </div>\n\n</div>\n\n<style>\n.timberkala-hero-slider {\n  width: 100%;\n  height: 100vh;\n  position: relative;\n  overflow: hidden;\n  background: #000;\n}\n\n.tk-slide {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  transition: opacity 1s ease-in-out;\n  z-index: 1;\n}\n\n.tk-slide.active {\n  opacity: 1;\n  z-index: 2;\n}\n\n.tk-slide img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.tk-prev, .tk-next {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 10;\n  background: rgba(255,255,255,0.2);\n  color: #fff;\n  border: none;\n  padding: 15px 20px;\n  cursor: pointer;\n  font-size: 20px;\n  border-radius: 5px;\n}\n\n.tk-prev { left: 20px; }\n.tk-next { right: 20px; }\n\n.tk-dots {\n  position: absolute;\n  bottom: 30px;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  gap: 10px;\n  z-index: 10;\n}\n\n.dot {\n  width: 12px;\n  height: 12px;\n  background: rgba(255,255,255,0.4);\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n.dot.active {\n  width: 30px;\n  background: #fff;\n  border-radius: 10px;\n}\n\n/* Desktop Only */\n@media (max-width: 767px) {\n  .timberkala-hero-slider { display: none !important; }\n}\n\n@media (max-width: 1024px) {\n  .timberkala-hero-slider { height: 75vh; }\n}\n</style>\n\n<script>\nlet slideIndex = 0;\nconst slides = document.querySelectorAll('.tk-slide');\nconst dots = document.querySelectorAll('.dot');\nlet autoPlayInterval;\n\nfunction showSlides(n) {\n  if (n >= slides.length) slideIndex = 0;\n  if (n < 0) slideIndex = slides.length - 1;\n\n  slides.forEach(s => s.classList.remove('active'));\n  dots.forEach(d => d.classList.remove('active'));\n\n  slides[slideIndex].classList.add('active');\n  dots[slideIndex].classList.add('active');\n}\n\nfunction changeSlide(n) {\n  clearInterval(autoPlayInterval);\n  slideIndex += n;\n  showSlides(slideIndex);\n  startAutoPlay();\n}\n\nfunction currentSlide(n) {\n  clearInterval(autoPlayInterval);\n  slideIndex = n;\n  showSlides(slideIndex);\n  startAutoPlay();\n}\n\nfunction startAutoPlay() {\n  autoPlayInterval = setInterval(() => {\n    slideIndex++;\n    showSlides(slideIndex);\n  }, 5000);\n}\n\nstartAutoPlay();\n</script><div class=\"timberkala-hero-slider\">\n  \n  <!-- Slide 1 -->\n  <div class=\"tk-slide active\">\n    <a href=\"https://www.timberkala.com/collections/all-products\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/b_day_web_banner__jpg.webp?v=1773054950\" alt=\"Banner 1\" fetchpriority=\"high\">\n    </a>\n  </div>\n\n  <!-- Slide 2 -->\n  <div class=\"tk-slide\">\n    <a href=\"https://www.timberkala.com/collections/all-products\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/b_day_web_banner_2_jpg.webp?v=1773054950\" alt=\"Banner 2\">\n    </a>\n  </div>\n\n  <!-- Arrows -->\n  <button class=\"tk-prev\" onclick=\"changeSlide(-1)\">&#10094;</button>\n  <button class=\"tk-next\" onclick=\"changeSlide(1)\">&#10095;</button>\n\n  <!-- Dots -->\n  <div class=\"tk-dots\">\n    <span class=\"dot active\" onclick=\"currentSlide(0)\"></span>\n    <span class=\"dot\" onclick=\"currentSlide(1)\"></span>\n  </div>\n\n</div>\n\n<style>\n.timberkala-hero-slider {\n  width: 100%;\n  height: 100vh;\n  position: relative;\n  overflow: hidden;\n  background: #000;\n}\n\n.tk-slide {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  transition: opacity 1s ease-in-out;\n  z-index: 1;\n}\n\n.tk-slide.active {\n  opacity: 1;\n  z-index: 2;\n}\n\n.tk-slide img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.tk-prev, .tk-next {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 10;\n  background: rgba(255,255,255,0.2);\n  color: #fff;\n  border: none;\n  padding: 15px 20px;\n  cursor: pointer;\n  font-size: 20px;\n  border-radius: 5px;\n}\n\n.tk-prev { left: 20px; }\n.tk-next { right: 20px; }\n\n.tk-dots {\n  position: absolute;\n  bottom: 30px;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  gap: 10px;\n  z-index: 10;\n}\n\n.dot {\n  width: 12px;\n  height: 12px;\n  background: rgba(255,255,255,0.4);\n  border-radius: 50%;\n  cursor: pointer;\n}\n\n.dot.active {\n  width: 30px;\n  background: #fff;\n  border-radius: 10px;\n}\n\n/* Desktop Only */\n@media (max-width: 767px) {\n  .timberkala-hero-slider { display: none !important; }\n}\n\n@media (max-width: 1024px) {\n  .timberkala-hero-slider { height: 75vh; }\n}\n</style>\n\n<script>\nlet slideIndex = 0;\nconst slides = document.querySelectorAll('.tk-slide');\nconst dots = document.querySelectorAll('.dot');\nlet autoPlayInterval;\n\nfunction showSlides(n) {\n  if (n >= slides.length) slideIndex = 0;\n  if (n < 0) slideIndex = slides.length - 1;\n\n  slides.forEach(s => s.classList.remove('active'));\n  dots.forEach(d => d.classList.remove('active'));\n\n  slides[slideIndex].classList.add('active');\n  dots[slideIndex].classList.add('active');\n}\n\nfunction changeSlide(n) {\n  clearInterval(autoPlayInterval);\n  slideIndex += n;\n  showSlides(slideIndex);\n  startAutoPlay();\n}\n\nfunction currentSlide(n) {\n  clearInterval(autoPlayInterval);\n  slideIndex = n;\n  showSlides(slideIndex);\n  startAutoPlay();\n}\n\nfunction startAutoPlay() {\n  autoPlayInterval = setInterval(() => {\n    slideIndex++;\n    showSlides(slideIndex);\n  }, 5000);\n}\n\nstartAutoPlay();\n</script>"
