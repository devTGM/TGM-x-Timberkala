      "settings": {
        "custom_liquid": "<!-- Swiper CSS (future use ke liye rehne diya hai) -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" />\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Harmonia+Sans:wght@400;600&display=swap');\n\n  body {\n    background: #f9f8f5;\n    font-family: 'Harmonia Sans', sans-serif;\n  }\n\n  .category-section-premium {\n    max-width: 1320px;\n    margin: 70px auto;\n    padding: 8px 24px;\n  }\n\n  /* ✅ Mobile par pura section hide */\n  @media (max-width: 767px) {\n    .category-section-premium {\n      display: none;\n    }\n  }\n\n  /* ✅ Heading Style */\n  .category-heading {\n    text-align: center;\n    font-size: 24px;\n    font-weight: 600;\n    color: #1a1a1a;\n    margin-bottom: 40px;\n    letter-spacing: 1px;\n  }\n\n  /* ---- Circle Style ---- */\n  .circle-wrapper {\n    width: 100%;\n    padding-top: 100%;\n    position: relative;\n    border-radius: 50%;\n    overflow: hidden;\n    background: #fff;\n    border: 2px solid rgba(212,175,55,0.35);\n    box-shadow: inset 0 0 8px rgba(0,0,0,0.08), 0 10px 25px rgba(0,0,0,0.08);\n    transition: all 0.5s ease;\n  }\n\n  .circle-wrapper img {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.6s ease;\n    z-index: 1;\n  }\n\n  /* Shine effect */\n  .circle-wrapper::after {\n    content: '';\n    position: absolute;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    background: linear-gradient(120deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 60%);\n    transform: rotate(25deg) translateX(-100%);\n    transition: transform 0.8s ease;\n    z-index: 2;\n  }\n\n  /* Hover Effects */\n  .category-item:hover .circle-wrapper {\n    transform: scale(1.05);\n    border-color: #D4AF37;\n    box-shadow: 0 15px 35px rgba(0,0,0,0.12);\n  }\n\n  .category-item:hover .circle-wrapper img {\n    transform: scale(1.15);\n  }\n\n  .category-item:hover .circle-wrapper::after {\n    transform: rotate(25deg) translateX(100%);\n  }\n\n  /* ---- Text ---- */\n  .category-item p {\n    margin-top: 16px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1a1a1a;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    text-align: center;\n    transition: color 0.3s ease;\n  }\n\n  .category-item:hover p {\n    color: #D4AF37;\n  }\n\n  .category-link {\n    display: block;\n    text-decoration: none;\n  }\n\n  /* ---- Desktop Grid ---- */\n  .category-desktop {\n    display: grid;\n    grid-template-columns: repeat(6, 1fr);\n    gap: 40px 32px;\n    justify-items: center;\n  }\n\n  .category-item { width: 160px; }\n</style>\n\n<div class=\"category-section-premium\">\n\n  <!-- ✅ Heading -->\n  <h2 class=\"category-heading\">Shop by Department</h2>\n\n  <!-- ✅ Desktop Grid -->\n  <div class=\"category-desktop\">\n\n    <a href=\"https://www.timberkala.com/collections/animal-figurines\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/12_f35cd368-3b95-4760-9f6d-91d198d819ee.webp?v=1759731666\" alt=\"Exclusive Pieces\">\n        </div>\n        <p>Exclusive Pieces</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/glass-on-wood\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/valley.webp?v=1765361423\" alt=\"Glass on Wood\">\n        </div>\n        <p>Glass on Wood</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/bird-figurines\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/5_843cd5ee-3049-4eca-8057-5f2d9775b3d0.webp?v=1762598809\" alt=\"Bird Figurines\">\n        </div>\n        <p>Bird Figurines</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/animal-figurines-online\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/113_684eafd1-3b99-4293-8b46-e2b7b8873985.webp?v=1766128443\" alt=\"Animal Figurines\">\n        </div>\n        <p>Animal Figurines</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/furniture\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/5.webp?v=1758372894\" alt=\"Furniture\">\n        </div>\n        <p>Furniture</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/hangings-1\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/Untitled_design.jpg?v=1768389671?v=1758183068\" alt=\"Hangings\">\n        </div>\n        <p>Hangings</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/accessories\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/7.webp?v=1758372894\" alt=\"Accessories\">\n        </div>\n        <p>Accessories</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/wind-chimes\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/DSC08250_772f33fd-588d-4b52-a2e6-dc341804f359.webp?v=1768282795\" alt=\"Wind Chimes\">\n        </div>\n        <p>Wind Chimes</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/gifting\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/jars.webp?v=1765361331\" alt=\"Gifting\">\n        </div>\n        <p>Gifting</p>\n      </div>\n    </a>\n\n    <a href=\"https://www.timberkala.com/collections/clearance-sale-online-2025\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/10.webp?v=1758372894\" alt=\"Unbeatable Prices\">\n        </div>\n        <p>Unbeatable Prices</p>\n      </div>\n    </a>\n\n    <!-- ✅ Best Seller -->\n    <a href=\"https://www.timberkala.com/collections/best-seller\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/Gemini_Generated_Image_3dvy8d3dvy8d3dvy.png?v=1765454169\" alt=\"Best Seller\">\n        </div>\n        <p>Best Seller</p>\n      </div>\n    </a>\n\n    <!-- ✅ New Arrivals -->\n    <a href=\"https://www.timberkala.com/collections/new-arrivals-1\" class=\"category-link\">\n      <div class=\"category-item\">\n        <div class=\"circle-wrapper\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/TIMBERKALA_SMEDIUMSANTADUCKFORDECOR_a5de7ff1-0106-4f4e-a707-6b064cded454.webp?v=1766128240\" alt=\"New Arrivals\">\n        </div>\n        <p>New Arrivals</p>\n      </div>\n    </a>\n\n  </div>\n</div>"
