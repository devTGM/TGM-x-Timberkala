    "custom_liquid_4RMeGp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.ig-minimal{\n  width:100%;\n  padding:20px 15px;\n  display:flex;\n  justify-content:center;\n}\n\n.ig-minimal-card{\n  width:100%;\n  max-width:700px;\n  display:flex;\n  align-items:center;\n  gap:14px;\n  padding:14px 18px;\n  text-decoration:none;\n  background:#fff;\n  border:1px solid #e8e8e8;\n  border-radius:12px;\n  transition:all .3s ease;\n}\n\n.ig-minimal-card:hover{\n  transform:translateY(-2px);\n  box-shadow:0 10px 25px rgba(0,0,0,.08);\n}\n\n.ig-icon{\n  width:48px;\n  height:48px;\n  min-width:48px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n.ig-icon svg{\n  width:34px;\n  height:34px;\n}\n\n.ig-content{\n  display:flex;\n  flex-direction:column;\n  gap:2px;\n}\n\n.ig-title{\n  font-family:'Abril Fatface', serif;\n  font-size:20px;\n  color:#000;\n  line-height:1.1;\n}\n\n.ig-handle{\n  font-size:13px;\n  color:#666;\n  letter-spacing:.4px;\n}\n\n.ig-arrow{\n  margin-left:auto;\n  font-size:22px;\n  color:#000;\n  transition:transform .3s ease;\n}\n\n.ig-minimal-card:hover .ig-arrow{\n  transform:translateX(4px);\n}\n\n@media(max-width:749px){\n\n  .ig-minimal{\n    padding:16px 12px;\n  }\n\n  .ig-minimal-card{\n    padding:12px 14px;\n  }\n\n  .ig-title{\n    font-size:18px;\n  }\n\n  .ig-handle{\n    font-size:12px;\n  }\n\n  .ig-arrow{\n    font-size:20px;\n  }\n}\n</style>\n\n<div class=\"ig-minimal\">\n  <a\n    href=\"https://www.instagram.com/timber.kala/\"\n    target=\"_blank\"\n    class=\"ig-minimal-card\"\n    aria-label=\"Follow Timberkala on Instagram\"\n  >\n\n    <div class=\"ig-icon\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"instagramGradient\" x1=\"0%\" y1=\"100%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stop-color=\"#F58529\"/>\n            <stop offset=\"50%\" stop-color=\"#DD2A7B\"/>\n            <stop offset=\"100%\" stop-color=\"#515BD4\"/>\n          </linearGradient>\n        </defs>\n\n        <rect\n          x=\"2\"\n          y=\"2\"\n          width=\"20\"\n          height=\"20\"\n          rx=\"6\"\n          stroke=\"url(#instagramGradient)\"\n          stroke-width=\"2\"\n        />\n\n        <circle\n          cx=\"12\"\n          cy=\"12\"\n          r=\"4\"\n          stroke=\"url(#instagramGradient)\"\n          stroke-width=\"2\"\n        />\n\n        <circle\n          cx=\"17.5\"\n          cy=\"6.5\"\n          r=\"1.2\"\n          fill=\"url(#instagramGradient)\"\n        />\n      </svg>\n    </div>\n\n    <div class=\"ig-content\">\n      <div class=\"ig-title\">Follow us on Instagram</div>\n      <div class=\"ig-handle\">@timber.kala</div>\n    </div>\n\n    <div class=\"ig-arrow\">→</div>\n\n  </a>\n</div>"
      }
