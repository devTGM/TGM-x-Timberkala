    "custom_thank_you": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .tk-thankyou-wrap {\n    max-width: 680px;\n    margin: 0 auto 60px;\n    padding: 36px 28px;\n    background: radial-gradient(ellipse at 10% 15%, #fff9ec 0%, transparent 60%), linear-gradient(110deg, #f8efdc, #efdfc2);\n    border: 1px solid #967447;\n    border-radius: 8px;\n    box-shadow: 0 4px 18px rgba(57, 39, 28, 0.12);\n    text-align: center;\n    font-family: inherit;\n    color: #39271c;\n    position: relative;\n  }\n  .tk-thankyou-wrap::before {\n    content: '';\n    position: absolute;\n    inset: 6px;\n    border: 1.5px dashed #ab89567a;\n    border-radius: 5px;\n    pointer-events: none;\n  }\n  .tk-thankyou-icon {\n    width: 64px;\n    height: 64px;\n    margin: 0 auto 18px;\n    background: #42291c;\n    color: #e2ba7d;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 4px 12px rgba(66, 41, 28, 0.25);\n  }\n  .tk-thankyou-title {\n    font-family: Georgia, serif;\n    font-size: clamp(28px, 4vw, 38px);\n    color: #42291c;\n    margin: 0 0 10px;\n    font-weight: 700;\n  }\n  .tk-thankyou-subtitle {\n    font-size: 15px;\n    line-height: 1.6;\n    color: #634731;\n    max-width: 500px;\n    margin: 0 auto 24px;\n  }\n  .tk-thankyou-box {\n    background: rgba(255, 255, 255, 0.65);\n    border: 1px solid #dec598;\n    border-radius: 6px;\n    padding: 16px 20px;\n    margin-bottom: 28px;\n    font-size: 14px;\n    line-height: 1.6;\n    color: #4a3424;\n  }\n  .tk-thankyou-actions {\n    display: flex;\n    gap: 14px;\n    justify-content: center;\n    flex-wrap: wrap;\n  }\n  .tk-thankyou-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 12px 24px;\n    border-radius: 4px;\n    font-weight: 600;\n    font-size: 14px;\n    text-decoration: none;\n    transition: transform 0.2s, background 0.2s;\n  }\n  .tk-thankyou-btn--primary {\n    background: #42291c;\n    color: #fff2d8;\n    border: 1px solid #42291c;\n  }\n  .tk-thankyou-btn--primary:hover {\n    background: #573726;\n    transform: translateY(-2px);\n  }\n  .tk-thankyou-btn--secondary {\n    background: #f2e1bf;\n    color: #42291c;\n    border: 1px solid #d4b784;\n  }\n  .tk-thankyou-btn--secondary:hover {\n    background: #fff1d7;\n    transform: translateY(-2px);\n  }\n</style>\n\n<div class=\"tk-thankyou-wrap\">\n  <div class=\"tk-thankyou-icon\">\n    <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n  </div>\n  <h2 class=\"tk-thankyou-title\">Thank You For Your Order!</h2>\n  <p class=\"tk-thankyou-subtitle\">\n    We've received your order and our master artisans are already preparing your handcrafted wooden decor with 100% insured packaging.\n  </p>\n  <div class=\"tk-thankyou-box\">\n    <strong>Order Confirmation:</strong> An order confirmation email with your details has been sent to your email address. You will receive real-time tracking details as soon as your parcel ships.\n  </div>\n  <div class=\"tk-thankyou-actions\">\n    <a href=\"/collections/all-products\" class=\"tk-thankyou-btn tk-thankyou-btn--primary\">Continue Shopping</a>\n    <a href=\"https://wa.me/918800115082?text=Hi%20Timberkala%20team,%20I%20have%20a%20question%20about%20my%20order\" target=\"_blank\" class=\"tk-thankyou-btn tk-thankyou-btn--secondary\">Need Help? Chat on WhatsApp</a>\n  </div>\n</div>\n\n<!-- Global site tag (gtag.js) & Event snippet for TGM_Purchase_271126 conversion page -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=AW-17075141369\"></script>\n<script>\n  (function() {\n    var params = new URLSearchParams(window.location.search);\n    var checkoutId = params.get('checkoutId') || '';\n    if (!checkoutId) return;\n    var storageKey = 'tk_gads_conv_' + checkoutId;\n    try {\n      if (localStorage.getItem(storageKey)) return;\n      localStorage.setItem(storageKey, '1');\n    } catch (e) {}\n\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    window.gtag = window.gtag || gtag;\n    gtag('js', new Date());\n    gtag('config', 'AW-17075141369');\n    gtag('event', 'conversion', {\n      'send_to': 'AW-17075141369/1V-aCKvauMAdEPn1h84_',\n      'value': 1.0,\n      'currency': 'INR',\n      'transaction_id': checkoutId\n    });\n  })();\n</script>"
      }
