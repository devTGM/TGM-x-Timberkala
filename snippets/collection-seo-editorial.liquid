</style>

<script>
(function() {
  var sectionId = {{ collection.id | default: 'main' | json }};
  var btn = document.getElementById('tk-col-toggle-btn-' + sectionId);
  var expanded = document.getElementById('tk-col-expanded-' + sectionId);
  if (!btn || !expanded) return;

  btn.addEventListener('click', function() {
    var isOpen = expanded.classList.contains('is-open');
    if (isOpen) {
      expanded.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.querySelector('.tk-col-toggle-more').hidden = false;
      btn.querySelector('.tk-col-toggle-less').hidden = true;
    } else {
      expanded.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.querySelector('.tk-col-toggle-more').hidden = true;
      btn.querySelector('.tk-col-toggle-less').hidden = false;
    }
  });
})();
</script>
