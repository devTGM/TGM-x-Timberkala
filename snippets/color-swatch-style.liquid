{%- comment -%}
  Extract a style from the color swatch config. You must passed two parameters to this snippet:

  - color_swatch_config: extracted from the theme settings
  - value: the actual color
{%- endcomment -%}
{% assign swatch_focal_point = null %}
{% if value.swatch.image %}
  {% assign image_url = value.swatch.image | image_url: width: 50 %}
  {% assign swatch_focal_point = value.swatch.image.presentation.focal_point %}
  {% assign color_swatch_style = 'background-image: url(' | append: image_url | append: '); background-position: ' | append: swatch_focal_point %}
{% elsif value.swatch.color %}
  {% assign color_swatch_style = 'background-color: rgb(' | append: value.swatch.color.rgb | append: ')' %}
{% else %}

  {% comment %} it used for filters {% endcomment %}
  {% unless value.size > 0 %}
    {% assign value = value.value %}
  {% endunless %}


  {%- assign color_value_downcase = value | downcase -%}

  {%- if color_value_downcase contains 'blue' -%}
    {%- assign base_color = '#2563eb' -%}
  {%- elsif color_value_downcase contains 'turquiose' or color_value_downcase contains 'turquoise' -%}
    {%- assign base_color = '#14b8a6' -%}
  {%- elsif color_value_downcase contains 'whitewash' or color_value_downcase contains 'white wash' -%}
    {%- assign base_color = '#f8f6f0' -%}
  {%- elsif color_value_downcase contains 'white' -%}
    {%- assign base_color = '#ffffff' -%}
  {%- elsif color_value_downcase contains 'brown' or color_value_downcase contains 'wood' or color_value_downcase contains 'walnut' -%}
    {%- assign base_color = '#78350f' -%}
  {%- elsif color_value_downcase contains 'natural' or color_value_downcase contains 'teak' -%}
    {%- assign base_color = '#b48a60' -%}
  {%- elsif color_value_downcase contains 'pink' -%}
    {%- assign base_color = '#ec4899' -%}
  {%- elsif color_value_downcase contains 'green' -%}
    {%- assign base_color = '#15803d' -%}
  {%- elsif color_value_downcase contains 'grey' or color_value_downcase contains 'gray' -%}
    {%- assign base_color = '#64748b' -%}
  {%- elsif color_value_downcase contains 'black' -%}
    {%- assign base_color = '#1e293b' -%}
  {%- elsif color_value_downcase contains 'yellow' or color_value_downcase contains 'mustard' -%}
    {%- assign base_color = '#eab308' -%}
  {%- elsif color_value_downcase contains 'gold' -%}
    {%- assign base_color = '#d4af37' -%}
  {%- elsif color_value_downcase contains 'silver' -%}
    {%- assign base_color = '#94a3b8' -%}
  {%- else -%}
    {%- assign base_color = color_value_downcase -%}
  {%- endif -%}

  {% if only_color %}
    {%- assign color_swatch_style = base_color -%}
  {% else %}
    {%- assign color_swatch_style = 'background-color: ' | append: base_color -%}
  {% endif %}

  {%- for color_swatch_item in swatches_config -%}
    {%- assign color_swatch_parts = color_swatch_item | split: ':' -%}
    {%- assign color_swatch_name = color_swatch_parts.first | downcase | strip -%}
    {%- if color_value_downcase == color_swatch_name -%}
      {%- assign color_swatch_value = color_swatch_parts.last | strip -%}

      {%- if color_swatch_value contains '#' and only_color -%}
        {%- assign color_swatch_style = color_swatch_value -%}
      {%- elsif color_swatch_value contains '#' -%}
        {% assign color_swatch_size = color_swatch_value | size %}
        {% if color_swatch_size == 7 %}
          {%- assign color_swatch_style = 'background-color: ' | append: color_swatch_value -%}
        {% elsif color_swatch_size == 14 %}
          {% assign first_color = color_swatch_value | slice: 0, 7 %}
          {% assign second_color = color_swatch_value | slice: 7, 7 %}
          {%- assign color_swatch_style = 'background: linear-gradient(45deg, '
            | append: first_color
            | append: ' 50%, '
            | append: second_color
            | append: ' 50%);'
          -%}
        {% elsif color_swatch_size == 21 %}
          {% assign first_color = color_swatch_value | slice: 0, 7 %}
          {% assign second_color = color_swatch_value | slice: 7, 7 %}
          {% assign third_color = color_swatch_value | slice: 14, 7 %}
          {%- assign color_swatch_style = 'background: linear-gradient(45deg, '
            | append: first_color
            | append: ' 0% 35%, '
            | append: second_color
            | append: ' 35% 65%, '
            | append: third_color
            | append: ' 65% 100%);'
          -%}
        {% endif %}
      {%- elsif images[color_swatch_value] != blank -%}
        {%- assign color_swatch_image = images[color_swatch_value] | image_url: width: 72, height: 72 -%}
        {%- assign color_swatch_style = 'background-image: url('
          | append: color_swatch_image
          | append: '); background-size: contain;'
        -%}
      {%- endif -%}

      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{% endif %}


{{- color_swatch_style -}}
