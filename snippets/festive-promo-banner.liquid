{% comment %}
  Timberkala Festive Diwali Promo Banner
  Inspired by royal festive aesthetics: Hanging marigolds, temple bells, glowing fairy lights,
  ornate crimson & gold cartouche badge, and interactive coupon code.
{% endcomment %}

<style>
  .tk-festive-banner {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    padding: 12px 12px 10px;
    background: #fbf5eb radial-gradient(ellipse 95% 125% at 50% 50%, #fdf8f0 0%, #faebd8 55%, #f1dcbe 100%);
    border: 1.5px solid #dfb97a;
    box-shadow: 
      0 4px 18px rgba(168, 107, 26, 0.14),
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      inset 0 -1px 1px rgba(197, 142, 60, 0.2);
    color: #4a1315;
    text-align: center;
    margin-bottom: 14px;
    width: 100%;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Shimmer Light Sweep */
  .tk-festive-banner::after {
    content: '';
    position: absolute;
    inset: -50%;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 245, 210, 0.3) 48%,
      rgba(255, 255, 255, 0.6) 50%,
      rgba(255, 245, 210, 0.3) 52%,
      transparent 65%
    );
    transform: translateX(-100%);
    animation: tkFestiveShine 7s infinite cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 4;
  }

  @keyframes tkFestiveShine {
    0%, 20% { transform: translateX(-100%) rotate(15deg); }
    55%, 100% { transform: translateX(100%) rotate(15deg); }
  }

  /* Left & Right Decorative Hangings */
  .tk-festive-flank {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 70px;
    pointer-events: none;
    z-index: 2;
  }

  .tk-festive-flank--left {
    left: 0;
  }

  .tk-festive-flank--right {
    right: 0;
    transform: scaleX(-1);
  }

  .tk-festive-flank svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Main Inner Content */
  .tk-festive-content {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 2px 48px;
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     ROYAL FESTIVE CARTOUCHE BADGE
     ------------------------------------------------------------- */
  .tk-festive-badge {
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px 14px 10px;
    min-width: 125px;
    background: radial-gradient(ellipse at 50% 30%, #991319 0%, #76090e 65%, #520407 100%);
    border: 1.5px solid #ffd875;
    border-radius: 9px;
    box-shadow: 
      0 4px 12px rgba(92, 4, 7, 0.35),
      inset 0 1px 2px rgba(255, 235, 160, 0.5),
      inset 0 -2px 4px rgba(0, 0, 0, 0.4);
  }

  /* Ornate Side Notches */
  .tk-festive-badge::before,
  .tk-festive-badge::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    background: #76090e;
    border: 1.5px solid #ffd875;
    transform: translateY(-50%) rotate(45deg);
  }
  .tk-festive-badge::before { left: -4.5px; border-right: none; border-top: none; }
  .tk-festive-badge::after { right: -4.5px; border-left: none; border-bottom: none; }

  .tk-badge-top {
    font-family: Georgia, 'Times New Roman', 'Playfair Display', serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.1;
    background: linear-gradient(180deg, #fff9d6 0%, #fed867 45%, #d8961d 80%, #945f06 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.6));
  }

  .tk-badge-main {
    font-family: Georgia, 'Times New Roman', 'Playfair Display', serif;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    line-height: 1.15;
    margin-top: 1px;
    background: linear-gradient(180deg, #ffffff 0%, #ffefa6 30%, #f7c94b 70%, #b8790b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
  }

  /* Live Now Capsule */
  .tk-badge-pill {
    position: absolute;
    bottom: -7px;
    background: linear-gradient(180deg, #fff0a8 0%, #f6bf38 45%, #d48b0a 100%);
    border: 1px solid #ffe994;
    border-radius: 12px;
    padding: 1px 9px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #65070a;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.28);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .tk-badge-pill-dot {
    width: 5px;
    height: 5px;
    background: #c90e15;
    border-radius: 50%;
    box-shadow: 0 0 4px #ff3b30;
    animation: tkLivePulse 1.8s infinite;
  }

  @keyframes tkLivePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.75); }
  }

  /* -------------------------------------------------------------
     OFFER SECTION & COUPON
     ------------------------------------------------------------- */
  .tk-festive-offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .tk-offer-headline {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 23px;
    font-weight: 800;
    line-height: 1.1;
    color: #7d0f15;
    letter-spacing: -0.3px;
  }

  .tk-offer-headline .tk-offer-light {
    font-weight: 600;
    font-size: 19px;
    color: #6c1216;
  }

  .tk-offer-headline .tk-offer-bold {
    font-weight: 800;
    font-size: 25px;
    color: #820b12;
    background: linear-gradient(180deg, #8b0f15 0%, #5d070b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Coupon Code Box with One-Click Copy */
  .tk-festive-coupon-box {
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fffdf9;
    border: 1px solid #d4a75e;
    border-radius: 6px;
    padding: 3px 8px;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(125, 15, 21, 0.08);
    transition: all 0.2s ease;
    position: relative;
    user-select: none;
  }

  .tk-festive-coupon-box:hover {
    background: #ffffff;
    border-color: #b8860b;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(184, 134, 11, 0.2);
  }

  .tk-coupon-label {
    font-size: 10px;
    font-weight: 600;
    color: #6d4e2d;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .tk-coupon-code {
    font-family: monospace, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 12px;
    font-weight: 800;
    color: #820b12;
    letter-spacing: 0.8px;
    background: #faebd7;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px dashed #c48b28;
  }

  .tk-copy-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #820b12;
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .tk-festive-coupon-box:hover .tk-copy-icon {
    transform: scale(1.12);
  }

  .tk-copy-icon svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    display: block;
  }

  .tk-copied-toast {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #7d0f15;
    color: #fff9e6;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.22);
    opacity: 0;
    pointer-events: none;
    transition: all 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    white-space: nowrap;
    z-index: 10;
  }

  .tk-copied-toast.is-shown {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* -------------------------------------------------------------
     HALLMARK TRUST FOOTER
     ------------------------------------------------------------- */
  .tk-festive-hallmark {
    margin-top: 9px;
    padding-top: 6px;
    border-top: 1px dashed rgba(197, 142, 60, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 600;
    color: #63472b;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    position: relative;
    z-index: 3;
    flex-wrap: wrap;
  }

  .tk-hallmark-dot {
    color: #c48b28;
    font-size: 11px;
    opacity: 0.8;
  }

  /* -------------------------------------------------------------
     RESPONSIVE STYLES
     ------------------------------------------------------------- */
  @media (max-width: 768px) {
    .tk-festive-banner {
      padding: 10px 10px 8px;
      margin-bottom: 11px;
    }

    .tk-festive-flank {
      width: 54px;
    }

    .tk-festive-content {
      padding: 0 34px;
      gap: 12px;
    }

    .tk-festive-badge {
      min-width: 110px;
      padding: 5px 10px 9px;
    }

    .tk-badge-top {
      font-size: 9.5px;
      letter-spacing: 1.6px;
    }

    .tk-badge-main {
      font-size: 12.5px;
      letter-spacing: 1px;
    }

    .tk-badge-pill {
      font-size: 7.5px;
      padding: 1px 7px;
      bottom: -6px;
    }

    .tk-offer-headline {
      font-size: 19px;
    }
    .tk-offer-headline .tk-offer-light {
      font-size: 16px;
    }
    .tk-offer-headline .tk-offer-bold {
      font-size: 21px;
    }

    .tk-festive-coupon-box {
      padding: 2px 7px;
      gap: 5px;
    }

    .tk-coupon-label {
      font-size: 9.5px;
    }

    .tk-coupon-code {
      font-size: 11px;
    }

    .tk-festive-hallmark {
      font-size: 8.5px;
      gap: 4px;
      letter-spacing: 0.4px;
      margin-top: 7px;
      padding-top: 5px;
    }
  }

  @media (max-width: 420px) {
    .tk-festive-content {
      padding: 0 24px;
      gap: 9px;
    }

    .tk-festive-flank {
      width: 40px;
    }

    .tk-festive-badge {
      min-width: 96px;
      padding: 4px 6px 8px;
    }

    .tk-badge-top {
      font-size: 8.5px;
      letter-spacing: 1.2px;
    }

    .tk-badge-main {
      font-size: 11px;
      letter-spacing: 0.8px;
    }

    .tk-offer-headline {
      font-size: 17px;
    }
    .tk-offer-headline .tk-offer-light {
      font-size: 14px;
    }
    .tk-offer-headline .tk-offer-bold {
      font-size: 18px;
    }

    .tk-festive-coupon-box {
      padding: 2px 5px;
      gap: 4px;
    }

    .tk-coupon-label {
      font-size: 9px;
    }

    .tk-coupon-code {
      font-size: 10px;
      padding: 1px 4px;
    }

    .tk-festive-hallmark {
      font-size: 8px;
      gap: 3px;
    }
  }

  @media (max-width: 350px) {
    .tk-festive-content {
      flex-direction: column;
      gap: 12px;
      padding: 0 20px;
    }

    .tk-festive-offer {
      align-items: center;
      text-align: center;
    }

    .tk-festive-flank {
      width: 32px;
    }
  }
</style>

<div class="tk-festive-banner" role="banner" aria-label="Festive Diwali Offer: Get 20% Off Use Code DIWALI20">

