<script>
  (function() {
    function initFestiveBanner() {
      var couponBox = document.getElementById('tkFestiveCouponBox');
      var toast = document.getElementById('tkCopiedToastAlert');
      var code = 'DIWALI20';

      if (!couponBox || couponBox.dataset.initialized) return;
      couponBox.dataset.initialized = 'true';

      function showToast() {
        if (!toast) return;
        toast.classList.add('is-shown');
        setTimeout(function() {
          toast.classList.remove('is-shown');
        }, 1500);
      }

      function copyCoupon(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(showToast).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }
      }

      function fallbackCopy() {
        var ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        ta.style.top = '-9999px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try {
          document.execCommand('copy');
          showToast();
        } catch (err) {}
        document.body.removeChild(ta);
      }

      couponBox.addEventListener('click', copyCoupon);
      couponBox.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          copyCoupon(e);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFestiveBanner);
    } else {
      initFestiveBanner();
    }
  })();
</script>
