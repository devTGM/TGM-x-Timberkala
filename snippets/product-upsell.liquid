    width: 14px !important;
    height: 14px !important;
    animation: tk-spin 0.7s linear infinite !important;
  }

  @keyframes tk-spin {
    100% { transform: rotate(360deg); }
  }

  /* Shimmer Skeleton */
  .tk-upsell-skeleton {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    background: #ffffff !important;
    border: 1px solid rgba(0, 0, 0, 0.06) !important;
    border-radius: 10px !important;
    padding: 10px 12px !important;
    box-sizing: border-box !important;
  }

  .tk-upsell-skeleton__img {
    width: 66px !important;
    height: 66px !important;
    border-radius: 8px !important;
    background: linear-gradient(90deg, #f0ede6 25%, #f8f6f0 50%, #f0ede6 75%) !important;
    background-size: 200% 100% !important;
    animation: tkShimmer 1.5s infinite !important;
    flex-shrink: 0 !important;
  }

  .tk-upsell-skeleton__body {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .tk-upsell-skeleton__line {
    border-radius: 4px !important;
    background: linear-gradient(90deg, #f0ede6 25%, #f8f6f0 50%, #f0ede6 75%) !important;
    background-size: 200% 100% !important;
    animation: tkShimmer 1.5s infinite !important;
  }

  .tk-upsell-skeleton__line--vendor {
    width: 35% !important;
    height: 8px !important;
  }

  .tk-upsell-skeleton__line--title {
    width: 85% !important;
    height: 12px !important;
  }

  .tk-upsell-skeleton__line--price {
    width: 40% !important;
    height: 10px !important;
  }

  .tk-upsell-skeleton__btn {
    width: 68px !important;
    height: 34px !important;
    border-radius: 999px !important;
    background: linear-gradient(90deg, #f0ede6 25%, #f8f6f0 50%, #f0ede6 75%) !important;
    background-size: 200% 100% !important;
    animation: tkShimmer 1.5s infinite !important;
    flex-shrink: 0 !important;
  }

  @keyframes tkShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Mobile Tweaks */
  @media (max-width: 600px) {
    .tk-pdp-upsell {
      margin: 14px 0 16px !important;
    }

    .tk-pdp-upsell__card {
      padding: 14px 12px 12px !important;
      border-radius: 12px !important;
    }

    .tk-upsell-item,
    .tk-upsell-skeleton {
      padding: 9px 10px !important;
      gap: 10px !important;
    }

    .tk-upsell-item__image-link,
    .tk-upsell-skeleton__img {
      width: 58px !important;
      height: 58px !important;
    }

    .tk-upsell-item__title {
      font-size: 11.5px !important;
    }

    .tk-upsell-item__price {
      font-size: 12px !important;
    }

    .tk-upsell-item__add-btn,
    .tk-upsell-skeleton__btn {
      padding: 6px 12px !important;
      font-size: 11px !important;
      min-width: 64px !important;
      min-height: 32px !important;
    }
  }
</style>

<script>
  (function() {
    var blockId = {{ block.id | json }};
    var container = document.getElementById('tk-pdp-upsell-' + blockId);
    var listEl = document.getElementById('tk-pdp-upsell-list-' + blockId);
    if (!container || !listEl) return;

    var currentProdId = {{ product.id | json }};
    var maxItems = parseInt(container.getAttribute('data-max-items') || '2', 10);
    var hasServerItems = {{ rendered_count }} > 0;

    // If server rendered real items (via per-product metafields or manual block settings), attach event listeners
    if (hasServerItems) {
      attachUpsellEvents(container);
      return;
    }

    // Dynamic product-specific recommendations
    var recBaseUrl = {{ routes.product_recommendations_url | json }} || '/recommendations/products';
    var primaryColHandle = {{ product.collections.first.handle | json }};

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function loadRecommendations(intent) {
      var url = recBaseUrl + '.json?product_id=' + currentProdId + '&limit=8&intent=' + intent;
      return fetch(url)
        .then(function(res) {
          if (!res.ok) throw new Error('Network error');
          return res.json();
        })
        .then(function(data) {
          var products = data.products || [];
          return products.filter(function(p) {
            return p.id !== currentProdId && p.available;
          });
        });
    }

    function renderUpsellItems(products) {
      if (!products || products.length === 0) {
        container.style.display = 'none';
        return;
      }

      listEl.innerHTML = '';

      products.forEach(function(p) {
        var availableVariant = p.variants && p.variants.find(function(v) { return v.available; });
        if (!availableVariant) return;

        var imgUrl = '';
        if (p.featured_image) {
          imgUrl = p.featured_image;
          if (imgUrl.indexOf('?') > -1) {
            imgUrl += '&width=160';
          } else {
            imgUrl += '?width=160';
          }
          if (imgUrl.indexOf('//') === 0) {
            imgUrl = 'https:' + imgUrl;
          }
        }

        var priceNum = p.price / 100;
        var priceStr = '₹' + priceNum.toLocaleString('en-IN');
        var compareStr = '';
        var discountBadge = '';

        if (p.compare_at_price && p.compare_at_price > p.price) {
          var compNum = p.compare_at_price / 100;
          compareStr = '₹' + compNum.toLocaleString('en-IN');
          var pct = Math.round(((p.compare_at_price - p.price) / p.compare_at_price) * 100);
          if (pct > 0) {
            discountBadge = '<span class="tk-upsell-item__discount-badge">-' + pct + '%</span>';
          }
        }

        var itemDiv = document.createElement('div');
        itemDiv.className = 'tk-upsell-item';
        itemDiv.setAttribute('data-product-id', p.id);
        itemDiv.setAttribute('data-variant-id', availableVariant.id);

        var optionsHtml = '';
        var multiVariants = p.variants && p.variants.length > 1;
        if (multiVariants) {
          optionsHtml += '<select class="tk-upsell-item__variant-select" aria-label="Select variant for ' + escapeHtml(p.title) + '">';
          p.variants.forEach(function(v) {
            if (v.available) {
              var vPrice = '₹' + (v.price / 100).toLocaleString('en-IN');
              optionsHtml += '<option value="' + v.id + '" data-price="' + vPrice + '">' + escapeHtml(v.title) + '</option>';
            }
          });
          optionsHtml += '</select>';
        }

        var imgHtml = imgUrl
          ? '<img src="' + imgUrl + '" alt="' + escapeHtml(p.title) + '" class="tk-upsell-item__image" width="66" height="66" loading="lazy">'
          : '<div class="tk-upsell-item__image" style="background:#e8dfd1;"></div>';

        itemDiv.innerHTML =
          '<a href="' + p.url + '" class="tk-upsell-item__image-link" aria-label="' + escapeHtml(p.title) + '">' +
            imgHtml +
          '</a>' +
          '<div class="tk-upsell-item__details">' +
            '<span class="tk-upsell-item__vendor">' + escapeHtml(p.vendor || 'TIMBER KALA') + '</span>' +
            '<a href="' + p.url + '" class="tk-upsell-item__title" title="' + escapeHtml(p.title) + '">' + escapeHtml(p.title) + '</a>' +
            '<div class="tk-upsell-item__price-row">' +
              '<span class="tk-upsell-item__price">' + priceStr + '</span>' +
              (compareStr ? '<s class="tk-upsell-item__compare-price">' + compareStr + '</s>' : '') +
              discountBadge +
            '</div>' +
            optionsHtml +
          '</div>' +
          '<div class="tk-upsell-item__action">' +
            '<button type="button" class="tk-upsell-item__add-btn" data-variant-id="' + availableVariant.id + '" aria-label="Add ' + escapeHtml(p.title) + ' to cart">' +
              '<span class="tk-upsell-btn-text">+ Add</span>' +
              '<span class="tk-upsell-btn-loading" hidden><svg class="tk-spinner" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="31.4 31.4"/></svg></span>' +
              '<span class="tk-upsell-btn-added" hidden>✓ Added</span>' +
            '</button>' +
          '</div>';

        listEl.appendChild(itemDiv);
      });

      container.style.display = '';
      attachUpsellEvents(container);
    }

    // Primary: fetch intent=related (Shopify intelligent correlation)
    loadRecommendations('related')
      .then(function(items) {
        if (items && items.length > 0) {
          renderUpsellItems(items.slice(0, maxItems));
        } else {
          // Secondary fallback: intent=complementary
          return loadRecommendations('complementary').then(function(compItems) {
            if (compItems && compItems.length > 0) {
              renderUpsellItems(compItems.slice(0, maxItems));
            } else if (primaryColHandle) {
              // Tertiary fallback: fetch same collection products, dynamically rotated per product ID
              return fetch('/collections/' + primaryColHandle + '/products.json?limit=15')
                .then(function(res) { return res.json(); })
                .then(function(colData) {
                  var colProds = (colData.products || []).filter(function(p) {
                    return p.id !== currentProdId && p.available;
                  });
                  if (colProds.length > 0) {
                    var offset = currentProdId % colProds.length;
                    var rotated = colProds.slice(offset).concat(colProds.slice(0, offset));
                    renderUpsellItems(rotated.slice(0, maxItems));
                  } else {
                    container.style.display = 'none';
                  }
                });
            } else {
              container.style.display = 'none';
            }
          });
        }
      })
      .catch(function(err) {
        console.warn('Upsell recommendation error:', err);
        container.style.display = 'none';
      });

    function attachUpsellEvents(root) {
      // Variant select changes
      root.querySelectorAll('.tk-upsell-item__variant-select').forEach(function(select) {
        select.addEventListener('change', function() {
          var item = select.closest('.tk-upsell-item');
          var btn = item.querySelector('.tk-upsell-item__add-btn');
          var priceEl = item.querySelector('.tk-upsell-item__price');
          var selectedOpt = select.options[select.selectedIndex];
          var newVid = select.value;
          var newPrice = selectedOpt.getAttribute('data-price');
          if (btn) btn.setAttribute('data-variant-id', newVid);
          if (priceEl && newPrice) priceEl.textContent = newPrice;
        });
      });

      // Add to Cart click
      root.querySelectorAll('.tk-upsell-item__add-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var vid = btn.getAttribute('data-variant-id');
          if (!vid) return;

          var textSpan = btn.querySelector('.tk-upsell-btn-text');
          var loadingSpan = btn.querySelector('.tk-upsell-btn-loading');
          var addedSpan = btn.querySelector('.tk-upsell-btn-added');

          btn.classList.add('tk-loading');
          if (textSpan) textSpan.hidden = true;
          if (loadingSpan) loadingSpan.hidden = false;

          var cartDrawer = document.querySelector('cart-drawer');
          var sectionsToRender = cartDrawer && typeof cartDrawer.getSectionsToRender === 'function'
            ? cartDrawer.getSectionsToRender()
            : [];

          var formData = new FormData();
          formData.append('id', vid);
          formData.append('quantity', 1);
          if (sectionsToRender.length) {
            formData.append('sections', sectionsToRender.map(function(s) { return s.id || s.section; }).join(','));
            formData.append('sections_url', window.location.pathname);
          }

          fetch(window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            btn.classList.remove('tk-loading');
            btn.classList.add('tk-added');
            if (loadingSpan) loadingSpan.hidden = true;
            if (addedSpan) addedSpan.hidden = false;

            // Render cart drawer if available
            if (data.sections && cartDrawer && typeof cartDrawer.renderContents === 'function') {
              cartDrawer.renderContents(data);
            }

            // Trigger theme cart updates
            if (window.handleFloCartBtn) {
              window.handleFloCartBtn();
            }

            if (typeof publish === 'function' && window.PUB_SUB_EVENTS) {
              publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'product-upsell', cartData: data });
            }

            document.dispatchEvent(new CustomEvent('cart:refresh'));

            setTimeout(function() {
              btn.classList.remove('tk-added');
              if (addedSpan) addedSpan.hidden = true;
              if (textSpan) textSpan.hidden = false;
            }, 3000);
          })
          .catch(function(err) {
            console.error('Upsell add error:', err);
            btn.classList.remove('tk-loading');
            if (loadingSpan) loadingSpan.hidden = true;
            if (textSpan) textSpan.hidden = false;
          });
        });
      });
    }
  })();
</script>
