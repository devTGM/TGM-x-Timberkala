<script>
(function() {
  var btn = document.getElementById('tk-home-toggle-btn');
  var expandable = document.getElementById('tk-home-expandable-content');
  if (!btn || !expandable) return;

  btn.addEventListener('click', function() {
    var isOpen = expandable.classList.contains('is-open');
    if (isOpen) {
      expandable.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.querySelector('.tk-home-btn-more').hidden = false;
      btn.querySelector('.tk-home-btn-less').hidden = true;
    } else {
      expandable.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.querySelector('.tk-home-btn-more').hidden = true;
      btn.querySelector('.tk-home-btn-less').hidden = false;
    }
  });
})();
</script>
