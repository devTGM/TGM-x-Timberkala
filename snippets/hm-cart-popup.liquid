{% comment %}
  Timberkala — H&M Style "Added to Shopping Bag" Cart Pop-up Modal
  Replaces full cart drawer on item addition with an elegant, responsive confirmation pop-up
  Includes Festive DIWALI20 Discount Calculation & Auto-Apply Guarantee
{% endcomment %}

<style>
  /* =========================================================================
     H&M STYLE "ADDED TO SHOPPING BAG" POP-UP MODAL
     ========================================================================= */

  /* Backdrop Overlay */
  .hm-cart-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    background: rgba(18, 14, 10, 0.52) !important;
    backdrop-filter: blur(4px) !important;
    -webkit-backdrop-filter: blur(4px) !important;
    z-index: 2147483646 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: opacity 0.28s ease, visibility 0.28s ease !important;
  }
  .hm-cart-overlay.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  /* Prevent body scrolling when pop-up is open */
  html.hm-cart-locked,
  body.hm-cart-locked {
    overflow: hidden !important;
  }

  /* Pop-up Card Container (Desktop Default) */
  .hm-cart-popup {
    position: fixed !important;
    top: 24px !important;
    right: 28px !important;
    bottom: auto !important;
    left: auto !important;
    width: 420px !important;
    max-width: calc(100vw - 36px) !important;
    background: #ffffff !important;
    border-radius: 14px !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 
      0 20px 50px -10px rgba(0, 0, 0, 0.22),
      0 6px 18px rgba(0, 0, 0, 0.08) !important;
    z-index: 2147483647 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(-14px) scale(0.97) !important;
    transition: opacity 0.26s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.26s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.26s !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
    color: #1a1a1a !important;
  }

  .hm-cart-popup.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) scale(1) !important;
  }

  /* Mobile Bottom Sheet Layout */
  @media (max-width: 767px) {
    .hm-cart-popup {
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      border-radius: 20px 20px 0 0 !important;
      border: none !important;
      border-top: 1px solid rgba(0, 0, 0, 0.1) !important;
      box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.24) !important;
      transform: translateY(100%) !important;
      max-height: 90vh !important;
      max-height: 90dvh !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
      padding-bottom: max(16px, env(safe-area-inset-bottom, 16px)) !important;
    }
    .hm-cart-popup.is-active {
      transform: translateY(0) !important;
    }
  }

  /* Mobile Drag Indicator */
  .hm-cart-drag-pill {
    display: none;
    width: 38px;
    height: 4px;
    background: #dcd7cf;
    border-radius: 2px;
    margin: 10px auto 2px;
  }
  @media (max-width: 767px) {
    .hm-cart-drag-pill {
      display: block;
    }
  }

  /* Header */
  .hm-cart-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 15px 18px 12px !important;
    border-bottom: 1px solid #f0ece6 !important;
    box-sizing: border-box !important;
  }
  .hm-cart-header__left {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
  }
  .hm-cart-badge {
    width: 22px !important;
    height: 22px !important;
    min-width: 22px !important;
    border-radius: 50% !important;
    background: #15803d !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #ffffff !important;
  }
  .hm-cart-header__title {
    margin: 0 !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    letter-spacing: -0.2px !important;
    color: #111111 !important;
    line-height: 1.2 !important;
  }
  .hm-cart-close {
    width: 32px !important;
    height: 32px !important;
    border-radius: 50% !important;
    background: transparent !important;
    border: none !important;
    color: #666666 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: background-color 0.2s, color 0.2s !important;
    padding: 0 !important;
  }
  .hm-cart-close:hover {
    background: #f4f1ea !important;
    color: #111111 !important;
  }

  /* Body Content */
  .hm-cart-body {
    padding: 14px 18px 16px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 11px !important;
    box-sizing: border-box !important;
  }

  /* Product Row */
  .hm-cart-product {
    display: flex !important;
    gap: 12px !important;
    align-items: flex-start !important;
  }
  .hm-cart-product__thumb {
    width: 70px !important;
    height: 84px !important;
    min-width: 70px !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    background: #f7f5f2 !important;
    border: 1px solid rgba(0, 0, 0, 0.06) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .hm-cart-product__thumb img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }
  .hm-cart-product__details {
    flex: 1 !important;
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
  }
  .hm-cart-product__brand {
    font-size: 10px !important;
    font-weight: 700 !important;
    letter-spacing: 0.8px !important;
    text-transform: uppercase !important;
    color: #8c7355 !important;
  }
  .hm-cart-product__title {
    margin: 0 !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    color: #1a1a1a !important;
