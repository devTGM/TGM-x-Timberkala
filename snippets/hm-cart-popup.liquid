  }
  .hm-cart-product__variant {
    font-size: 11.5px !important;
    color: #666666 !important;
    margin-top: 1px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
  .hm-cart-product__meta {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-top: 3px !important;
  }
  .hm-cart-product__price {
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #111111 !important;
  }
  .hm-cart-product__qty {
    font-size: 11px !important;
    color: #555555 !important;
    background: #f3efe8 !important;
    padding: 1px 6px !important;
    border-radius: 4px !important;
    font-weight: 500 !important;
  }

  /* Free Shipping Bar */
  .hm-cart-shipping {
    background: #faf8f5 !important;
    border: 1px solid #eee8df !important;
    border-radius: 8px !important;
    padding: 7px 11px !important;
    box-sizing: border-box !important;
  }
  .hm-cart-shipping__bar {
    width: 100% !important;
    height: 4px !important;
    background: #e6e0d6 !important;
    border-radius: 2px !important;
    overflow: hidden !important;
    margin-bottom: 4px !important;
  }
  .hm-cart-shipping__fill {
    height: 100% !important;
    background: linear-gradient(90deg, #b08544, #15803d) !important;
    border-radius: 2px !important;
    transition: width 0.4s ease !important;
  }
  .hm-cart-shipping__text {
    margin: 0 !important;
    font-size: 11px !important;
    line-height: 1.3 !important;
    color: #444444 !important;
    font-weight: 500 !important;
  }
  .hm-cart-shipping__text strong {
    color: #15803d !important;
  }

  /* Festive Promo / Coupon Badge in Pop-up */
  .hm-cart-promo {
    background: #fffdf9 radial-gradient(ellipse 95% 125% at 50% 50%, #fffdf8 0%, #faf3e8 100%) !important;
    border: 1.5px solid #d4a75e !important;
    border-radius: 8px !important;
    padding: 8px 11px !important;
    box-sizing: border-box !important;
  }
  .hm-cart-promo__header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin-bottom: 2px !important;
  }
  .hm-cart-promo__code {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    background: #faebd7 !important;
    border: 1px dashed #c48b28 !important;
    border-radius: 4px !important;
    padding: 1px 6px !important;
    font-family: monospace, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    color: #820b12 !important;
    letter-spacing: 0.8px !important;
  }
  .hm-cart-promo__status {
    font-size: 9.5px !important;
    font-weight: 700 !important;
    color: #15803d !important;
    background: rgba(21, 128, 61, 0.1) !important;
    padding: 2px 6px !important;
    border-radius: 4px !important;
