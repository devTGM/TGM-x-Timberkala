  }
  .hm-cart-promo__desc {
    margin: 0 !important;
    font-size: 10px !important;
    color: #6d4e2d !important;
    line-height: 1.3 !important;
  }

  /* Pricing Breakdown Table */
  .hm-cart-price-breakdown {
    display: flex !important;
    flex-direction: column !important;
    gap: 5px !important;
    padding-top: 6px !important;
    border-top: 1px dashed #e6decb !important;
  }
  .hm-cart-price-row {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 13px !important;
    color: #444444 !important;
  }
  .hm-cart-price-row--discount {
    color: #15803d !important;
    font-weight: 600 !important;
  }
  .hm-cart-price-row--final {
    font-size: 14.5px !important;
    font-weight: 800 !important;
    color: #1a1a1a !important;
    padding-top: 4px !important;
    border-top: 1px solid #eee8df !important;
  }
  .hm-cart-savings-badge {
    background: #eaf6ed !important;
    border: 1px solid #b8e2c2 !important;
    color: #14532d !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    text-align: center !important;
    padding: 4px 8px !important;
    border-radius: 6px !important;
    margin: 2px 0 !important;
  }
  .hm-cart-subtotal__tax {
    margin: 2px 0 0 !important;
    font-size: 10.5px !important;
    color: #777777 !important;
    text-align: center !important;
  }

  /* Action Buttons */
  .hm-cart-actions {
    display: flex !important;
    flex-direction: column !important;
    gap: 7px !important;
    padding-top: 2px !important;
  }
  .hm-cart-btn {
    width: 100% !important;
    height: 45px !important;
    border-radius: 8px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.8px !important;
    text-transform: uppercase !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    text-decoration: none !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
    transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }
  .hm-cart-btn--primary {
    background: #1a1510 !important;
    color: #ffffff !important;
    border: none !important;
    box-shadow: 0 4px 14px rgba(26, 21, 16, 0.18) !important;
  }
  .hm-cart-btn--primary:hover {
    background: #382c22 !important;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
  }
  .hm-cart-btn--secondary {
    background: #ffffff !important;
    color: #1a1510 !important;
    border: 1.5px solid #1a1510 !important;
  }
  .hm-cart-btn--secondary:hover {
    background: #f7f5f2 !important;
    color: #1a1510 !important;
  }
  .hm-cart-continue {
    background: transparent !important;
    border: none !important;
    font-size: 12px !important;
    color: #666666 !important;
    text-decoration: underline !important;
    text-align: center !important;
    padding: 5px 0 2px !important;
    cursor: pointer !important;
    transition: color 0.2s !important;
  }
  .hm-cart-continue:hover {
    color: #111111 !important;
  }
  .hm-cart-checkout-guarantee {
    text-align: center !important;
    font-size: 10.5px !important;
    color: #666666 !important;
    margin: 3px 0 0 !important;
  }
</style>

<div class="hm-cart-overlay" id="HMCartOverlay" aria-hidden="true"></div>

<aside
  class="hm-cart-popup"
  id="HMCartPopup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="HMCartTitle"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="hm-cart-drag-pill" aria-hidden="true"></div>

  <!-- Header -->
  <div class="hm-cart-header">
    <div class="hm-cart-header__left">
      <span class="hm-cart-badge" aria-hidden="true">
        <svg width="12" height="10" viewBox="0 0 12 10" fill="none">
          <path d="M1.2 5L4.4 8.2L10.8 1.8" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <h3 id="HMCartTitle" class="hm-cart-header__title">Added to shopping bag</h3>
    </div>
    <button type="button" class="hm-cart-close" id="HMCartCloseBtn" aria-label="Close">
      <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
        <path d="M1 1L12 12M1 12L12 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Body -->
  <div class="hm-cart-body">
    <!-- Product Row -->
    <div class="hm-cart-product">
      <div class="hm-cart-product__thumb">
        <img
          id="HMCartProductImg"
          src=""
          alt=""
          loading="lazy"
          width="70"
          height="84"
        >
      </div>
      <div class="hm-cart-product__details">
        <span class="hm-cart-product__brand">TIMBERKALA</span>
        <h4 id="HMCartProductTitle" class="hm-cart-product__title">Handcrafted Decor</h4>
        <div id="HMCartProductVariant" class="hm-cart-product__variant" style="display:none;"></div>
        <div class="hm-cart-product__meta">
          <span id="HMCartProductPrice" class="hm-cart-product__price">₹0</span>
          <span id="HMCartProductQty" class="hm-cart-product__qty">Qty: 1</span>
        </div>
      </div>
    </div>

    <!-- Free Shipping Progress Tracker -->
    <div class="hm-cart-shipping">
      <div class="hm-cart-shipping__bar">
        <div id="HMCartShippingProgress" class="hm-cart-shipping__fill" style="width: 0%;"></div>
      </div>
      <p id="HMCartShippingText" class="hm-cart-shipping__text">
        Free shipping on orders above ₹2000
      </p>
    </div>

    <!-- Festive Promo Badge -->
    <div class="hm-cart-promo">
      <div class="hm-cart-promo__header">
        <span class="hm-cart-promo__code">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          DIWALI20
        </span>
        <span class="hm-cart-promo__status">✓ 20% OFF APPLIED</span>
      </div>
      <p class="hm-cart-promo__desc">Diwali Festive Offer: 20% discount is auto-applied at checkout!</p>
    </div>

    <!-- Pricing Breakdown Table -->
    <div class="hm-cart-price-breakdown">
      <div class="hm-cart-price-row">
        <span id="HMCartSubtotalCount">Bag Total (1 item)</span>
        <span id="HMCartSubtotalAmount">₹0</span>
      </div>
      <div class="hm-cart-price-row hm-cart-price-row--discount">
        <span>Diwali Savings (DIWALI20 · 20% OFF)</span>
        <span id="HMCartDiscountAmount">-₹0</span>
      </div>
      <div class="hm-cart-price-row hm-cart-price-row--final">
        <span>Estimated Total</span>
        <span id="HMCartFinalAmount">₹0</span>
      </div>
    </div>

    <!-- Savings Pill -->
    <div class="hm-cart-savings-badge" id="HMCartSavingsBadge">
      🎉 You save <strong id="HMCartSavingsAmount">₹0</strong> on this order!
    </div>

    <p class="hm-cart-subtotal__tax">Inclusive of all taxes · Free Pan-India Delivery above ₹2000</p>

    <!-- Action Buttons -->
    <div class="hm-cart-actions">
      <button type="button" id="HMCartCheckoutBtn" class="hm-cart-btn hm-cart-btn--primary">
        <span>Proceed to Checkout</span>
