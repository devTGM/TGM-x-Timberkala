</aside>

<script>
  (function() {
    var overlay = document.getElementById('HMCartOverlay');
    var popup = document.getElementById('HMCartPopup');
    var closeBtn = document.getElementById('HMCartCloseBtn');
    var continueBtn = document.getElementById('HMCartContinueBtn');
    var checkoutBtn = document.getElementById('HMCartCheckoutBtn');

    var productImg = document.getElementById('HMCartProductImg');
    var productTitle = document.getElementById('HMCartProductTitle');
    var productVariant = document.getElementById('HMCartProductVariant');
    var productPrice = document.getElementById('HMCartProductPrice');
    var productQty = document.getElementById('HMCartProductQty');

    var shippingProgress = document.getElementById('HMCartShippingProgress');
    var shippingText = document.getElementById('HMCartShippingText');
    var subtotalCount = document.getElementById('HMCartSubtotalCount');
    var subtotalAmount = document.getElementById('HMCartSubtotalAmount');
    var discountAmountEl = document.getElementById('HMCartDiscountAmount');
    var finalAmountEl = document.getElementById('HMCartFinalAmount');
    var savingsAmountEl = document.getElementById('HMCartSavingsAmount');

    var FREE_SHIPPING_THRESHOLD = 200000; // ₹2,000 in paise
    var DISCOUNT_RATE = 0.20; // 20% DIWALI20 offer

    function ensureBodyPlacement() {
      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }
      if (popup && popup.parentElement !== document.body) {
        document.body.appendChild(popup);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensureBodyPlacement);
    } else {
      ensureBodyPlacement();
    }

    function formatINR(paiseOrRupees) {
      var num = typeof paiseOrRupees === 'number' ? paiseOrRupees : parseInt(paiseOrRupees, 10) || 0;
      var rupees = num > 9999 ? Math.round(num / 100) : num;
      try {
        return '₹' + rupees.toLocaleString('en-IN');
      } catch (e) {
        return '₹' + rupees;
      }
    }

    function openPopup(itemData) {
      ensureBodyPlacement();
      if (!popup || !overlay) return;

      // 1. Populate Added Item Info
      if (itemData) {
        var title = itemData.product_title || itemData.title || 'Handcrafted Wooden Decor';
        if (productTitle) productTitle.textContent = title;

        var imgSrc = itemData.image || itemData.featured_image;
        if (imgSrc && typeof imgSrc === 'object' && imgSrc.url) {
          imgSrc = imgSrc.url;
        }
        if (imgSrc && typeof imgSrc === 'string') {
          if (imgSrc.indexOf('//') === 0) imgSrc = 'https:' + imgSrc;
          if (productImg) {
            productImg.src = imgSrc;
            productImg.alt = title;
          }
        }

        var variantTitle = itemData.variant_title;
        if (variantTitle && variantTitle !== 'Default Title' && variantTitle !== 'Default') {
          if (productVariant) {
            productVariant.textContent = variantTitle;
            productVariant.style.display = 'block';
          }
        } else if (productVariant) {
          productVariant.style.display = 'none';
        }

        var priceVal = itemData.final_price || itemData.price || itemData.original_price || 0;
        if (productPrice) productPrice.textContent = formatINR(priceVal);

        var qtyVal = itemData.quantity || 1;
        if (productQty) productQty.textContent = 'Qty: ' + qtyVal;
      }

      // 2. Refresh Cart State Asynchronously (/cart.js)
      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          updateCartState(cart);
        })
        .catch(function(err) {
          console.warn('Could not fetch /cart.js', err);
        });

      // 3. Show Popup & Overlay
      overlay.classList.add('is-active');
      popup.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      popup.setAttribute('aria-hidden', 'false');

      // Prevent background scrolling
      document.documentElement.classList.add('hm-cart-locked');
      document.body.classList.add('hm-cart-locked');

      if (closeBtn) closeBtn.focus();
    }

    function closePopup() {
      if (!popup || !overlay) return;
      overlay.classList.remove('is-active');
      popup.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      popup.setAttribute('aria-hidden', 'true');

      document.documentElement.classList.remove('hm-cart-locked');
      document.body.classList.remove('hm-cart-locked');
    }

    function updateCartState(cart) {
      if (!cart) return;

      var count = cart.item_count || 1;
      var rawTotal = cart.total_price || 0;
      var discountAmt = Math.round(rawTotal * DISCOUNT_RATE);
      var finalTotal = Math.max(0, rawTotal - discountAmt);

      if (subtotalCount) {
        subtotalCount.textContent = 'Bag Total (' + count + (count === 1 ? ' item)' : ' items)');
      }
      if (subtotalAmount) {
        subtotalAmount.textContent = formatINR(rawTotal);
      }
      if (discountAmountEl) {
        discountAmountEl.textContent = '-' + formatINR(discountAmt);
      }
      if (finalAmountEl) {
        finalAmountEl.textContent = formatINR(finalTotal);
      }
      if (savingsAmountEl) {
        savingsAmountEl.textContent = formatINR(discountAmt);
      }

      // Free Shipping Calculator (Threshold: ₹2,000)
      if (shippingProgress && shippingText) {
        if (rawTotal >= FREE_SHIPPING_THRESHOLD) {
          shippingProgress.style.width = '100%';
          shippingText.innerHTML = '<strong>✓ You qualify for FREE Pan-India Delivery!</strong>';
        } else {
          var remaining = FREE_SHIPPING_THRESHOLD - rawTotal;
          var percent = Math.min(100, Math.max(8, Math.round((rawTotal / FREE_SHIPPING_THRESHOLD) * 100)));
          shippingProgress.style.width = percent + '%';
          shippingText.innerHTML = 'Add <strong>' + formatINR(remaining) + '</strong> more to unlock <strong>FREE Delivery</strong>!';
        }
      }

      // Update Header Cart Bubbles across the page
      var bubbleElements = document.querySelectorAll('.flo-cart-icon-bubble, .wt-header__panel__counter, #cart-icon-bubble .cart-count-bubble');
      bubbleElements.forEach(function(el) {
        el.textContent = count;
      });
    }

    // Event Listeners
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (continueBtn) continueBtn.addEventListener('click', closePopup);
    if (overlay) overlay.addEventListener('click', closePopup);

    document.addEventListener('keydown', function(e) {
      if ((e.key === 'Escape' || e.keyCode === 27) && popup && popup.classList.contains('is-active')) {
        closePopup();
      }
    });

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var code = 'DIWALI20';
        fetch('/discount/' + code)
          .finally(function() {
            if (typeof window.handleFloCheckoutBtn === 'function') {
              window.handleFloCheckoutBtn();
            } else {
              window.location.href = '/checkout?discount=' + code;
            }
          });
      });
    }

    // Expose global controller
    window.openHMCartPopup = openPopup;
    window.closeHMCartPopup = closePopup;
  })();
</script>
