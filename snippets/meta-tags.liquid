{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  {%- if settings.social_twitter_link contains 'twitter.com' or settings.social_twitter_link contains 'x.com' -%}
    {%- assign twitter_user = settings.social_twitter_link | split: 'twitter.com/' | last | split: 'x.com/' | last | split: '/' | first | split: '?' | first -%}
    {%- if twitter_user != blank -%}
      <meta name="twitter:site" content="@{{ twitter_user }}">
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<!-- Google Brand Knowledge Graph & Merchant Entity -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Organization", "OnlineStore"],
  "@id": "https://www.timberkala.com/#organization",
  "name": "Timberkala",
  "alternateName": ["Timber Kala", "TIMBER KALA"],
  "url": "https://www.timberkala.com",
  "logo": "https://www.timberkala.com/cdn/shop/files/Timber_Kala_Logo_7b253cba-6ed5-4e44-b429-cb40810b296e.png",
  "image": "https://www.timberkala.com/cdn/shop/files/Timber_Kala_Logo_7b253cba-6ed5-4e44-b429-cb40810b296e.png",
  "description": "Discover handcrafted wooden home decor that blends tradition with modern elegance. Explore unique, artisan-made wall decor, figurines, and home accents at Timberkala.",
  "email": "timberkala.marketing@gmail.com",
  "currenciesAccepted": "INR",
  "paymentAccepted": "Credit Card, Debit Card, UPI, Net Banking",
  "priceRange": "₹₹",
  "sameAs": [
    "https://www.instagram.com/timber.kala/",
    "https://www.facebook.com/Timberkala",
    "https://www.youtube.com/timberkala"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "timberkala.marketing@gmail.com",
    "availableLanguage": ["en", "hi"]
  }
}
</script>

<!-- Google WebSite & Sitelinks SearchBox -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.timberkala.com/#website",
  "url": "https://www.timberkala.com",
  "name": "Timberkala",
  "alternateName": ["Timber Kala", "TIMBER KALA"],
  "description": "Discover handcrafted wooden home decor that blends tradition with modern elegance.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.timberkala.com/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'collection' -%}
<!-- Google Breadcrumbs for Collection Sitelinks -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.timberkala.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- elsif request.page_type == 'product' -%}
<!-- Google Breadcrumbs for Products -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.timberkala.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}
