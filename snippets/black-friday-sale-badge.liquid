{% comment %}
  Timberkala Black Friday Sale Promo Badge
  Features:
  - Stitched artisanal card with subtle wood-grain contours
  - Timberkala reclaimed wood hallmark
  - "Black Friday Sale" headline in artisanal luxury serif typography
  - cutout.png tag showcasing the Black Friday Sale (no Cyber Monday)
  - Concentric circular 10% OFF seal
  - Middle bar: "Get flat 10% off on every order + 5% extra on Prepaid order."
  - Interactive "Reserve yours ↗" CTA linking to purchase/form
  - Dynamic rolling order counter
  - Fully responsive for mobile and desktop
{% endcomment %}

<style>
  .tk-maker-label {
    --walnut: #42291c;
    --ink: #39271c;
    --brass: #b49156;
    --paper: #f5ead5;
    position: relative;
    isolation: isolate;
    display: block;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
    color: var(--ink);
    background:
      radial-gradient(ellipse at 8% 10%, #fff9ec 0%, transparent 55%),
      linear-gradient(110deg, #f8efdc, #efdfc2);
    border: 1px solid #967447;
    border-radius: 5px;
    box-shadow: 0 3px 9px #39271c20;
    font-family: inherit;
    text-align: left;
    margin: 12px 0 16px;
  }

  .tk-maker-label *,
  .tk-maker-label *::before,
  .tk-maker-label *::after { box-sizing: border-box; }

  .tk-maker-label .tk-face {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px clamp(14px, 3vw, 24px) 16px;
    isolation: isolate;
  }

  .tk-maker-label .tk-face::before {
    content: "";
    position: absolute;
    inset: 5px;
    z-index: -1;
    border: 1px dashed #ab89567a;
    border-radius: 2px;
  }

  .tk-maker-label .tk-face::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: repeating-radial-gradient(
      ellipse 83px 64px at 103% 82%,
      transparent 0 8px, #8d62351c 9px, transparent 11px 17px
    );
    mask-image: linear-gradient(to right, transparent 30%, black);
  }

  .tk-maker-label .tk-face-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .tk-maker-label .tk-maker-line {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #735237;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: .16em;
    font-weight: 700;
    text-transform: uppercase;
  }

  .tk-maker-label .tk-maker-line::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--brass);
  }

  .tk-maker-label .tk-title-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tk-maker-label .tk-name {
    display: block;
    color: var(--walnut);
    font: 700 clamp(28px, 3.2vw, 44px)/1.05 Georgia, serif;
    letter-spacing: -.03em;
    white-space: nowrap;
  }

  .tk-maker-label .tk-name em {
    color: #794628;
    font-style: italic;
    font-weight: 400;
  }

  .tk-maker-label .tk-cutout-wrap {
    display: inline-flex;
    align-items: center;
    filter: drop-shadow(0 4px 10px rgba(58, 41, 31, 0.22));
  }

  .tk-maker-label .tk-cutout-img {
    display: block;
    height: clamp(52px, 6vw, 74px);
    width: auto;
    object-fit: contain;
    transform: rotate(-1deg);
  }

  .tk-maker-label .tk-seal {
    display: grid;
    align-content: center;
    justify-items: center;
    width: clamp(65px, 7vw, 83px);
    aspect-ratio: 1;
    border: 3px double #dec598;
    border-radius: 50%;
    outline: 1px solid #87693e;
    background: radial-gradient(ellipse at 35% 24%, #67432b, #3f281b 75%);
    box-shadow: inset 0 0 0 3px #543724, inset 0 0 0 4px #b69762;
    color: #fff2d8;
    transform: rotate(7deg);
    flex-shrink: 0;
  }

  .tk-maker-label .tk-seal strong {
    font: 700 clamp(22px, 2.4vw, 29px)/1 Georgia, serif;
    letter-spacing: -.06em;
  }

  .tk-maker-label .tk-seal small {
    margin-top: 3px;
    font-size: 9px;
    line-height: 1;
    letter-spacing: .2em;
    font-weight: 700;
  }

  .tk-maker-label .tk-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 9px 12px;
    padding: 10px clamp(13px, 2.5vw, 20px);
    background: var(--walnut);
    color: #f9ecd5;
    border-top: 1px solid var(--brass);
  }

  .tk-maker-label .tk-offer {
    flex: 1 1 180px;
    font-size: 13px;
    line-height: 1.4;
    color: #faf3e8;
  }

  .tk-maker-label .tk-offer strong {
    color: #ffffff;
    font-weight: 700;
  }

  .tk-maker-label .tk-reserve {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #d4b784;
    border-radius: 3px;
    background: #f2e1bf;
    color: #42291c;
    font: 700 13px/1.2 inherit;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 2px 5px rgba(0,0,0,0.12);
  }

  .tk-maker-label .tk-reserve:hover { background: #fff1d7; }

  .tk-maker-label .tk-preview {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px clamp(13px, 2.5vw, 20px);
    color: #604a37;
    font-size: 11.5px;
    letter-spacing: .08em;
  }

  .tk-maker-label .tk-wheels { display: inline-flex; gap: 3px; }

  .tk-maker-label .tk-window {
    display: inline-block;
    overflow: hidden;
    width: 1.25em;
    height: 1.45em;
    border-radius: 2px;
    background: #513827;
    color: #fff1d6;
    text-align: center;
    font: 700 13px/1.45 monospace;
  }

  .tk-maker-label .tk-reel {
    display: block;
    transition: transform .8s cubic-bezier(.22,.75,.18,1);
  }

  .tk-maker-label .tk-reel span { display: block; height: 1.45em; }

  @media (max-width: 600px) {
    .tk-maker-label .tk-title-row {
      gap: 10px;
    }
    .tk-maker-label .tk-cutout-img {
      height: 48px;
    }
    .tk-maker-label .tk-reserve {
      width: 100%;
      text-align: center;
    }
  }
</style>

<tk-maker-label class="tk-maker-label">
  <div class="tk-face">
    <div class="tk-face-content">
      <div class="tk-maker-line">Timberkala · Reclaimed wood</div>
      <div class="tk-title-row">
        <strong class="tk-name">Black Friday <em>Sale</em></strong>
        <div class="tk-cutout-wrap">
          <img class="tk-cutout-img" src="{{ 'cutout.png' | asset_url }}" alt="Black Friday Sale" width="234" height="126" loading="eager">
        </div>
      </div>
    </div>

    <div class="tk-seal" aria-hidden="true">
      <strong>10%</strong>
      <small>OFF</small>
    </div>
  </div>

  <div class="tk-band">
    <span class="tk-offer">
      Get flat <strong>10% off</strong> on every order + <strong>5% extra</strong> on Prepaid order.
    </span>
    <a class="tk-reserve"
       data-reserve
       href="{{ product.url }}?variant={{ product.selected_or_first_available_variant.id }}">
      <u>Reserve yours</u> <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="tk-preview">
    <span class="tk-wheels" aria-hidden="true" data-wheels>082</span>
    <span> ORDERS TODAY . GET YOURS BEFORE STOCK OUT </span>
  </div>
</tk-maker-label>

<script>
(() => {
  const tag = "tk-maker-label";
  if (customElements.get(tag)) return;

  customElements.define(tag, class extends HTMLElement {
    connectedCallback() {
      this.addEventListener("click", this.handleReserve);
      this.startup = setTimeout(() => this.startPreview(), 0);
    }

    disconnectedCallback() {
      clearTimeout(this.startup);
      clearTimeout(this.timer);
      this.removeEventListener("click", this.handleReserve);
    }

    handleReserve(event) {
      const link = event.target.closest("[data-reserve]");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const section = this.closest(".shopify-section") || document;
      const controls = section.querySelectorAll(
        "form[action*='/cart/add'] [name='add'], " +
        "form[action*='/cart/add'] button[type='submit']"
      );
      const target = Array.from(controls).find(button => button.getClientRects().length);
      if (!target) return;

      event.preventDefault();
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reducedMotion ? 'instant' : 'smooth', block: 'center' });
      if (!target.disabled) target.focus({ preventScroll: true });
    }

    startPreview() {
      const wheels = this.querySelector("[data-wheels]");
      if (!wheels) return;

      this.count = 82;
      wheels.replaceChildren();

      this.reels = Array.from("082", digit => {
        const frame = document.createElement("span");
        const reel = document.createElement("span");
        frame.className = "tk-window";
        reel.className = "tk-reel";

        for (let i = 0; i < 20; i++) {
          const cell = document.createElement("span");
          cell.textContent = i % 10;
          reel.append(cell);
        }

        reel.style.transform = `translateY(-${Number(digit) * 5}%)`;
        frame.append(reel);
        wheels.append(frame);
        return reel;
      });

      this.scheduleRoll();
    }

    scheduleRoll() {
      this.timer = setTimeout(() => {
        const next = Math.min(235, this.count + 1 + Math.floor(Math.random() * 4));
        const before = String(this.count).padStart(3, "0");
        const after = String(next).padStart(3, "0");

        this.reels.forEach((reel, index) => {
          const from = Number(before[index]);
          const to = Number(after[index]);
          if (from === to) return;

          reel.style.transition = "none";
          reel.style.transform = `translateY(-${from * 5}%)`;
          void reel.offsetHeight;
          reel.style.removeProperty("transition");
          const position = to < from ? to + 10 : to;
          reel.style.transform = `translateY(-${position * 5}%)`;
        });

        this.count = next;
        if (next < 235) this.scheduleRoll();
      }, 15000 + Math.floor(Math.random() * 15001));
    }
  });
})();
</script>
