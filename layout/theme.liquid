<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    
    
<script> window.Shopflo = { ...(window.Shopflo ?? {}), autoOnboarding: true} </script>

<script src='https://d24sh1msnqkirc.cloudfront.net/shopflo.bundle.js' async></script>

	<!-- Added by AVADA SEO Suite -->
	{% include 'avada-seo' %}
	<!-- /Added by AVADA SEO Suite -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <!-- Concept (Inova) Design System Typography: Jost -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <title>{{ page_title }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
<script src='https://bridge.shopflo.com/js/shopflo.bundle.js' async></script>
    {% render 'meta-tags' %}

    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'swiper.css' | asset_url | stylesheet_tag: preload: true }}

    {{ 'settings.css' | asset_url | stylesheet_tag }}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'variants.js' | asset_url }}" defer="defer"></script>

    <link rel="preload" href="{{ 'main.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'main.css' | asset_url }}"></noscript>
    {{ 'custom.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'base.js' | asset_url }}" defer="defer"></script>

    <script src="{{ 'color-swatch.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'drawer-select.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'model_element.js' | asset_url }}" defer="defer"></script>
    <script type="module" src="{{ 'gallery.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- comment -%}
      Judge.me CDN CSS loads via content_for_header above and overrides custom.css.
      This inline <style> block appears AFTER that link tag in the cascade, so our
      rules always win — even against Judge.me's own !important declarations.
    {%- endcomment -%}
    <style>
      /* ── TIMBERKALA: Authentic Artisan Jute Texture Background (Global Site-wide) ── */
      :root {
        --timberkala-jute-bg: url('{{ "jute-texture.jpg" | asset_url }}');
        --color-background: transparent !important;
        --color-custom-background: transparent !important;
      }

      /* Set background variables to transparent site-wide */
      html,
      body {
        --color-background: transparent !important;
        --color-custom-background: transparent !important;
      }

      html,
      body,
      #root,
      main#root {
        background-color: #cbb494 !important;
        background-image: var(--timberkala-jute-bg) !important;
        background-repeat: repeat !important;
        background-size: 320px 320px !important;
        background-attachment: scroll !important;
        color: #1a1a1a !important;
      }

      /* Seamless continuity: every structural container across all templates MUST be transparent */
      body .shopify-section,
      body .shopify-section > div,
      body .shopify-section > section,
      body .wt-featured-collection,
      body .wt-slider,
      body slideshow-section,
      body .wt-slider--wrapper,
      body .wt-slider__container,
      body .wt-slider__container--featured,
      body .wt-slider__slide,
      body .wt-slider__slide__content,
      body [data-section-id],
      body [data-swiper],
      body [data-swiper-container],
      body [data-swiper-slide],
      body .card__container,
      body .card__container--product,
      body a.card,
      body color-swatch,
      body .card__picture-container,
      body picture.card__picture,
      body .card__picture,
      body .headline,
      body .headline__title,
      body .inova-bento-section,
      body .inova-bento-container,
      body .inova-collection-grid-section,
      body [id*="inova-bento"],
      body #shopify-section-header-group,
      body .shopify-section-group-header-group,
      /* Collection page specific */
      body .collection,
      body .collection__body,
      body .collection__header,
      body .collection__grid,
      body .collection__grid__item,
      body .collection__sticky-header,
      body .collection__toolbar,
      body .collection-section,
      /* Product detail page specific */
      body .wt-product__wrapper,
      body .wt-product,
      body .wt-product__gallery,
      body .wt-product__main,
      body .wt-product__info,
      body .wt-collapse,
      body .wt-collapse__section,
      body .wt-collapse__wrapper,
      body .wt-collapse__content,
      body .wt-collapse__target,
      body .product-form,
      body product-recommendations,
      body .related-products,
      /* Search page specific */
      body .search-results,
      body .search-results-tab__container,
      body .search-results-tab__nav,
      /* Blog / Article pages */
      body .main-blog,
      body .main-article,
      body .blog__item,
      /* Customer Account */
      body .customer,
      /* General pages */
      body .wt-page {
        background: transparent !important;
        background-color: transparent !important;
      }

      /* Product cards site-wide: rounded portrait cards that float cleanly on the jute */
      body .card__picture {
        border-radius: 12px !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
        overflow: hidden !important;
        transition: transform 0.35s ease, box-shadow 0.35s ease !important;
      }

      body .card__picture:hover {
        transform: translateY(-4px) !important;
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.14) !important;
      }

      /* Header: clean frosted luxury bar site-wide */
      body .page-header,
      body .wt-header,
      body .wt-header__body {
        background: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
      }

      /* Navigation dropdowns and mobile navigation drawer */
      body .wt-header__nav__dropdown,
      body .wt-header__dropdown,
      body .wt-drawer--nav .wt-drawer__content,
      body .mobile-facets__inner,
      body .mobile-facets__header,
      body .mobile-facets__footer,
      body .mobile-facets__submenu,
      body .mobile-facets__main,
      body .custom-select__list,
      body .custom-select__option {
        background-color: #ffffff !important;
        color: #1a1a1a !important;
      }

      body .wt-drawer--nav .wt-drawer__content {
        box-shadow: 10px 0 35px rgba(0, 0, 0, 0.15) !important;
      }

      /* Collection filter popovers: solid white / ivory with gold border */
      body .facets__display,
      body .facets__header {
        background-color: #ffffff !important;
        color: #1a1a1a !important;
        border-radius: 8px !important;
        border: 1px solid rgba(212, 175, 55, 0.25) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12) !important;
      }

      /* Cart drawer: frosted luxury ivory slideout */
      body .wt-cart__drawer {
        background: rgba(255, 255, 255, 0.98) !important;
        backdrop-filter: blur(14px) !important;
        -webkit-backdrop-filter: blur(14px) !important;
        box-shadow: -8px 0 36px rgba(0, 0, 0, 0.15) !important;
      }

      body .wt-cart__drawer__header {
        border-bottom: 1px solid rgba(212, 175, 55, 0.2) !important;
      }

      /* Standalone Cart page: frosted luxury container */
      body.template-cart .wt-cart__wrapper.cart-page {
        background: rgba(255, 255, 255, 0.92) !important;
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
        border-radius: 16px !important;
        border: 1px solid rgba(212, 175, 55, 0.25) !important;
        padding: 32px !important;
        margin-top: 24px !important;
        margin-bottom: 40px !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06) !important;
      }

      /* Text content pages: elegant frosted parchment card for superior reading experience */
      body.template-page .wt-page,
      body.template-article .article-template,
      body.template-article .article-template__content {
        background: rgba(255, 255, 255, 0.90) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        border-radius: 16px !important;
        border: 1px solid rgba(212, 175, 55, 0.22) !important;
        padding: 36px 32px !important;
        margin-top: 24px !important;
        margin-bottom: 48px !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05) !important;
      }

      /* Search page input & predictive flyout */
      body .search-result__form .wt-header__search__form,
      body .search-results__fieldset,
      body .predictive-search {
        background: rgba(255, 255, 255, 0.96) !important;
        color: #1a1a1a !important;
      }

      body .predictive-search {
        border-radius: 12px !important;
        border: 1px solid rgba(212, 175, 55, 0.25) !important;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.15) !important;
      }

      /* Quick Buy popup */
      body .wt__quick-buy,
      body .wt__quick-buy__container {
        background: #ffffff !important;
        border-radius: 16px !important;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2) !important;
      }

      /* Inputs & Form Controls Site-wide */
      body input[type="text"],
      body input[type="email"],
      body input[type="tel"],
      body input[type="search"],
      body input[type="number"],
      body input[type="password"],
      body select,
      body textarea,
      body .form__field__input,
      body .form__field__textarea {
        background-color: rgba(255, 255, 255, 0.95) !important;
        color: #1a1a1a !important;
        border: 1px solid rgba(26, 26, 26, 0.25) !important;
        border-radius: 8px !important;
      }

      body input:focus,
      body select:focus,
      body textarea:focus {
        border-color: #d4af37 !important;
        outline: none !important;
        box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.25) !important;
      }

      /* PDP Sticky Buy Button */
      body .wt-product__sticky-buy {
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08) !important;
        border-top: 1px solid rgba(212, 175, 55, 0.25) !important;
      }

      body .wt-product__name {
        color: #1a1a1a !important;
        font-weight: 700 !important;
        letter-spacing: 0.02em !important;
      }

      body .wt-collapse__trigger {
        border-bottom: 1px solid rgba(26, 26, 26, 0.15) !important;
        color: #1a1a1a !important;
      }

      body .wt-collapse__trigger__title {
        color: #1a1a1a !important;
        font-weight: 600 !important;
        letter-spacing: 0.04em !important;
      }

      /* Judge.me reviews section: transparent background so cards float on jute weave */
      body .shopify-section:has(.jdgm-cards-carousel),
      body .shopify-section:has(.jdgm-widget) {
        background: transparent !important;
        border-top: 1px solid rgba(212, 175, 55, 0.25) !important;
        border-bottom: 1px solid rgba(212, 175, 55, 0.25) !important;
      }

      /* Featured collection headings: handcrafted elegance */
      body .wt-featured-collection .headline,
      body .wt-featured-collection .headline__title {
        text-align: center !important;
        margin-bottom: 24px !important;
      }

      body .wt-featured-collection .headline__title h2,
      body .wt-featured-collection .headline h2,
      body .wt-featured-collection [data-block-id] h2 {
        font-family: 'Cinzel', 'Playfair Display', Georgia, serif !important;
        font-size: clamp(22px, 3.2vw, 36px) !important;
        font-weight: 700 !important;
        letter-spacing: 0.12em !important;
        text-transform: uppercase !important;
        color: #1a1a1a !important;
        margin: 0 auto 12px !important;
        position: relative !important;
        display: inline-block !important;
      }

      body .wt-featured-collection .headline__title h2::after,
      body .wt-featured-collection .headline h2::after {
        content: "" !important;
        display: block !important;
        width: 60px !important;
        height: 2px !important;
        background: linear-gradient(90deg, transparent, #d4af37, transparent) !important;
        margin: 8px auto 0 !important;
      }

      /* Product cards text */
      body .card__title {
        color: #1a1a1a !important;
        font-weight: 600 !important;
        letter-spacing: 0.02em !important;
      }

      body .card__price,
      body .card__price .wt-product__price__final,
      body .card__price span {
        color: #1a1a1a !important;
        font-weight: 700 !important;
      }

      body .card__price .card__price__old {
        color: #73695e !important;
      }

      /* Pill-shaped View All buttons */
      body .wt-featured-collection__button-container .hero__button--primary {
        background: rgba(255, 255, 255, 0.9) !important;
        color: #1a1a1a !important;
        border: 1.5px solid rgba(26, 26, 26, 0.35) !important;
        border-radius: 999px !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06) !important;
        padding: 12px 32px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        letter-spacing: 0.12em !important;
        text-transform: uppercase !important;
        transition: all 0.3s ease !important;
      }

      body .wt-featured-collection__button-container .hero__button--primary:hover {
        background: #1a1a1a !important;
        color: #ffffff !important;
        border-color: #1a1a1a !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18) !important;
      }

      /* ── TIMBERKALA: Judge.me Review Carousel Overrides ── */

      /* Section backdrop — transparent so reviews float on jute weave */
      .shopify-section:has(.jdgm-cards-carousel),
      .shopify-section:has(.jdgm-widget) {
        background: transparent !important;
        padding: 70px 0 75px !important;
        margin: 30px 0 !important;
        border-top: 1px solid rgba(212, 175, 55, 0.25) !important;
        border-bottom: 1px solid rgba(212, 175, 55, 0.25) !important;
      }

      /* Title: never truncated */
      .jdgm-testimonials-carousel .jdgm-title,
      .jdgm-videos-carousel .jdgm-title,
      .jdgm-cards-carousel .jdgm-title,
      .jdgm-widget .jdgm-title,
      .jdgm-title,
      h2.jdgm-title {
        display: block !important;
        -webkit-line-clamp: unset !important;
        -webkit-box-orient: unset !important;
        line-clamp: unset !important;
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        text-overflow: unset !important;
        white-space: normal !important;
        font-family: 'Cinzel', 'Playfair Display', Georgia, serif !important;
        font-size: clamp(18px, 2.2vw, 28px) !important;
        font-weight: 700 !important;
        letter-spacing: 0.08em !important;
        text-transform: uppercase !important;
        color: #1a1a1a !important;
        margin: 0 !important;
        line-height: 1.35 !important;
        word-break: break-word !important;
        overflow-wrap: break-word !important;
        max-width: 100% !important;
        width: auto !important;
      }

      /* Rating pill */
      .jdgm-cards-carousel .jdgm-header-info {
        background: #ffffff !important;
        border: 1px solid rgba(212,175,55,0.35) !important;
        border-radius: 999px !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05) !important;
        padding: 9px 22px !important;
      }

      /* Stars in header pill */
      .jdgm-cards-carousel .jdgm-star,
      .jdgm-header-info .jdgm-star {
        color: #d4af37 !important;
        font-size: 16px !important;
      }
      .jdgm-cards-carousel .jdgm-star.jdgm--on::before,
      .jdgm-header-info .jdgm-star.jdgm--on::before,
      .jdgm-cards-carousel .jdgm-star.jdgm--half::before,
      .jdgm-header-info .jdgm-star.jdgm--half::before {
        content: "★" !important;
        color: #d4af37 !important;
        font-family: -apple-system, Arial, sans-serif !important;
        font-style: normal !important;
      }
      .jdgm-cards-carousel .jdgm-star.jdgm--off::before,
      .jdgm-header-info .jdgm-star.jdgm--off::before {
        content: "★" !important;
        color: #e0d8c8 !important;
        font-family: -apple-system, Arial, sans-serif !important;
        font-style: normal !important;
      }

      /* Card */
      .jdgm-cards-carousel .jdgm-media-card {
        background: #ffffff !important;
        border: 1px solid rgba(212,175,55,0.25) !important;
        border-radius: 20px !important;
        box-shadow: 0 8px 32px rgba(0,0,0,0.05) !important;
        padding: 36px 30px 28px !important;
        min-height: 300px !important;
        position: relative !important;
        overflow: hidden !important;
        transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease !important;
      }
      .jdgm-cards-carousel .jdgm-media-card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08), 0 0 28px rgba(212,175,55,0.15) !important;
        border-color: rgba(212,175,55,0.5) !important;
      }

      /* Gold top-edge accent line */
      .jdgm-cards-carousel .jdgm-media-card::after {
        content: '' !important;
        position: absolute !important;
        top: 0 !important;
        left: 28px !important;
        right: 28px !important;
        height: 2px !important;
        background: linear-gradient(90deg, transparent, rgba(212,175,55,0.5), transparent) !important;
        border-radius: 0 0 2px 2px !important;
        display: block !important;
      }

      /* Opening quote mark — large gold serif " */
      .jdgm-cards-carousel .jdgm-media-card::before {
        content: '\201C' !important;
        display: block !important;
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 88px !important;
        line-height: 0.6 !important;
        color: #d4af37 !important;
        opacity: 0.55 !important;
        margin-bottom: 20px !important;
        letter-spacing: 0 !important;
        text-align: left !important;
        font-style: normal !important;
      }

      /* Review body text */
      .jdgm-cards-carousel .jdgm-media-card .jdgm-text p {
        font-family: Georgia, serif !important;
        font-style: italic !important;
        font-size: 15px !important;
        line-height: 1.75 !important;
        color: #3a3530 !important;
        margin: 0 !important;
        -webkit-line-clamp: unset !important;
        overflow: visible !important;
      }

      /* Footer divider */
      .jdgm-cards-carousel .jdgm-media-card .jdgm-rating-section {
        border-top: 1px solid rgba(212,175,55,0.14) !important;
        margin-top: 22px !important;
        padding-top: 20px !important;
      }

      /* Stars inside cards — force Unicode ★ regardless of icon font */
      .jdgm-cards-carousel .jdgm-media-card .jdgm-star {
        font-family: -apple-system, Arial, sans-serif !important;
        font-style: normal !important;
        font-size: 15px !important;
        display: inline-block !important;
        width: auto !important;
        height: auto !important;
        background: none !important;
        text-decoration: none !important;
      }
      .jdgm-cards-carousel .jdgm-media-card .jdgm-star.jdgm--on::before,
      .jdgm-cards-carousel .jdgm-media-card .jdgm-star.jdgm--half::before {
        content: "★" !important;
        font-family: -apple-system, Arial, sans-serif !important;
        color: #d4af37 !important;
        font-style: normal !important;
      }
      .jdgm-cards-carousel .jdgm-media-card .jdgm-star.jdgm--off::before {
        content: "★" !important;
        font-family: -apple-system, Arial, sans-serif !important;
        color: #e8dfc8 !important;
        font-style: normal !important;
      }

      /* Reviewer name */
      .jdgm-cards-carousel .jdgm-media-card .jdgm-reviewer-name {
        font-family: system-ui, sans-serif !important;
        font-size: 13.5px !important;
        font-weight: 700 !important;
        color: #1a1a1a !important;
        letter-spacing: 0.03em !important;
      }

      /* Verified checkmark — gold */
      .jdgm-cards-carousel .jdgm-verified-checkmark {
        fill: #d4af37 !important;
        color: #d4af37 !important;
        width: 14px !important;
        height: 14px !important;
      }
      .jdgm-cards-carousel .jdgm-verified-checkmark svg,
      .jdgm-cards-carousel .jdgm-verified-checkmark path {
        fill: #d4af37 !important;
        color: #d4af37 !important;
      }

      /* Product name under reviewer */
      .jdgm-cards-carousel .jdgm-media-card .jdgm-product-name a,
      .jdgm-cards-carousel .jdgm-media-card .jdgm-product-name {
        font-size: 10px !important;
        font-weight: 600 !important;
        color: #b09a6e !important;
        text-transform: uppercase !important;
        letter-spacing: 0.12em !important;
        text-decoration: none !important;
        border-bottom: none !important;
        text-underline-offset: unset !important;
      }

      /* Navigation arrows — gold hover */
      .jdgm-cards-carousel .jdgm-arrow {
        width: 46px !important;
        height: 46px !important;
        border-radius: 50% !important;
        border: 1.5px solid rgba(26,26,26,0.6) !important;
        background: #ffffff !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06) !important;
        transition: all 0.25s ease !important;
      }
      .jdgm-cards-carousel .jdgm-arrow:hover {
        background: linear-gradient(135deg,#d4af37,#b8860b) !important;
        border-color: #d4af37 !important;
        box-shadow: 0 8px 24px rgba(212,175,55,0.35) !important;
        transform: scale(1.06) !important;
      }
      .jdgm-cards-carousel .jdgm-arrow:hover svg {
        fill: #ffffff !important;
      }

      @media (max-width: 600px) {
        .jdgm-testimonials-carousel .jdgm-title,
        .jdgm-videos-carousel .jdgm-title,
        .jdgm-cards-carousel .jdgm-title,
