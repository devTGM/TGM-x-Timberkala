<!-- Black Gold Luxury Scroll Top -->
<button id="scrollTopBtn" aria-label="Back to top">
  ↑
</button>

<style>
#scrollTopBtn{
  position: fixed;
  right: 25px;
  bottom: 25px;

  width: 56px;
  height: 56px;

  border-radius: 50%;
  border: 2px solid #d4af37;

  /* black base */
  background: #000;

  /* gold text */
  color: #d4af37;

  font-size: 26px;
  font-weight: 900;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  /* 🔥 premium glow shadow */
  box-shadow:
    0 8px 25px rgba(0,0,0,0.45),
    0 0 10px rgba(212,175,55,0.4);

  opacity: 0;
  visibility: hidden;
  transform: scale(.75) translateY(20px);

  transition: all .35s cubic-bezier(.22,1,.36,1);

  z-index: 9999;
}

/* show animation */
#scrollTopBtn.show{
  opacity: 1;
  visibility: visible;
  transform: scale(1) translateY(0);
}

/* 🔥 gold fill hover */
#scrollTopBtn:hover{
  background: linear-gradient(135deg,#d4af37,#f6e27a);
  color:#000;
  transform: scale(1.12);
  box-shadow: 0 12px 40px rgba(212,175,55,0.6);
}

/* click press */
#scrollTopBtn:active{
  transform: scale(.95);
}

/* mobile */
@media(max-width:768px){
  #scrollTopBtn{
    width:48px;
    height:48px;
    font-size:22px;
    right:18px;
    bottom:18px;
  }
}
</style>

<script>
const btn = document.getElementById("scrollTopBtn");

window.addEventListener("scroll", () => {
  if(window.scrollY > 250){
    btn.classList.add("show");
  }else{
    btn.classList.remove("show");
  }
});

btn.addEventListener("click", () => {
  window.scrollTo({top:0, behavior:'smooth'});
});
</script>

<!-- Announcement bar: hide on scroll down, show on scroll up (collection & product pages) -->
<script>
(function() {
  if (document.body.classList.contains('template-index')) return;

  var annBar = null;
  var lastScrollY = window.scrollY || window.pageYOffset;
  var ticking = false;

  function getBar() {
    if (!annBar) {
      annBar = document.querySelector('[id*="__announcement-bar"]') ||
               document.querySelector('.topbar-section') ||
               document.querySelector('announcement-bar') ||
               document.querySelector('.wt-announcement');
    }
    return annBar;
  }

  function onScroll() {
    var bar = getBar();
    if (!bar) return;
    var currentY = window.scrollY || window.pageYOffset;

    if (currentY > lastScrollY && currentY > 60) {
      // Scrolling down — hide bar
      bar.classList.add('announcement-bar--hidden');
      bar.classList.remove('announcement-bar--visible');
    } else if (currentY < lastScrollY) {
      // Scrolling up — show bar
      bar.classList.remove('announcement-bar--hidden');
      bar.classList.add('announcement-bar--visible');
    }
    lastScrollY = currentY <= 0 ? 0 : currentY;
    ticking = false;
  }

  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });
})();
</script>





























