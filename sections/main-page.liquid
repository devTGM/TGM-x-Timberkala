{% assign background_rgb = section.settings['color-bg-overlay'] | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}
<style>
  section[id="shopify-section-{{ section.id }}"]{
      {% if section.settings.full-width-enabled %}
        --border-radius: 0;
      {% endif %}

      {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.color-bg-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: {{ section.settings['color-overlay-opacity'] | divided_by: 100.0 }};
      {% endif %}

      {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
      {% endif %}

      {% if section.settings.margin-top %}
          --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
          --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      --font-headline-scale-desk: {{ section.settings.size_heading | divided_by: 100.0 }};

      --font-headline-scale: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};

  }
</style>

<div
  data-section-id="{{ section.id }}"
  class="wt-page {% if section.settings.compact-size-enabled == true %}  wt-page--compact{% endif %}"
>
  <h1 class="wt-page__title">
    {{ page.title | escape }}
  </h1>
  <div class="rte wt-page__wrapper">
    {{ page.content }}
  </div>
</div>

{%- if page.handle == 'faq' or page.url contains 'faq' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What types of handcrafted home decor products does Timberkala offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Timberkala crafts bespoke, artisanal wooden home decor items including handcarved spiritual sculptures, 3D layered wall accents, molten glass on teak root wood vases, animal figurines, wind chimes, and contemporary tabletop statement art pieces."
      }
    },
    {
      "@type": "Question",
      "name": "Are all Timberkala products handmade from authentic reclaimed wood?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, every Timberkala piece is individually handcrafted by master woodworking artisans using 100% sustainable reclaimed teak wood and weathered driftwood, preserving natural grain variations, knots, and organic textures."
      }
    },
    {
      "@type": "Question",
      "name": "What wood species does Timberkala use in its sculptures and wall art?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We primarily work with aged, reclaimed teak wood (Tectona grandis) and salvaged river driftwood. Aged reclaimed teak provides unmatched density, natural oil content, rich golden-brown patina, and structural stability against warping."
      }
    },
    {
      "@type": "Question",
      "name": "Is handcrafted wooden decor termite-resistant and borer-proof?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our reclaimed teak naturally contains high levels of protective silica and essential oils that naturally repel termites. Furthermore, all timber undergoes kiln-seasoning and is sealed with deep-penetrating organic bio-wax finishes for lifelong pest resistance."
      }
    },
    {
      "@type": "Question",
      "name": "How should I clean and care for handcrafted wooden sculptures?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dust gently with a clean, dry microfiber cloth. Avoid chemical detergents, harsh alcohol sprays, or prolonged direct water exposure. An annual application of natural beeswax polish or mineral oil restores deep grain luster and protects the wood finish."
      }
    },
    {
      "@type": "Question",
      "name": "Reclaimed teak wood vs sheesham for decor: What makes reclaimed teak unique?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aged reclaimed teak wood is decades old, which means moisture content has stabilized completely, preventing seasonal shrinking or expanding. It offers superior water resistance, natural oil saturation, and a distinct organic golden patina compared to newly harvested timber."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best direction to hang a wooden Ganesha wall art as per Vastu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to Vastu Shastra, placing or hanging a wooden Ganesha on the North, Northeast, or East wall invites positive energy, prosperity, and harmony into your living room or entrance foyer. Avoid placing sacred idols on South walls or facing bathrooms."
      }
    },
    {
      "@type": "Question",
      "name": "How to hang heavy wooden wall art and sculptures safely on living room walls?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every Timberkala wall piece comes equipped with reinforced rear mounting brackets or heavy-duty keyhole cleats. For brick and concrete walls, use standard rawl plugs (anchors) and 1.5 to 2-inch stainless steel screws to ensure secure, wobble-free installation."
      }
    },
    {
      "@type": "Question",
      "name": "What are the benefits of Wabi-Sabi wooden decor in modern Indian homes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wabi-Sabi aesthetics celebrate organic asymmetry, natural weathering, and imperfect beauty. Timberkala's reclaimed wood accents introduce grounding warmth, biophilic serenity, and artisanal soul to contemporary urban apartments."
      }
    },
    {
      "@type": "Question",
      "name": "Where does Timberkala source its reclaimed wood and materials?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We ethically salvage discarded structural beams, old havelis, vintage architectural columns, and fallen driftwood roots across regional artisan clusters in India, diverting quality timber from landfills into timeless luxury art."
      }
    },
    {
      "@type": "Question",
      "name": "Are shipments insured against transit damage across India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100% of Timberkala shipments are covered under comprehensive transit insurance. Each artifact is packed in multi-layered honeycomb corrugated boxes with custom foam corners. In the rare event of transit damage, we offer an immediate free replacement."
      }
    },
    {
      "@type": "Question",
      "name": "How long does Pan-India delivery take from order placement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Orders are dispatched within 24 to 48 hours from our atelier. Express delivery takes 2–4 business days for metropolitan cities (Delhi NCR, Mumbai, Bengaluru, Hyderabad) and 4–7 business days for rest of India."
      }
    },
    {
      "@type": "Question",
      "name": "What is Timberkala's return and replacement policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer a hassle-free 7-day return and exchange policy for any damaged, defective, or incorrect items. Simply contact our support team via WhatsApp or email with unboxing photos or video, and our logistics partner will arrange pickup."
      }
    },
    {
      "@type": "Question",
      "name": "Can I customize wooden wall accents or sculptures for interior design projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we collaborate closely with architects, interior designers, and discerning homeowners for custom sizing, specialized wood stains, and bespoke architectural carvings. Contact us at info@timberkala.com or WhatsApp to discuss your project."
      }
    },
    {
      "@type": "Question",
      "name": "Does Timberkala offer handcrafted corporate gifts and B2B orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Timberkala curates premium handcrafted corporate gift sets and festive hampers with bespoke laser branding, custom packaging, and doorstep pan-India delivery for companies, weddings, and VIP events."
      }
    },
    {
      "@type": "Question",
      "name": "Can molten glass on teak root wood hold water for live flowers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, each recycled molten glass vessel is hand-blown directly onto its matching teak root cradle while hot, creating a perfect custom fit that is completely watertight, durable, and ideal for hydroponic plants or fresh floral arrangements."
      }
    },
    {
      "@type": "Question",
      "name": "What protective finishes and polishes are applied to the wood?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We use zero-VOC, food-safe organic natural oils and beeswax polishes that enrich the organic timber grain without releasing harmful chemical fumes, making them completely safe for children and indoor air quality."
      }
    },
    {
      "@type": "Question",
      "name": "How can I track my Timberkala order after dispatch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once dispatched, you will automatically receive an SMS and email notification containing your airway bill (AWB) number and live tracking link to monitor shipment status in real time."
      }
    },
    {
      "@type": "Question",
      "name": "Does Timberkala offer gift packaging or personalized message cards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, complimentary artisanal gift wrapping and handwritten calligraphy greeting cards can be requested during checkout or by mentioning in the order notes."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get styling advice for curating my living room or entryway?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our styling specialists are available via WhatsApp or email. Simply share photos or dimensions of your wall or console table, and we will curate a personalized digital mockup and sculpture recommendations tailored to your space."
      }
    }
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.page.main_name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact-size-enabled",
      "label": "Use compact size for big screens",
      "default": true
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 140,
      "label": "t:sections.settings.settings.size-heading.label",
      "unit": "%"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading-mobile.label",
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "color-bg-overlay",
      "default": "transparent",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "range",
      "id": "color-overlay-opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.settings.settings.background-opacity.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
