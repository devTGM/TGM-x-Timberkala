pping & Transit Policy</a></li>\n          <li><a href=\"https://www.timberkala.com/policies/terms-of-service\">Terms of Service</a></li>\n        </ul>\n      </div>\n\n    </div>\n\n    <!-- Bottom Copyright -->\n    <div class=\"inova-footer-bottom\">\n      <div class=\"inova-footer-copy\">\n        \u00a9 2026 TIMBERKALA. ALL RIGHTS RESERVED. HANDCRAFTED IN INDIA.\n      </div>\n      <div class=\"inova-footer-badges\">\n        <span>SECURE CHECKOUT \u2022 100% TRANSIT GUARANTEED</span>\n      </div>\n    </div>\n\n  </div>\n</footer>\n\n<style>\n.inova-footer {\n  background: #1a1a1a;\n  color: #faf9f6;\n  font-family: 'Jost', sans-serif;\n  padding: 80px 24px 30px;\n  border-top: 1px solid rgba(255,255,255,0.08);\n}\n.inova-footer-wrap {\n  max-width: 1360px;\n  margin: 0 auto;\n}\n\n/* Newsletter Box */\n.inova-newsletter-box {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 40px;\n  padding-bottom: 60px;\n  margin-bottom: 60px;\n  border-bottom: 1px solid rgba(255,255,255,0.1);\n  flex-wrap: wrap;\n}\n.inova-nl-text {\n  max-width: 540px;\n}\n.inova-nl-eyebrow {\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  color: #ffddbf;\n  display: block;\n  margin-bottom: 6px;\n}\n.inova-nl-title {\n  font-family: 'Jost', sans-serif;\n  font-size: 24px;\n  font-weight: 500;\n  letter-spacing: 0.5px;\n  text-transform: uppercase;\n  color: #ffffff;\n  margin: 0 0 8px;\n}\n.inova-nl-desc {\n  font-size: 14px;\n  color: rgba(250,249,246,0.7);\n  line-height: 1.5;\n  margin: 0;\n}\n.inova-nl-form {\n  flex: 1;\n  min-width: 320px;\n  max-width: 500px;\n}\n.inova-nl-input-wrap {\n  display: flex;\n  background: rgba(255,255,255,0.06);\n  border: 1px solid rgba(255,255,255,0.2);\n  border-radius: 50px;\n  padding: 4px;\n  transition: border-color 0.3s ease;\n}\n.inova-nl-input-wrap:focus-within {\n  border-color: #ffddbf;\n}\n.inova-nl-input {\n  flex: 1;\n  background: transparent;\n  border: none;\n  outline: none;\n  padding: 12px 20px;\n  color: #ffffff;\n  font-family: 'Jost', sans-serif;\n  font-size: 13px;\n}\n.inova-nl-input::placeholder {\n  color: rgba(255,255,255,0.45);\n}\n.inova-nl-btn {\n  border-radius: 50px;\n  background: #ffffff;\n  color: #1a1a1a;\n  border: none;\n  font-family: 'Jost', sans-serif;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  padding: 12px 26px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n.inova-nl-btn:hover {\n  background: #ffddbf;\n  transform: translateY(-1px);\n}\n\n/* Footer Grid */\n.inova-footer-grid {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr 1fr;\n  gap: 48px;\n  margin-bottom: 60px;\n}\n.inova-col-title {\n  font-family: 'Jost', sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 1.8px;\n  text-transform: uppercase;\n  color: #ffffff;\n  margin: 0 0 20px;\n}\n.inova-brand-title {\n  font-size: 18px;\n  letter-spacing: 3px;\n}\n.inova-brand-desc {\n  font-size: 14px;\n  line-height: 1.7;\n  color: rgba(250,249,246,0.65);\n  margin-bottom: 24px;\n  max-width: 320px;\n}\n.inova-footer-socials {\n  display: flex;\n  gap: 12px;\n}\n.inova-social-link {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: rgba(255,255,255,0.06);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: #ffffff;\n  transition: all 0.3s ease;\n  text-decoration: none;\n}\n.inova-social-link:hover {\n  background: #ffddbf;\n  color: #1a1a1a;\n  transform: translateY(-2px);\n}\n.inova-footer-links {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.inova-footer-links a {\n  color: rgba(250,249,246,0.65);\n  text-decoration: none;\n  font-size: 13px;\n  letter-spacing: 0.3px;\n  transition: all 0.25s ease;\n  display: inline-block;\n}\n.inova-footer-links a:hover {\n  color: #ffddbf;\n  padding-left: 4px;\n}\n\n/* Footer Bottom */\n.inova-footer-bottom {\n  border-top: 1px solid rgba(255,255,255,0.08);\n  padding-top: 28px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n.inova-footer-copy {\n  font-size: 12px;\n  color: rgba(250,249,246,0.5);\n  letter-spacing: 1px;\n}\n.inova-footer-badges {\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 1.5px;\n  color: rgba(250,249,246,0.6);\n}\n\n@media (max-width: 990px) {\n  .inova-footer-grid {\n    grid-template-columns: 1fr 1fr;\n    gap: 36px;\n  }\n}\n@media (max-width: 600px) {\n  .inova-footer {\n    padding: 50px 18px 24px;\n  }\n  .inova-newsletter-box {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 24px;\n    margin-bottom: 40px;\n    padding-bottom: 40px;\n  }\n  .inova-nl-form {\n    width: 100%;\n    min-width: 100%;\n  }\n  .inova-footer-grid {\n    grid-template-columns: 1fr;\n    gap: 32px;\n  }\n  .inova-footer-bottom {\n    flex-direction: column;\n    text-align: center;\n  }\n}\n</style>"
