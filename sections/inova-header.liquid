<script src="{{ 'search-drawer.js' | asset_url }}" defer="defer"></script>

{% assign transparent_header_rgb = section.settings.transparent_header_color | color_to_rgb %}

{% style %}
  :root {
    --logo-width: {{ section.settings.mobile_screen_logo_width | default: 140 }}px;
    --logo-width-mobile: {{ section.settings.mobile_screen_logo_width | default: 140 }}px;
    --logo-width-desk: {{ section.settings.large_screen_logo_width | default: 220 }}px;
    --logo-max-height-desk: {{ section.settings.large_screen_logo_max_height | default: 75 }}px;
    --logo-max-height-mob: {{ section.settings.mobile_screen_logo_max_height | default: 50 }}px;
    --header-padding-y-desk: {{ section.settings.header_padding_vertical_desktop | default: 18 }}px;
    --header-padding-y-mob: {{ section.settings.header_padding_vertical_mobile | default: 12 }}px;
    --header-max-width: {{ section.settings.header_max_width | default: '1440px' }};
    --header-bg-color: {{ section.settings.header_bg_color | default: '#ffffff' }};
    --header-text-color: {{ section.settings.header_text_color | default: '#1a1a1a' }};
    --menu-hover-color: {{ section.settings.menu_hover_color | default: '#7b5454' }};
    --header-border-color: {{ section.settings.border_color | default: '#e8e5df' }};
    --menu-font-size: {{ section.settings.menu_font_size | default: 14 }}px;
    --menu-item-spacing: {{ section.settings.menu_item_spacing | default: 26 }}px;
    --menu-font-weight: {{ section.settings.menu_font_weight | default: '500' }};
    --menu-text-transform: {{ section.settings.menu_text_transform | default: 'uppercase' }};
    --menu-letter-spacing: {{ section.settings.menu_letter_spacing | default: 1 }}px;
  }

  /* ---------------- Prevent Duplicate Drawer Menu Bar on Desktop ---------------- */
  @media (min-width: 990px) {
    .wt-drawer--nav,
    body:not(.mobile-nav) .wt-drawer--nav,
    body:not(.mobile-nav) .wt-drawer,
    body:not(.mobile-nav) .wt-header ~ .wt-drawer--nav,
    .wt-header ~ .wt-drawer--nav {
      display: none !important;
      position: fixed !important;
      transform: translateX(-100%) !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      height: 0 !important;
      min-height: 0 !important;
      max-height: 0 !important;
      overflow: hidden !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
    }
  }
{% endstyle %}

<!-- =========================================================================
     CONCEPT (INOVA) SIGNATURE HEADER: MENU LEFT, LOGO CENTER, ACTIONS RIGHT
     ========================================================================= -->
<page-header
  role="banner"
  id="header"
  class="
    wt-header
    wt-header--inova
    {% if section.settings.show_shadow %} wt-header--shadow{% endif %}
    {% if section.settings.show_line_separator %} wt-header--separator{% endif %}
    {% if section.settings.sticky_header %} wt-header--sticky{% endif %}
  "
>
  <div class="wt-header__body wt-header__body--inova">
    <!-- LEFT: Mobile Menu Button + Inova Desktop Navigation -->
    <div class="wt-header__col wt-header__col--inova-left">
      <a
        href="#"
        class="wt-header__icon wt-header__menu-trigger inova-menu-trigger-mobile wt-icon"
        rel="toggle-menu"
        aria-label="{{ 'aria-label.page-header-toggle-menu' | t }}"
        aria-controls="wt-drawer-nav"
        aria-expanded="false"
        role="button"
        tabindex="0"
      >
        {% render 'icons', id: 'bars' %}
      </a>

      <div class="wt-header__desktop-nav">
        <mega-menu-section class="mega-menu mega-menu--inline">
          <nav class="wt-page-nav-mega wt-page-nav-mega--inline">
            {%- if section.settings.menu != blank -%}
              {% render 'mega-menu', menu: section.settings.menu, blocks: section.blocks %}
            {%- endif -%}
          </nav>
        </mega-menu-section>
      </div>
    </div>

    <!-- CENTER: Centered Brand Logo -->
    <div class="wt-header__col wt-header__col--inova-center">
      <h1 itemscope itemtype="http://schema.org/Organization" class="wt-header__logo inova-header__logo">
        <a href="{{ routes.root_url }}" class="wt-header__logo__link inova-logo__link">
          {%- if section.settings.logo != blank -%}
            {%- assign large_image_size = section.settings.large_screen_logo_width | default: 220 -%}
            {%- assign large_image_size_double = large_image_size | times: 2 -%}
            <img
              srcset="{{ section.settings.logo | image_url: width: large_image_size }} 1x, {{ section.settings.logo | image_url: width: large_image_size_double }} 2x"
              src="{{ section.settings.logo | image_url: width: large_image_size }}"
              loading="lazy"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              class="wt-header__logo__img inova-logo-desk"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
            {%- assign mobile_image_size = section.settings.mobile_screen_logo_width | default: 140 -%}
            {%- assign mobile_image_size_double = mobile_image_size | times: 2 -%}
            <img
              srcset="{{ section.settings.logo | image_url: width: mobile_image_size }} 1x, {{ section.settings.logo | image_url: width: mobile_image_size_double }} 2x"
              src="{{ section.settings.logo | image_url: width: mobile_image_size }}"
              loading="lazy"
              width="{{ section.settings.logo.width }}"
              height="{{ section.settings.logo.height }}"
              class="wt-header__logo__img inova-logo-mob"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            >
          {%- else -%}
            <span class="wt-header__logo__text inova-brand-text">{{ section.settings.inova_logo_text | default: 'I N O V A' }}</span>
          {%- endif -%}
        </a>
      </h1>
    </div>

    <!-- RIGHT: Currency Selector Pill + Search + Account + Cart -->
    <div class="wt-header__col wt-header__col--inova-right">
      {%- if section.settings.show_currency_selector != false -%}
        <div class="inova-currency-pill" role="button" tabindex="0" aria-label="Currency: {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}">
          <span class="inova-pill-flag">🇮🇳</span>
          <span class="inova-pill-code">{{ localization.country.currency.iso_code | default: 'INR' }}</span>
          <span class="inova-pill-symbol">{{ localization.country.currency.symbol | default: '₹' }}</span>
          <svg class="inova-pill-caret" width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      {%- endif -%}

      <!-- Search Drawer Trigger -->
      <search-drawer
        class="wt-header__search wt-drawer-search inova-search-trigger"
        data-loading-text="{{ 'accessibility.searching' | t }}"
      >
        <div
          class="wt-header__icon wt-header__search-trigger wt-icon"
          rel="toggle-search"
          tabindex="0"
          role="button"
          aria-label="{{ 'aria-label.page-header-open-search' | t }}"
        >
          {% render 'icons', id: 'search' %}
        </div>

        <form
          class="wt-header__search__body store-search-form"
          action="{{ routes.search_url }}"
          method="get"
          role="search"
        >
          <input type="hidden" name="type" value="product">

          <div class="wt-header__search__form">
            <label class="wt-header__icon wt-header__search__label" for="search-shop-inova-header">
              {% render 'icons', id: 'search' %}
              <span class="visually-hidden">{{ 'aria-label.page-header-search' | t }}</span>
            </label>
            <input
              type="text"
              placeholder="{{ section.settings.typing_search }}"
              id="search-shop-inova-header"
              name="q"
              class="wt-header__search__field"
              aria-controls="predictive-search-results-list"
              aria-autocomplete="list"
              aria-haspopup="listbox"
              aria-expanded="false"
              spellcheck="false"
              tabindex="-1"
              role="combobox"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              data-search="true"
              aria-label="{{ 'aria-label.page-header-search' | t }}"
            >

            <div class="wt-header__search__clear-button__container">
              <div
                class="wt-header__search__clear-button"
                role="button"
                aria-label="{{ 'aria-label.page-header-remove-all' | t }}"
                tabindex="-1"
              >
                {% render 'icons', id: 'close' -%}
                <span class="text">{{ 'aria-label.page-header-toggle-menu' | t }}</span>
              </div>
            </div>
            <button
              aria-label="{{ 'aria-label.page-header-search' | t }}"
              class="wt-header__search__button"
              tabindex="-1"
            >
              {% render 'icons', id: 'search' -%}
              <span class="text">{{ 'aria-label.page-header-search' | t }}</span>
            </button>
            <button
              aria-label="{{ 'aria-label.page-header-close-search' | t }}"
              class="wt-header__search__close"
              tabindex="-1"
            >
              {% render 'icons', id: 'close' %}
            </button>
          </div>
          <div class="wt-header__search__results">
            <div class="predictive-search-status">
              {% render 'search-top' %}
            </div>

            {% render 'loader' %}

            <div class="search-result-wrapper" data-predictive-search></div>
          </div>
        </form>
      </search-drawer>

      <!-- Account & Cart -->
      <ul class="wt-header__panel wt-header__panel--no-labels inova-header__panel">
        {%- if shop.customer_accounts_enabled -%}
          <li class="wt-header__panel__item wt-header__panel__item--account">
            <a href="{{ routes.account_url }}" class="wt-header__panel__link wt-icon" aria-label="Account">
              {% render 'icons', id: 'user' %}
              <span class="wt-header__panel__label">Account</span>
            </a>
          </li>
        {%- endif -%}
        <li class="wt-header__panel__item wt-header__panel__item--cart">
          <a onclick="handleFloCartBtn();" class="wt-header__panel__link wt-icon wt-cart__trigger" style="cursor:pointer;" id="cart-icon-bubble-inova-header" aria-label="Cart">
            {% render 'icons', id: 'bag' %}
            {% if cart.item_count != 0 %}
              <span class="flo-cart-icon-bubble wt-header__panel__counter">{{ cart.item_count }}</span>
            {% endif %}
            <span class="wt-header__panel__label">Cart</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</page-header>

<script>
  (function() {
    var header = document.querySelector('.wt-header--inova, .wt-header');
    var headerSection = document.querySelector('.inova-header-section, #shopify-section-header, [id*="__header"], .header-section, .page-header');
    if (!header && !headerSection) return;

    var isTicking = false;
    function checkHeaderStuck() {
      if (!isTicking) {
        window.requestAnimationFrame(function() {
          var target = headerSection || header;
          var rect = target.getBoundingClientRect();
          if (rect.top <= 1) {
            if (header) {
              header.classList.add('is-stuck');
              header.classList.add('header-scrolled');
            }
            if (headerSection) {
              headerSection.classList.add('is-stuck');
              headerSection.classList.add('header-scrolled');
            }
          } else {
            if (header) {
              header.classList.remove('is-stuck');
              header.classList.remove('header-scrolled');
            }
            if (headerSection) {
              headerSection.classList.remove('is-stuck');
              headerSection.classList.remove('header-scrolled');
            }
          }
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', checkHeaderStuck, { passive: true });
    window.addEventListener('resize', checkHeaderStuck, { passive: true });
    document.addEventListener('DOMContentLoaded', checkHeaderStuck);
    checkHeaderStuck();
  })();
</script>

{%- if request.page_type != 'cart' -%}
  {%- render 'cart-notification' -%}
{%- endif -%}

<!-- =========================================================================
     MOBILE & DRAWER NAVIGATION
     ========================================================================= -->
<drawer-nav
  class="wt-drawer wt-drawer--nav wt-drawer--mobile-nav"
  id="wt-drawer-nav"
>
  <div class="wt-drawer__content">
    <div class="wt-drawer__title">
      <div class="wt-drawer__title__text">{{ section.settings.drawer_title }}</div>
      <div
        class="wt-drawer__close"
        tabindex="-1"
        role="button"
        aria-label="{{ 'aria-label.page-header-toggle-menu' | t }}"
        aria-controls="wt-drawer-nav"
        aria-expanded="false"
      >
        {% render 'icons', id: 'close' %}
      </div>
    </div>

    <mega-menu-section class="mega-menu">
      <nav class="wt-page-nav-mega {% if section.settings.show_shadow %} wt-page-nav-mega--shadow{% endif %}">
        {%- if section.settings.menu != blank -%}
          {% render 'mega-menu', menu: section.settings.menu, blocks: section.blocks %}
        {%- endif -%}
      </nav>

      <aside class="wt-page-nav-mega__aside">
        <ul class="wt-page-nav-mega__aside-list">
          <li class="wt-page-nav-mega__aside-list__item">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="wt-page-nav-mega__aside-list__link"
                tabindex="-1"
              >
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
          </li>
          {%- for link in section.settings.mobile_footer_menu.links -%}
            <li class="wt-page-nav-mega__aside-list__item">
              <a
                href="{% if link.url %}{{ link.url }}{% else %}#{% endif %}"
                class="wt-page-nav-mega__aside-list__link"
                tabindex="-1"
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </aside>
    </mega-menu-section>
  </div>
</drawer-nav>

{% schema %}
{
