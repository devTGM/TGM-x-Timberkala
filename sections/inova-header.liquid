  "tag": "header",
  "class": "page-header inova-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Header Layout & Sizing"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "option_inova",
          "label": "Inova: Menu Left, Logo Center, Currency + Actions Right (Recommended)"
