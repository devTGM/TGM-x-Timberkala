{%- comment -%}
  Concept (Inova Preset) - Fullscreen Slideshow Hero Section
  Matches exact styling of Inova demo store on Desktop & Mobile:
  - 100vh Fullscreen Video & Image slides with proportional object-fit: cover (no stretching!)
  - Giant center brand watermark ("I N O V A" / "T I M B E R K A L A")
  - Floating pill dock with "GET 20% OFF" badge (visible on mobile and desktop)
  - Bottom-left slide heading + full-width mobile pill button
  - Bottom-left slide indicator dots (○ • •) matching mobile preview
{%- endcomment -%}

{%- if template.name == 'index' or section.settings.show_on_all_pages -%}
<div
  id="inova-slideshow-{{ section.id }}"
  class="inova-slideshow-wrapper desktop-height--{{ section.settings.desktop_height_mode | default: 'banner_ratio' }} mobile-height--{{ section.settings.mobile_height_mode | default: 'banner_ratio' }}"
  style="--desktop-height: {{ section.settings.desktop_height | default: 600 }}px;"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}"
>
  <!-- Fullscreen Slider Container -->
  <div class="inova-slides-container">
    {%- for block in section.blocks -%}
      {%- assign is_video = false -%}
      {%- if block.type == 'video' or block.settings.video != blank or block.settings.video_url != blank -%}
        {%- assign is_video = true -%}
      {%- endif -%}

      <div
        class="inova-slide {% if forloop.first %}inova-slide--active{% endif %}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <!-- Background Media (Guaranteed Proportional Fit - No Stretching) -->
        <div class="inova-slide-media">
          {%- if is_video -%}
            {%- assign v_url = block.settings.video_url -%}
            {%- if block.settings.video != blank -%}
              {%- assign v_url = block.settings.video.sources[0].url -%}
            {%- endif -%}
            {%- if v_url == blank -%}
              {%- assign v_url = 'https://concept-theme-inova.myshopify.com/cdn/shop/videos/c/vp/9bdc62d489594794ac76ea91dbaa597a/9bdc62d489594794ac76ea91dbaa597a.HD-1080p-2.5Mbps-35748949.mp4' -%}
            {%- endif -%}

            <!-- Mobile Banner on Video Slide (Exact 656x1024 fit) -->
            <picture class="inova-media-picture inova-mobile-only">
              {%- if block.settings.mobile_image != blank -%}
                <img
                  class="inova-media-element"
                  src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
                  alt="{{ block.settings.heading | default: 'Timberkala' | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                >
              {%- else -%}
                <img
                  class="inova-media-element"
                  src="{{ 'timberkala-mobile-banner.webp' | asset_url }}"
                  alt="{{ block.settings.heading | default: 'Timberkala Banner' | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                >
              {%- endif -%}
            </picture>

            <!-- Desktop Video -->
            <video
              class="inova-media-element inova-desktop-only"
              playsinline
              muted
              autoplay
              loop
              preload="metadata"
              {% if block.settings.fallback_image != blank %}
                poster="{{ block.settings.fallback_image | image_url: width: 1920 }}"
              {% else %}
                poster="{{ 'timberkala-desktop-banner.webp' | asset_url }}"
              {% endif %}
            >
              <source src="{{ v_url }}" type="video/mp4">
            </video>
          {%- else -%}
            <picture class="inova-media-picture">
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">
              {%- else -%}
                <source media="(max-width: 767px)" srcset="{{ 'timberkala-mobile-banner.webp' | asset_url }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="inova-media-element"
                  src="{{ block.settings.image | image_url: width: 2200 }}"
                  alt="{{ block.settings.heading | default: 'Timberkala' | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                >
              {%- else -%}
                <img
                  class="inova-media-element"
                  src="{{ 'timberkala-desktop-banner.webp' | asset_url }}"
                  alt="{{ block.settings.heading | default: 'Timberkala Banner' | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                >
              {%- endif -%}
            </picture>
          {%- endif -%}

          <!-- Gradient Overlay -->
          <div class="inova-slide-scrim {% if block.settings.hide_overlay_desktop %}desktop-scrim-hidden{% endif %} {% if block.settings.hide_overlay_mobile %}mobile-scrim-hidden{% endif %}"></div>
        </div>

        <!-- Slide Specific Content (Bottom Overlay) -->
        {%- assign has_content = false -%}
        {%- if block.settings.heading != blank or block.settings.button_label != blank -%}
          {%- assign has_content = true -%}
        {%- endif -%}

        {%- if has_content -%}
          <div class="inova-slide-content {% if block.settings.hide_overlay_mobile %}mobile-overlay-hidden{% endif %} {% if block.settings.hide_overlay_desktop %}desktop-overlay-hidden{% endif %}">
            <div class="inova-content-row">
              {%- if block.settings.heading != blank -%}
                <div class="inova-content-left">
                  <h2 class="inova-slide-heading">
                    {{ block.settings.heading }}
                  </h2>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="inova-content-right">
                  <a href="{{ block.settings.button_link | default: '/collections/all-products' }}" class="inova-hero-pill-btn">
                    <span>{{ block.settings.button_label }}</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if block.settings.button_link != blank -%}
          <a
            href="{{ block.settings.button_link }}"
            class="inova-slide-tap-link {% if block.settings.button_label != blank and block.settings.hide_overlay_mobile != true and block.settings.hide_overlay_desktop != true %}inova-slide-tap-link--mobile-only{% endif %}"
            aria-label="{{ block.settings.heading | default: 'Shop Now' }}"
          ></a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Giant Center Brand Letters ("I N O V A" / "T I M B E R K A L A") -->
  {%- if section.settings.show_brand_watermark -%}
    <div class="inova-brand-watermark {% if section.settings.show_brand_watermark_mobile == false %}mobile-watermark-hidden{% endif %}" aria-hidden="true">
      <span>{{ section.settings.brand_watermark | default: 'I N O V A' }}</span>
    </div>
  {%- endif -%}

  <!-- Left Floating Social & Promo Dock (Inova Signature - Visible on Desktop & Mobile) -->
  {%- if section.settings.show_social_dock -%}
    <aside class="inova-floating-dock {% if section.settings.show_social_dock_mobile == false %}mobile-dock-hidden{% endif %}" aria-label="Social and Discounts">
      <div class="inova-dock-socials">
        <a href="https://facebook.com/shopify" target="_blank" rel="noopener" aria-label="Facebook" class="inova-dock-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
        </a>
        <a href="https://twitter.com/shopify" target="_blank" rel="noopener" aria-label="X" class="inova-dock-icon">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://instagram.com/timber.kala" target="_blank" rel="noopener" aria-label="Instagram" class="inova-dock-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="inova-dock-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.79-.17-2 .03-2.86.19-.77 1.2-5.08 1.2-5.08s-.31-.62-.31-1.53c0-1.43.83-2.5 1.87-2.5.88 0 1.3.66 1.3 1.45 0 .88-.56 2.2-.85 3.42-.24 1.03.52 1.87 1.54 1.87 1.85 0 3.27-1.95 3.27-4.77 0-2.49-1.79-4.23-4.35-4.23-2.96 0-4.7 2.22-4.7 4.51 0 .89.34 1.85.77 2.37.09.1.1.19.07.3-.08.33-.26 1.06-.3 1.21-.05.21-.17.26-.39.16-1.46-.68-2.37-2.81-2.37-4.52 0-3.68 2.67-7.06 7.71-7.06 4.05 0 7.2 2.89 7.2 6.75 0 4.03-2.54 7.27-6.07 7.27-1.19 0-2.3-.62-2.68-1.35l-.73 2.78c-.26 1.02-.97 2.3-1.45 3.08C9.58 21.88 10.77 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
        </a>
      </div>

      <div class="inova-dock-divider"></div>

      <a href="{{ section.settings.dock_discount_url | default: '/collections/all-products' }}" class="inova-dock-badge">
        <span>{{ section.settings.dock_discount_text | default: 'GET 20% OFF' }}</span>
      </a>
    </aside>
  {%- endif -%}

  <!-- Bottom Navigation Bar (Arrows & Dots) -->
  <div class="inova-bottom-controls page-width">
    <!-- Previous Arrow (←) -->
    <button type="button" class="inova-nav-btn inova-nav-prev" aria-label="Previous slide">
      <svg width="34" height="20" viewBox="0 0 37 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 5L3 12M3 12L10 19M3 12H34"/>
      </svg>
    </button>

    <!-- Slide Indicator Dots (○ • •) -->
    <div class="inova-dots-bar" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="inova-dot-btn {% if forloop.first %}inova-dot-btn--active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>

    <!-- Next Arrow (→) -->
    <button type="button" class="inova-nav-btn inova-nav-next" aria-label="Next slide">
      <svg width="34" height="20" viewBox="0 0 37 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M27 5L34 12M34 12L27 19M34 12H3"/>
      </svg>
    </button>
  </div>
</div>

<style>
/* ==========================================================================
   CONCEPT (INOVA) FULLSCREEN SLIDESHOW
   ========================================================================== */
.inova-slideshow-wrapper {
  position: relative;
  width: 100%;
  height: 100vh;
  height: 100svh;
  height: 100dvh;
  min-height: 560px;
  overflow: hidden;
  background: #121212;
  margin: 0;
  padding: 0;
}

/* Slides Layer */
.inova-slides-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.inova-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              visibility 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
  z-index: 1;
}

.inova-slide--active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  z-index: 2;
}

/* Media (Image / Video) - Guaranteed Proportional Fit (No Stretching!) */
.inova-slide-media {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  overflow: hidden !important;
}

.inova-media-picture {
  display: block !important;
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}

.inova-media-element,
.inova-media-picture img,
.inova-slide-media img,
.inova-slide-media video {
  display: block !important;
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center center !important;
  transform: scale(1.04);
  transition: transform 7s cubic-bezier(0.1, 0.8, 0.2, 1);
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  max-width: none !important;
  max-height: none !important;
}

.inova-slide--active .inova-media-element,
.inova-slide--active .inova-media-picture img,
.inova-slide--active .inova-slide-media img,
.inova-slide--active .inova-slide-media video {
  transform: scale(1);
}

/* Scrim / Vignette overlay */
.inova-slide-scrim {
  position: absolute !important;
  inset: 0 !important;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.2) 0%,
    rgba(0, 0, 0, 0.05) 30%,
    rgba(0, 0, 0, 0.35) 65%,
    rgba(0, 0, 0, 0.75) 100%
  ) !important;
  pointer-events: none !important;
  z-index: 2;
}

/* Giant Center Brand Watermark (e.g. "I N O V A" / "T I M B E R K A L A") */
.inova-brand-watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 1500px;
  text-align: center;
  pointer-events: none;
  z-index: 3;
  user-select: none;
}

.inova-brand-watermark span {
  font-family: 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: clamp(50px, 13vw, 190px);
  font-weight: 400;
  letter-spacing: clamp(14px, 3.2vw, 55px);
  text-indent: clamp(14px, 3.2vw, 55px);
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.95);
  display: inline-block;
  white-space: nowrap;
  text-shadow: 0 4px 30px rgba(0, 0, 0, 0.25);
}

/* Left Floating Social & Promo Dock */
.inova-floating-dock {
  position: absolute;
  left: 28px;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 40px;
  padding: 22px 9px 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  z-index: 20;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.inova-dock-socials {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: center;
}

.inova-dock-icon {
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  text-decoration: none;
}

.inova-dock-icon:hover {
  color: #7b5454;
  transform: scale(1.15);
}

.inova-dock-divider {
  width: 18px;
  height: 1px;
  background: #e0e0e0;
  margin: 2px 0;
}

.inova-dock-badge {
  writing-mode: vertical-rl;
  font-family: 'Jost', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #1a1a1a;
  text-decoration: none;
  padding: 6px 0;
  white-space: nowrap;
  transition: color 0.25s ease;
}

.inova-dock-badge:hover {
  color: #7b5454;
}

/* Slide Content (Bottom Row) */
.inova-slide-content {
  position: absolute;
  bottom: 80px;
  left: 0;
  width: 100%;
  padding: 0 60px;
  z-index: 10;
  box-sizing: border-box;
}

.inova-content-row {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
}

.inova-content-left {
  max-width: 800px;
}

.inova-slide-heading {
  font-family: 'Jost', sans-serif;
  font-size: clamp(22px, 3.4vw, 44px);
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: #ffffff !important;
  margin: 0;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
}

.inova-content-right {
  flex-shrink: 0;
}

.inova-hero-pill-btn {
  background: #ffffff;
  color: #1a1a1a !important;
  border-radius: 50px;
  padding: 15px 36px;
  font-family: 'Jost', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

.inova-hero-pill-btn:hover {
  background: #1a1a1a;
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
}

/* Bottom Controls (Arrows & Dots) */
.inova-bottom-controls {
  position: absolute;
  bottom: 24px;
  left: 0;
  width: 100%;
  padding: 0 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 15;
  box-sizing: border-box;
}

.inova-nav-btn {
  background: transparent;
  border: none;
  color: #ffffff;
  cursor: pointer;
  padding: 6px;
  opacity: 0.85;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
}

.inova-nav-btn:hover {
  opacity: 1;
  transform: scale(1.1);
}

.inova-dots-bar {
  display: flex;
  align-items: center;
  gap: 14px;
}

.inova-dot-btn {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  border: none;
  cursor: pointer;
  padding: 0;
  box-shadow: none;
  transition: all 0.3s ease;
}

.inova-dot-btn--active {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: transparent;
  border: 1.8px solid #ffffff;
  transform: none;
  box-shadow: none;
}

/* Full slide tap link */
.inova-slide-tap-link {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 6;
  text-decoration: none;
  background: transparent;
}
@media (min-width: 768px) {
  .inova-mobile-only {
    display: none !important;
  }
  .inova-desktop-only {
    display: block !important;
  }
  .inova-slide-tap-link--mobile-only {
    display: none !important;
  }

  /* Lock to exact user desktop banner size: 1024 x 473 (aspect-ratio 1024/473) */
  .inova-slideshow-wrapper,
  .inova-slideshow-wrapper.desktop-height--banner_ratio {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 1024 / 473 !important;
    position: relative !important;
    overflow: hidden !important;
  }

  @supports not (aspect-ratio: 1024 / 473) {
    .inova-slideshow-wrapper,
    .inova-slideshow-wrapper.desktop-height--banner_ratio {
      height: 0 !important;
      padding-top: 46.1914% !important; /* 473 / 1024 * 100% */
    }
  }

  .inova-slideshow-wrapper.desktop-height--fullscreen {
    height: 100vh !important;
    height: 100svh !important;
    height: 100dvh !important;
    min-height: 560px !important;
    max-height: 100vh !important;
    aspect-ratio: auto !important;
    padding-top: 0 !important;
  }

  .inova-slideshow-wrapper.desktop-height--custom {
    height: var(--desktop-height, 600px) !important;
    min-height: 300px !important;
    aspect-ratio: auto !important;
    padding-top: 0 !important;
  }

  /* Prevent zoom crop on desktop banner ratio */
  .desktop-height--banner_ratio .inova-media-element,
  .desktop-height--banner_ratio .inova-media-picture img,
  .desktop-height--banner_ratio .inova-slide-media img,
  .desktop-height--banner_ratio .inova-slide-media video {
    transform: none !important;
    transition: none !important;
  }

  /* Desktop visibility toggles */
  .desktop-overlay-hidden {
    display: none !important;
  }
  .desktop-scrim-hidden {
    display: none !important;
  }

  /* Cursor pointer for desktop slide tap link */
  .inova-slide-tap-link {
    cursor: pointer !important;
  }
}

/* ==========================================================================
   MOBILE SCREEN PERFECTION (EXACT 656 x 1024 BANNER SIZE)
   ========================================================================== */
@media (max-width: 767px) {
  /* Lock to exact user mobile banner size: 656 x 1024 (aspect-ratio 41:64) */
  .inova-slideshow-wrapper,
  .inova-slideshow-wrapper.mobile-height--banner_ratio {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: 656 / 1024 !important;
    position: relative !important;
    overflow: hidden !important;
  }

  @supports not (aspect-ratio: 656 / 1024) {
    .inova-slideshow-wrapper,
    .inova-slideshow-wrapper.mobile-height--banner_ratio {
      height: 0 !important;
      padding-top: 156.09756% !important;
    }
  }

  .inova-slideshow-wrapper.mobile-height--fullscreen {
    height: 100vh !important;
    height: 100svh !important;
    height: 100dvh !important;
    min-height: 560px !important;
    max-height: 100vh !important;
    aspect-ratio: auto !important;
    padding-top: 0 !important;
  }

  /* Prevent any mobile scale or distortion on images/videos */
  .inova-media-element,
  .inova-media-picture img,
  .inova-slide-media img,
  .inova-slide-media video {
    transform: none !important;
    transition: none !important;
  }

  /* Mobile visibility toggles */
  .mobile-overlay-hidden {
    display: none !important;
  }
  .mobile-watermark-hidden {
    display: none !important;
  }
  .mobile-dock-hidden {
    display: none !important;
  }
  .mobile-scrim-hidden {
    display: none !important;
  }
  .inova-desktop-only {
    display: none !important;
  }
  .inova-mobile-only {
    display: block !important;
  }

  /* Center Brand Letters on Mobile ("I N O V A") */
  .inova-brand-watermark {
    top: 48% !important;
    width: 95% !important;
  }

  .inova-brand-watermark span {
    font-size: clamp(48px, 15vw, 76px) !important;
    letter-spacing: clamp(14px, 4vw, 24px) !important;
    text-indent: clamp(14px, 4vw, 24px) !important;
  }

  /* Left Floating Pill Badge on Mobile ("GET 20% OFF") */
  .inova-floating-dock {
    display: flex !important;
    position: absolute !important;
    left: 14px !important;
    bottom: 240px !important;
    top: auto !important;
    transform: none !important;
    background: rgba(235, 230, 224, 0.92) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    border-radius: 30px !important;
    padding: 14px 6px !important;
    gap: 0 !important;
    z-index: 25 !important;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18) !important;
    border: 1px solid rgba(255, 255, 255, 0.5) !important;
  }

  /* Hide social icons inside the pill on mobile so ONLY the clean vertical "GET 20% OFF" badge is shown */
  .inova-dock-socials,
  .inova-dock-divider {
    display: none !important;
  }

  .inova-dock-badge {
    font-size: 9px !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px !important;
    color: #1a1a1a !important;
    padding: 4px 0 !important;
  }

  /* Bottom Content on Mobile */
  .inova-slide-content {
    position: absolute !important;
    bottom: 48px !important;
    left: 0 !important;
    width: 100% !important;
    padding: 0 18px !important;
    box-sizing: border-box !important;
    z-index: 10 !important;
  }

  .inova-content-row {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 16px !important;
    width: 100% !important;
  }

  .inova-content-left {
    max-width: 100% !important;
  }

  .inova-slide-heading {
    font-family: 'Jost', sans-serif !important;
    font-size: clamp(24px, 6.8vw, 32px) !important;
    font-weight: 500 !important;
    line-height: 1.18 !important;
    letter-spacing: -0.01em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin: 0 !important;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45) !important;
  }

  .inova-content-right {
    width: 100% !important;
  }

  /* Full-Width Pill Button on Mobile (Matching media_1789844803288.png) */
  .inova-hero-pill-btn {
    width: 100% !important;
    box-sizing: border-box !important;
    background: #ffffff !important;
    color: #1a1a1a !important;
    border-radius: 50px !important;
    padding: 16px 20px !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 1.5px !important;
    text-align: center !important;
    text-transform: uppercase !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
  }

  /* Bottom Controls: Dots at Bottom Left (Matching media_1789844803288.png) */
  .inova-bottom-controls {
    position: absolute !important;
    bottom: 16px !important;
    left: 0 !important;
    width: 100% !important;
    padding: 0 18px !important;
    display: flex !important;
    justify-content: flex-start !important;
    box-sizing: border-box !important;
    z-index: 15 !important;
  }

  /* Hide arrows on mobile for clean look matching user screenshot */
  .inova-nav-btn {
    display: none !important;
  }

  .inova-dots-bar {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
  }

  /* Inactive dots: solid white circles */
  .inova-dot-btn {
    width: 5px !important;
    height: 5px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.85) !important;
    border: none !important;
    padding: 0 !important;
    box-shadow: none !important;
    transition: all 0.3s ease !important;
  }

  /* Active dot: hollow ring circle (matching screenshot ○) */
  .inova-dot-btn--active {
    width: 9px !important;
    height: 9px !important;
    border-radius: 50% !important;
    background: transparent !important;
    border: 1.8px solid #ffffff !important;
    transform: none !important;
    box-shadow: none !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var wrapper = document.getElementById('inova-slideshow-{{ section.id }}');
  if (!wrapper) return;

  var slides = wrapper.querySelectorAll('.inova-slide');
  var dots = wrapper.querySelectorAll('.inova-dot-btn');
  var prevBtn = wrapper.querySelector('.inova-nav-prev');
  var nextBtn = wrapper.querySelector('.inova-nav-next');
  var count = slides.length;
  if (count <= 1) return;

  var currentIndex = 0;
  var isAutoplay = wrapper.getAttribute('data-autoplay') === 'true';
  var intervalTime = parseInt(wrapper.getAttribute('data-autoplay-speed') || '5', 10) * 1000;
  var timer = null;

  function goToSlide(index) {
    if (index < 0) index = count - 1;
    if (index >= count) index = 0;
    currentIndex = index;

    slides.forEach(function(slide, idx) {
      if (idx === currentIndex) {
        slide.classList.add('inova-slide--active');
        var vid = slide.querySelector('video');
        if (vid) vid.play().catch(function(){});
      } else {
        slide.classList.remove('inova-slide--active');
      }
    });

    dots.forEach(function(dot, idx) {
      if (idx === currentIndex) {
        dot.classList.add('inova-dot-btn--active');
        dot.setAttribute('aria-selected', 'true');
      } else {
        dot.classList.remove('inova-dot-btn--active');
        dot.setAttribute('aria-selected', 'false');
      }
    });
  }

  function startTimer() {
    if (!isAutoplay) return;
    stopTimer();
    timer = setInterval(function() {
      goToSlide(currentIndex + 1);
    }, intervalTime);
  }

  function stopTimer() {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function() {
      goToSlide(currentIndex - 1);
      startTimer();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      goToSlide(currentIndex + 1);
      startTimer();
    });
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
      goToSlide(idx);
      startTimer();
    });
  });

  wrapper.addEventListener('mouseenter', stopTimer);
  wrapper.addEventListener('mouseleave', startTimer);

  // Touch Swipe Handling for Mobile
  var touchStartX = 0;
  var touchEndX = 0;
  wrapper.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  wrapper.addEventListener('touchend', function(e) {
    touchEndX = e.changedTouches[0].screenX;
    var diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 40) {
      if (diff > 0) {
        goToSlide(currentIndex + 1);
      } else {
        goToSlide(currentIndex - 1);
      }
      startTimer();
    }
  }, { passive: true });

  startTimer();
});
</script>
{%- endif -%}

