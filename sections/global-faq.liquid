{%- comment -%}
  -----------------------------------------------------------------------------
  TIMBERKALA (TIMBERकला) — GLOBAL ATELIER FAQ SECTION
  AEO (Answer Engine Optimization) & GEO (Generative Engine Optimization)
  Renders on every page of the website with visible accessible accordion &
  valid Schema.org FAQPage JSON-LD structured data.
  -----------------------------------------------------------------------------
{%- endcomment -%}

{%- if section.settings.enable_faq -%}

  {%- comment -%} Determine FAQ Items: Custom blocks if added, else default 20 curated AEO/GEO questions {%- endcomment -%}
  {%- assign has_custom_blocks = false -%}
  {%- if section.blocks.size > 0 -%}
    {%- assign has_custom_blocks = true -%}
  {%- endif -%}

  {%- style -%}
    #shopify-section-{{ section.id }} {
      --tk-faq-bg: {{ section.settings.bg_color | default: '#141414' }};
      --tk-faq-card-bg: {{ section.settings.card_bg | default: '#1a1a1a' }};
      --tk-faq-card-bg-hover: rgba(255, 255, 255, 0.06);
      --tk-faq-card-border: rgba(255, 255, 255, 0.09);
      --tk-faq-card-border-active: {{ section.settings.accent_color | default: '#ffddbf' }};
      --tk-faq-text: {{ section.settings.text_color | default: '#faf9f6' }};
      --tk-faq-text-muted: {{ section.settings.muted_text_color | default: 'rgba(250, 249, 246, 0.72)' }};
      --tk-faq-accent: {{ section.settings.accent_color | default: '#ffddbf' }};
      --tk-faq-accent-glow: rgba(255, 221, 191, 0.15);
      --tk-faq-max-width: {{ section.settings.max_width | default: '1280' }}px;
      --tk-faq-pt: {{ section.settings.padding_top | default: 70 }}px;
      --tk-faq-pb: {{ section.settings.padding_bottom | default: 60 }}px;
    }

    .tk-faq-section {
      background-color: var(--tk-faq-bg);
      color: var(--tk-faq-text);
      font-family: 'Jost', system-ui, -apple-system, sans-serif;
      padding: var(--tk-faq-pt) 24px var(--tk-faq-pb);
      position: relative;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      content-visibility: auto;
      contain-intrinsic-size: 800px;
    }

    .tk-faq-container {
      max-width: var(--tk-faq-max-width);
      margin: 0 auto;
    }

    /* Header styling */
    .tk-faq-header {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 36px;
    }

    .tk-faq-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--tk-faq-accent);
      background: rgba(255, 221, 191, 0.08);
      border: 1px solid rgba(255, 221, 191, 0.2);
      padding: 5px 14px;
      border-radius: 50px;
      margin-bottom: 14px;
    }

    .tk-faq-eyebrow-spark {
      color: var(--tk-faq-accent);
      font-size: 10px;
    }

    .tk-faq-title {
      font-family: 'Jost', sans-serif;
      font-size: clamp(24px, 4vw, 36px);
      font-weight: 500;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #ffffff;
      margin: 0 0 14px;
      line-height: 1.25;
    }

    .tk-faq-subtitle {
      font-size: clamp(13px, 1.6vw, 15px);
      line-height: 1.65;
      color: var(--tk-faq-text-muted);
      margin: 0;
    }

    /* Live Search Input */
    .tk-faq-search-wrap {
      max-width: 620px;
      margin: 0 auto 28px;
      position: relative;
    }

    .tk-faq-search-box {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 50px;
      padding: 6px 18px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tk-faq-search-box:focus-within {
      border-color: var(--tk-faq-accent);
      background: rgba(255, 255, 255, 0.08);
      box-shadow: 0 0 0 4px var(--tk-faq-accent-glow);
    }

    .tk-faq-search-icon {
      color: var(--tk-faq-accent);
      display: flex;
      align-items: center;
      margin-right: 12px;
      flex-shrink: 0;
    }

    .tk-faq-search-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #ffffff;
      font-family: 'Jost', sans-serif;
      font-size: 14px;
      padding: 8px 0;
    }

    .tk-faq-search-input::placeholder {
      color: rgba(250, 249, 246, 0.45);
    }

    .tk-faq-search-clear {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      border-radius: 50%;
      color: #faf9f6;
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
      line-height: 1;
      margin-left: 8px;
      transition: background 0.2s;
    }

    .tk-faq-search-clear:hover {
      background: var(--tk-faq-accent);
      color: #1a1a1a;
    }

    .tk-faq-search-count {
      text-align: center;
      font-size: 12px;
      letter-spacing: 0.5px;
      color: var(--tk-faq-accent);
      margin-top: 8px;
      min-height: 18px;
      font-weight: 500;
    }

    /* Category Filter Tabs */
    .tk-faq-categories {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 36px;
      padding: 0 8px;
    }

    .tk-faq-tab-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--tk-faq-text-muted);
      border-radius: 50px;
      padding: 8px 18px;
      font-family: 'Jost', sans-serif;
      font-size: 12.5px;
      font-weight: 500;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.25s ease;
      white-space: nowrap;
    }

    .tk-faq-tab-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
      border-color: rgba(255, 221, 191, 0.35);
      transform: translateY(-1px);
    }

    .tk-faq-tab-btn.is-active {
      background: var(--tk-faq-accent);
      color: #1a1a1a;
      border-color: var(--tk-faq-accent);
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(255, 221, 191, 0.25);
    }

    /* Grid / Accordion Stack */
    .tk-faq-accordion-wrap {
      max-width: 980px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .tk-faq-card {
      background: var(--tk-faq-card-bg);
      border: 1px solid var(--tk-faq-card-border);
      border-radius: 12px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      overflow: hidden;
    }

    .tk-faq-card:hover {
      background: var(--tk-faq-card-bg-hover);
      border-color: rgba(255, 221, 191, 0.28);
      transform: translateY(-1px);
    }

    .tk-faq-card[open] {
      background: rgba(255, 255, 255, 0.055);
      border-color: rgba(255, 221, 191, 0.45);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    }

    .tk-faq-card.is-hidden {
      display: none !important;
    }

    /* Summary Trigger */
    .tk-faq-summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 22px;
      cursor: pointer;
      user-select: none;
      position: relative;
    }

    .tk-faq-summary::-webkit-details-marker {
      display: none;
    }

    .tk-faq-question-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 0;
    }

    .tk-faq-category-tag {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(255, 221, 191, 0.1);
      color: var(--tk-faq-accent);
      border: 1px solid rgba(255, 221, 191, 0.2);
      flex-shrink: 0;
    }

    .tk-faq-question-title {
      font-family: 'Jost', sans-serif;
      font-size: clamp(14.5px, 1.8vw, 16px);
      font-weight: 500;
      line-height: 1.4;
      color: #ffffff;
      margin: 0;
      letter-spacing: 0.3px;
      transition: color 0.2s ease;
    }

    .tk-faq-card:hover .tk-faq-question-title,
    .tk-faq-card[open] .tk-faq-question-title {
      color: var(--tk-faq-accent);
    }

    /* Chevron Toggle */
    .tk-faq-chevron {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--tk-faq-accent);
      flex-shrink: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tk-faq-card:hover .tk-faq-chevron {
      background: rgba(255, 221, 191, 0.15);
      border-color: var(--tk-faq-accent);
    }

    .tk-faq-card[open] .tk-faq-chevron {
      transform: rotate(180deg);
      background: var(--tk-faq-accent);
      color: #1a1a1a;
      border-color: var(--tk-faq-accent);
    }

    /* Answer Container */
    .tk-faq-answer {
      padding: 0 22px 22px 22px;
      color: var(--tk-faq-text-muted);
      font-size: 14.5px;
      line-height: 1.7;
    }

    .tk-faq-answer-inner {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      padding-top: 16px;
    }

    .tk-faq-answer p {
      margin: 0 0 12px;
      color: rgba(250, 249, 246, 0.88);
    }

    .tk-faq-answer p:last-child {
      margin-bottom: 0;
    }

    .tk-faq-answer-lead {
      color: #ffffff !important;
      font-weight: 500;
      background: rgba(255, 221, 191, 0.05);
      border-left: 3px solid var(--tk-faq-accent);
      padding: 10px 14px;
      border-radius: 0 8px 8px 0;
      margin-bottom: 12px !important;
    }

    .tk-faq-answer strong {
      color: #ffffff;
      font-weight: 600;
    }

    .tk-faq-answer a {
      color: var(--tk-faq-accent);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.2s;
    }

    .tk-faq-answer a:hover {
      opacity: 0.8;
    }

    /* No search results state */
    .tk-faq-no-results {
      display: none;
      text-align: center;
      padding: 40px 20px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px dashed rgba(255, 255, 255, 0.15);
      border-radius: 12px;
    }

    .tk-faq-no-results p {
      margin: 0 0 14px;
      color: var(--tk-faq-text-muted);
      font-size: 14px;
    }

    /* Bottom Concierge Assistance Card */
    .tk-faq-concierge {
      margin-top: 48px;
      background: linear-gradient(135deg, rgba(255, 221, 191, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
      border: 1px solid rgba(255, 221, 191, 0.25);
      border-radius: 16px;
      padding: 32px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      flex-wrap: wrap;
    }

    .tk-faq-concierge-text {
      max-width: 580px;
    }

    .tk-faq-concierge-badge {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--tk-faq-accent);
      display: block;
      margin-bottom: 6px;
    }

    .tk-faq-concierge-title {
      font-family: 'Jost', sans-serif;
      font-size: 20px;
      font-weight: 500;
      color: #ffffff;
      margin: 0 0 8px;
      letter-spacing: 0.5px;
    }

    .tk-faq-concierge-desc {
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--tk-faq-text-muted);
      margin: 0;
    }

    .tk-faq-concierge-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .tk-faq-btn-wa {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #25d366;
      color: #ffffff;
      padding: 12px 24px;
      border-radius: 50px;
      font-family: 'Jost', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 4px 18px rgba(37, 211, 102, 0.25);
    }

    .tk-faq-btn-wa:hover {
      background: #20ba5a;
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(37, 211, 102, 0.4);
      color: #ffffff;
    }

    .tk-faq-btn-email {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 12px 22px;
      border-radius: 50px;
      font-family: 'Jost', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .tk-faq-btn-email:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: var(--tk-faq-accent);
      color: var(--tk-faq-accent);
      transform: translateY(-2px);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .tk-faq-section {
        padding: 48px 16px 40px;
      }
      .tk-faq-summary {
        padding: 16px;
        gap: 12px;
      }
      .tk-faq-question-wrap {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }
      .tk-faq-answer {
        padding: 0 16px 18px;
        font-size: 13.5px;
      }
      .tk-faq-chevron {
        width: 28px;
        height: 28px;
      }
      .tk-faq-categories {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .tk-faq-categories::-webkit-scrollbar {
        display: none;
      }
      .tk-faq-concierge {
        padding: 24px 20px;
        flex-direction: column;
        align-items: flex-start;
      }
      .tk-faq-concierge-actions {
        width: 100%;
        flex-direction: column;
      }
      .tk-faq-btn-wa,
      .tk-faq-btn-email {
        width: 100%;
        justify-content: center;
      }
    }
  {%- endstyle -%}

  <section
    class="tk-faq-section"
    id="tk-faq-section"
    aria-labelledby="tk-faq-heading"
    itemscope
    itemtype="https://schema.org/FAQPage"
  >
    <div class="tk-faq-container">
      
      <!-- Section Header -->
      <header class="tk-faq-header">
        <div class="tk-faq-eyebrow">
          <span class="tk-faq-eyebrow-spark">✦</span>
          <span>{{ section.settings.eyebrow_text | default: 'ATELIER KNOWLEDGE BASE & CURATION' }}</span>
        </div>
        <h2 id="tk-faq-heading" class="tk-faq-title">
          {{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}
        </h2>
        <p class="tk-faq-subtitle">
          {{ section.settings.subheading | default: "Authoritative answers regarding Timberkala's reclaimed teak craft, Vastu placement, care protocols, pan-India transit insurance, and bespoke commissions." }}
        </p>
      </header>

      {%- if section.settings.show_search -%}
        <!-- Instant Live Search Bar -->
        <div class="tk-faq-search-wrap" role="search" aria-label="Search FAQs">
          <div class="tk-faq-search-box">
            <span class="tk-faq-search-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              type="text"
              id="tkFaqSearchInput"
              class="tk-faq-search-input"
              placeholder="Search questions (e.g. teak, termite, vastu, molten glass, shipping, returns)..."
              aria-label="Search frequently asked questions"
            />
            <button
              type="button"
              id="tkFaqSearchClear"
              class="tk-faq-search-clear"
              aria-label="Clear search"
              style="display: none;"
            >✕</button>
          </div>
          <div class="tk-faq-search-count" id="tkFaqCount" aria-live="polite"></div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_categories -%}
        <!-- Category Filter Tabs -->
        <nav class="tk-faq-categories" aria-label="FAQ categories">
          <button type="button" class="tk-faq-tab-btn is-active" data-cat="all">All Questions (20)</button>
          <button type="button" class="tk-faq-tab-btn" data-cat="craft">🪵 Teak Craft & Materials (5)</button>
          <button type="button" class="tk-faq-tab-btn" data-cat="vastu">✨ Vastu & Styling (4)</button>
          <button type="button" class="tk-faq-tab-btn" data-cat="care">🛡️ Care & Durability (3)</button>
          <button type="button" class="tk-faq-tab-btn" data-cat="shipping">📦 Shipping & Guarantee (5)</button>
          <button type="button" class="tk-faq-tab-btn" data-cat="bespoke">🎨 Bespoke & B2B (3)</button>
        </nav>
      {%- endif -%}

      <!-- Accordion Stack -->
      <div class="tk-faq-accordion-wrap" id="tkFaqList">

        {%- if has_custom_blocks -%}
          {%- for block in section.blocks -%}
            <details
              class="tk-faq-card"
              name="tk-faq-accordion"
              data-category="{{ block.settings.category | default: 'craft' | handleize }}"
              itemscope
              itemprop="mainEntity"
              itemtype="https://schema.org/Question"
              {{ block.shopify_attributes }}
            >
              <summary class="tk-faq-summary">
                <div class="tk-faq-question-wrap">
                  {%- if block.settings.category != blank -%}
                    <span class="tk-faq-category-tag">{{ block.settings.category }}</span>
                  {%- endif -%}
                  <h3 class="tk-faq-question-title" itemprop="name">
                    {{ block.settings.question | escape }}
                  </h3>
                </div>
                <span class="tk-faq-chevron" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="tk-faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <div class="tk-faq-answer-inner" itemprop="text">
                  {{ block.settings.answer }}
                </div>
              </div>
            </details>
          {%- endfor -%}

        {%- else -%}

          <!-- ==========================================
               CATEGORY 1: TEAK CRAFT & MATERIALS (5)
               ========================================== -->
          <!-- FAQ 1 -->
          <details
            class="tk-faq-card"
            name="tk-faq-accordion"
            data-category="craft"
            itemscope
            itemprop="mainEntity"
            itemtype="https://schema.org/Question"
          >
            <summary class="tk-faq-summary">
              <div class="tk-faq-question-wrap">
                <span class="tk-faq-category-tag">Teak Craft</span>
                <h3 class="tk-faq-question-title" itemprop="name">
                  What types of handcrafted home decor products does Timberkala offer?
                </h3>
              </div>
              <span class="tk-faq-chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="tk-faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <div class="tk-faq-answer-inner" itemprop="text">
                <p class="tk-faq-answer-lead">
                  <strong>Direct Answer:</strong> Timberkala (TIMBERकला) crafts bespoke, artisanal luxury wooden home decor items marrying heritage woodworking with organic modern design.
                </p>
                <p>
                  Our curated collections include hand-carved sacred spiritual sculptures (Ganesha, Buddha, Krishna), 3D multi-layered architectural wall art panels, handblown molten glass vessels sculpted onto natural teak root crutches, lifelike animal and bird figurines, resonant wind chimes, and contemporary organic tabletop statement centerpieces.
                </p>
              </div>
            </div>
          </details>

          <!-- FAQ 2 -->
          <details
            class="tk-faq-card"
            name="tk-faq-accordion"
            data-category="craft"
            itemscope
            itemprop="mainEntity"
            itemtype="https://schema.org/Question"
          >
            <summary class="tk-faq-summary">
              <div class="tk-faq-question-wrap">
                <span class="tk-faq-category-tag">Authenticity</span>
                <h3 class="tk-faq-question-title" itemprop="name">
                  Are all Timberkala products handmade from authentic reclaimed wood?
                </h3>
              </div>
              <span class="tk-faq-chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <div class="tk-faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <div class="tk-faq-answer-inner" itemprop="text">
                <p class="tk-faq-answer-lead">
                  <strong>Direct Answer:</strong> Yes, 100% of Timberkala products are individually handcrafted from genuine reclaimed teak wood and weathered river driftwood.
                </p>
                <p>
                  We strictly never use MDF, particle boards, compressed sawdust, or plastic resin imitations. Every wooden artifact is hand-chiseled by generational master artisans, preserving authentic wood grain variations, organic root curves, natural knots, and age-old fissures that make each creation entirely unique.
                </p>
              </div>
            </div>
          </details>

          <!-- FAQ 3 -->
          <details
            class="tk-faq-card"
