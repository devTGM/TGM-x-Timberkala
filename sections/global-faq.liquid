{%- comment -%}
  -----------------------------------------------------------------------------
  TIMBERKALA (TIMBERकला) — LUXURY ATELIER FAQ SECTION
  Architectural Digest / Editorial Luxury Design
  AEO (Answer Engine Optimization) & GEO (Generative Engine Optimization)
  Renders on every page of the website with visible accessible accordion &
  valid Schema.org FAQPage JSON-LD structured data.
  -----------------------------------------------------------------------------
{%- endcomment -%}

{%- if section.settings.enable_faq -%}

  {%- assign has_custom_blocks = false -%}
  {%- if section.blocks.size > 0 -%}
    {%- assign has_custom_blocks = true -%}
  {%- endif -%}

  {%- style -%}
    #shopify-section-{{ section.id }} {
      --tk-faq-bg: {{ section.settings.bg_color | default: '#fbf9f5' }};
      --tk-faq-card-bg: {{ section.settings.card_bg | default: '#ffffff' }};
      --tk-faq-card-border: {{ section.settings.border_color | default: '#e8e4dc' }};
      --tk-faq-text: {{ section.settings.text_color | default: '#1a1a1a' }};
      --tk-faq-text-muted: #5e5a52;
      --tk-faq-accent: {{ section.settings.accent_color | default: '#7b5454' }};
      --tk-faq-accent-warm: #8c5e3c;
      --tk-faq-pill-bg: #f2ede4;
      --tk-faq-pill-border: #e2ddd3;
      --tk-faq-max-width: {{ section.settings.max_width | default: '1360' }}px;
      --tk-faq-pt: {{ section.settings.padding_top | default: 80 }}px;
      --tk-faq-pb: {{ section.settings.padding_bottom | default: 90 }}px;
    }

    .tk-faq-section {
      background-color: var(--tk-faq-bg);
      color: var(--tk-faq-text);
      font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding: var(--tk-faq-pt) 32px var(--tk-faq-pb);
      position: relative;
      border-top: 1px solid var(--tk-faq-card-border);
    }

    .tk-faq-container {
      max-width: var(--tk-faq-max-width);
      margin: 0 auto;
    }

    /* Two-Column Editorial Layout on Desktop */
    .tk-faq-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    @media (min-width: 990px) {
      .tk-faq-grid {
        grid-template-columns: 400px 1fr;
        gap: 72px;
        align-items: start;
      }
      .tk-faq-sidebar {
        position: sticky;
        top: 110px;
      }
    }

    /* Left Sidebar: Header & Controls */
    .tk-faq-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 2.2px;
      text-transform: uppercase;
      color: var(--tk-faq-accent);
      margin-bottom: 14px;
    }

    .tk-faq-eyebrow-line {
      width: 24px;
      height: 1px;
      background: var(--tk-faq-accent);
      display: inline-block;
    }

    .tk-faq-title {
      font-family: 'Jost', sans-serif;
      font-size: clamp(28px, 3.2vw, 42px);
      font-weight: 400;
      letter-spacing: -0.5px;
      text-transform: uppercase;
      color: var(--tk-faq-text);
      margin: 0 0 16px;
      line-height: 1.15;
    }

    .tk-faq-subtitle {
      font-size: 14.5px;
      line-height: 1.7;
      color: var(--tk-faq-text-muted);
      margin: 0 0 28px;
      font-weight: 400;
    }

    /* Refined Search Box */
    .tk-faq-search-box {
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 1px solid #dcd7ce;
      border-radius: 8px;
      padding: 6px 16px;
      margin-bottom: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      transition: all 0.25s ease;
    }

    .tk-faq-search-box:focus-within {
      border-color: var(--tk-faq-accent);
      box-shadow: 0 0 0 3px rgba(123, 84, 84, 0.12);
    }

    .tk-faq-search-icon {
      color: var(--tk-faq-accent);
      display: flex;
      align-items: center;
      margin-right: 10px;
      flex-shrink: 0;
    }

    .tk-faq-search-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #1a1a1a;
      font-family: 'Jost', sans-serif;
      font-size: 13.5px;
      padding: 8px 0;
    }

    .tk-faq-search-input::placeholder {
      color: #9c978f;
    }

    .tk-faq-search-clear {
      background: #eeebe3;
      border: none;
      border-radius: 50%;
      color: #555;
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 11px;
      line-height: 1;
      margin-left: 6px;
      transition: background 0.2s;
    }

    .tk-faq-search-clear:hover {
      background: var(--tk-faq-accent);
      color: #ffffff;
    }

    .tk-faq-search-count {
      font-size: 12px;
      letter-spacing: 0.5px;
      color: var(--tk-faq-accent);
      margin-bottom: 18px;
      min-height: 18px;
      font-weight: 500;
    }

    /* Category Filter List */
    .tk-faq-categories {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 32px;
    }

    @media (min-width: 990px) {
      .tk-faq-categories {
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
      }
    }

    .tk-faq-tab-btn {
      background: var(--tk-faq-pill-bg);
      border: 1px solid var(--tk-faq-pill-border);
      color: #524f49;
      border-radius: 6px;
      padding: 10px 16px;
      font-family: 'Jost', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: all 0.22s ease;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .tk-faq-tab-btn:hover {
      background: #eae4d8;
      color: #1a1a1a;
      border-color: #d8d0c2;
    }

    .tk-faq-tab-btn.is-active {
      background: #1a1a1a;
      color: #ffffff;
      border-color: #1a1a1a;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    /* Concierge Card in Sidebar */
    .tk-faq-concierge-card {
      background: #f4eee4;
      border: 1px solid #e2ddd3;
      border-radius: 10px;
      padding: 24px;
      margin-top: 12px;
    }

    .tk-faq-concierge-badge {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      color: var(--tk-faq-accent);
      display: block;
      margin-bottom: 6px;
    }

    .tk-faq-concierge-title {
      font-family: 'Jost', sans-serif;
      font-size: 17px;
      font-weight: 500;
      color: #1a1a1a;
      margin: 0 0 6px;
      letter-spacing: 0.2px;
    }

    .tk-faq-concierge-desc {
      font-size: 13px;
      line-height: 1.6;
      color: var(--tk-faq-text-muted);
      margin: 0 0 18px;
    }

    .tk-faq-concierge-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .tk-faq-btn-wa {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #1a1a1a;
      color: #ffffff;
      padding: 12px 18px;
      border-radius: 6px;
      font-family: 'Jost', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .tk-faq-btn-wa:hover {
      background: #7b5454;
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(123, 84, 84, 0.25);
    }

    .tk-faq-btn-email {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: transparent;
      color: #1a1a1a;
      border: 1px solid #ccc5b8;
      padding: 10px 18px;
      border-radius: 6px;
      font-family: 'Jost', sans-serif;
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .tk-faq-btn-email:hover {
      background: #ffffff;
      border-color: #1a1a1a;
      color: #1a1a1a;
    }

    /* Right Column: Accordion Stack */
    .tk-faq-accordion-stack {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .tk-faq-card {
      background: transparent;
      border-bottom: 1px solid var(--tk-faq-card-border);
      transition: all 0.28s ease;
      overflow: hidden;
    }

    .tk-faq-card:first-child {
      border-top: 1px solid var(--tk-faq-card-border);
    }

    .tk-faq-card[open] {
      background: #ffffff;
      border: 1px solid var(--tk-faq-card-border);
      border-radius: 10px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
      margin: 10px 0;
      padding: 4px 6px 6px;
    }

    .tk-faq-card.is-hidden {
      display: none !important;
    }

    /* Summary Trigger */
    .tk-faq-summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 22px 12px;
      cursor: pointer;
      user-select: none;
      position: relative;
      transition: padding 0.2s ease;
    }

    .tk-faq-card[open] .tk-faq-summary {
      padding: 18px 18px 12px;
    }

    .tk-faq-summary::-webkit-details-marker {
      display: none;
    }

    .tk-faq-question-wrap {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex: 1;
      min-width: 0;
    }

    .tk-faq-index {
      font-family: 'Jost', serif;
      font-size: 13px;
      font-weight: 500;
      color: #9e978c;
      letter-spacing: 1px;
      flex-shrink: 0;
    }

    .tk-faq-category-chip {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 4px;
      background: #f0ebe1;
      color: var(--tk-faq-accent);
      flex-shrink: 0;
    }

    .tk-faq-question-title {
      font-family: 'Jost', sans-serif;
      font-size: clamp(15.5px, 1.6vw, 17.5px);
      font-weight: 450;
      line-height: 1.45;
      color: var(--tk-faq-text);
      margin: 0;
      letter-spacing: -0.1px;
      transition: color 0.2s ease;
    }

    .tk-faq-card:hover .tk-faq-question-title {
      color: var(--tk-faq-accent);
    }

    .tk-faq-card[open] .tk-faq-question-title {
      color: #1a1a1a;
      font-weight: 500;
    }

    /* Minimal Plus/Minus Indicator */
    .tk-faq-toggle-icon {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid #dcd7ce;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1a1a1a;
      flex-shrink: 0;
      transition: all 0.25s ease;
      position: relative;
    }

    .tk-faq-card:hover .tk-faq-toggle-icon {
      border-color: #1a1a1a;
      background: #1a1a1a;
      color: #ffffff;
    }

    .tk-faq-card[open] .tk-faq-toggle-icon {
      background: #1a1a1a;
      border-color: #1a1a1a;
      color: #ffffff;
      transform: rotate(45deg);
    }

    /* Answer Content */
    .tk-faq-answer {
      padding: 0 12px 24px 44px;
      color: var(--tk-faq-text-muted);
      font-size: 14.5px;
      line-height: 1.75;
    }

    .tk-faq-card[open] .tk-faq-answer {
      padding: 0 18px 18px 44px;
    }

    .tk-faq-answer p {
      margin: 0 0 12px;
      color: #4a4740;
    }

    .tk-faq-answer p:last-child {
      margin-bottom: 0;
    }

    .tk-faq-answer-lead {
      color: #1a1a1a !important;
      font-weight: 450;
      background: #f7f3eb;
      border-left: 2px solid var(--tk-faq-accent);
      padding: 10px 14px;
      border-radius: 0 6px 6px 0;
      margin-bottom: 12px !important;
    }

    .tk-faq-answer strong {
      color: #1a1a1a;
      font-weight: 600;
    }

    .tk-faq-answer a {
      color: var(--tk-faq-accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* No search results state */
    .tk-faq-no-results {
      display: none;
      text-align: center;
      padding: 48px 24px;
      background: #ffffff;
      border: 1px dashed #dcd7ce;
      border-radius: 8px;
    }

    .tk-faq-no-results p {
      margin: 0 0 16px;
      color: var(--tk-faq-text-muted);
      font-size: 14.5px;
    }

    /* Mobile Responsive */
    @media (max-width: 989px) {
      .tk-faq-section {
        padding: 56px 20px 64px;
      }
      .tk-faq-header {
        text-align: center;
      }
      .tk-faq-eyebrow {
        justify-content: center;
      }
      .tk-faq-search-box {
        margin: 0 auto 20px;
        max-width: 540px;
      }
      .tk-faq-categories {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .tk-faq-categories::-webkit-scrollbar {
        display: none;
      }
      .tk-faq-tab-btn {
        flex-shrink: 0;
      }
      .tk-faq-question-wrap {
        gap: 10px;
      }
      .tk-faq-index {
        display: none;
      }
      .tk-faq-answer {
        padding: 0 12px 18px 12px;
        font-size: 13.5px;
      }
      .tk-faq-card[open] .tk-faq-answer {
        padding: 0 14px 16px 14px;
      }
    }
  {%- endstyle -%}

  <section
    class="tk-faq-section"
    id="tk-faq-section"
    aria-labelledby="tk-faq-heading"
    itemscope
    itemtype="https://schema.org/FAQPage"
  >
    <div class="tk-faq-container">
      
      <div class="tk-faq-grid">
        
        <!-- Left Column: Editorial Overview & Controls -->
        <aside class="tk-faq-sidebar">
          
          <header class="tk-faq-header">
            <div class="tk-faq-eyebrow">
              <span class="tk-faq-eyebrow-line"></span>
              <span>{{ section.settings.eyebrow_text | default: 'TIMBERKALA ATELIER CURATION' }}</span>
            </div>
            <h2 id="tk-faq-heading" class="tk-faq-title">
              {{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}
            </h2>
            <p class="tk-faq-subtitle">
              {{ section.settings.subheading | default: "Authoritative guidance on Timberkala's reclaimed teak craft, sacred Vastu placements, organic care rituals, pan-India transit insurance, and corporate gifting." }}
            </p>
          </header>

          {%- if section.settings.show_search -%}
            <!-- Live Instant Search Bar -->
            <div class="tk-faq-search-box" role="search" aria-label="Search FAQs">
              <span class="tk-faq-search-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                type="text"
                id="tkFaqSearchInput"
                class="tk-faq-search-input"
                placeholder="Search teak, vastu, glass, shipping..."
                aria-label="Search frequently asked questions"
              />
              <button
                type="button"
                id="tkFaqSearchClear"
                class="tk-faq-search-clear"
                aria-label="Clear search"
                style="display: none;"
              >✕</button>
            </div>
            <div class="tk-faq-search-count" id="tkFaqCount" aria-live="polite"></div>
          {%- endif -%}

          {%- if section.settings.show_categories -%}
            <!-- Category Filter Tabs -->
            <nav class="tk-faq-categories" aria-label="FAQ categories">
              <button type="button" class="tk-faq-tab-btn is-active" data-cat="all">
                <span>All Inquiries</span>
                <span>(20)</span>
              </button>
              <button type="button" class="tk-faq-tab-btn" data-cat="craft">
                <span>Teak Craft & Materials</span>
                <span>(5)</span>
              </button>
              <button type="button" class="tk-faq-tab-btn" data-cat="vastu">
                <span>Vastu & Home Placement</span>
                <span>(4)</span>
              </button>
              <button type="button" class="tk-faq-tab-btn" data-cat="care">
                <span>Care & Durability</span>
                <span>(3)</span>
              </button>
              <button type="button" class="tk-faq-tab-btn" data-cat="shipping">
                <span>Transit Guarantee & Returns</span>
                <span>(5)</span>
              </button>
              <button type="button" class="tk-faq-tab-btn" data-cat="orders">
                <span>Corporate & Bulk Orders</span>
                <span>(3)</span>
              </button>
            </nav>
          {%- endif -%}

          {%- if section.settings.show_concierge -%}
            <!-- Atelier Assistance Card -->
            <div class="tk-faq-concierge-card">
              <span class="tk-faq-concierge-badge">ATELIER CONCIERGE</span>
              <h3 class="tk-faq-concierge-title">Have a space styling question?</h3>
              <p class="tk-faq-concierge-desc">
                Share photos of your wall or console table for complimentary styling advice and curated piece recommendations from our collection.
              </p>
              <div class="tk-faq-concierge-actions">
                <a
                  href="https://wa.me/919599579235?text=Hello%20Timberkala%20Atelier%2C%20I%20have%20a%20question%20regarding%20handcrafted%20decor"
                  target="_blank"
                  rel="noopener"
                  class="tk-faq-btn-wa"
                  aria-label="Chat on WhatsApp"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.52 3.48A11.93 11.93 0 0 0 12.06 0C5.45 0 .09 5.36.09 11.97c0 2.11.55 4.17 1.6 6L0 24l6.23-1.63a11.9 11.9 0 0 0 5.83 1.51h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-.12-6.22-3.52-8.43zM12.07 21.9a9.92 9.92 0 0 1-5.06-1.39l-.36-.22-3.76.99 1-3.66-.24-.38a9.9 9.9 0 0 1-1.52-5.27c0-5.48 4.46-9.94 9.95-9.94 2.66 0 5.16 1.03 7.03 2.91a9.9 9.9 0 0 1 2.91 7.04c0 5.48-4.46 9.92-9.95 9.92zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.95 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.18-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.59-.5-.51-.68-.52-.18-.01-.38-.01-.58-.01-.2 0-.53.07-.8.37-.28.3-1.07 1.05-1.07 2.56s1.1 2.97 1.25 3.17c.15.2 2.16 3.3 5.23 4.63.73.32 1.3.5 1.74.64.73.23 1.4.2 1.93.12.59-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35z"/>
                  </svg>
                  <span>Chat with Atelier</span>
                </a>
                <a
                  href="mailto:wecare@timberkala.com?subject=Timberkala%20Artisan%20Inquiry"
                  class="tk-faq-btn-email"
                >
                  <span>Email Atelier</span>
                </a>
              </div>
            </div>
          {%- endif -%}

        </aside>

        <!-- Right Column: Accordion Stack -->
        <div class="tk-faq-accordion-stack" id="tkFaqList">

          {%- if has_custom_blocks -%}
            {%- for block in section.blocks -%}
              <details
                class="tk-faq-card"
                name="tk-faq-accordion"
                data-category="{{ block.settings.category | default: 'craft' | handleize }}"
                itemscope
                itemprop="mainEntity"
                itemtype="https://schema.org/Question"
                {{ block.shopify_attributes }}
              >
                <summary class="tk-faq-summary">
                  <div class="tk-faq-question-wrap">
                    <span class="tk-faq-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                    {%- if block.settings.category != blank -%}
                      <span class="tk-faq-category-chip">{{ block.settings.category }}</span>
                    {%- endif -%}
                    <h3 class="tk-faq-question-title" itemprop="name">
                      {{ block.settings.question | escape }}
                    </h3>
                  </div>
                  <span class="tk-faq-toggle-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </span>
                </summary>
                <div class="tk-faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                  <div itemprop="text">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </details>
            {%- endfor -%}

          {%- else -%}

            <!-- ==========================================
                 CATEGORY 1: TEAK CRAFT & MATERIALS (5)
                 ========================================== -->
            <!-- 01 -->
            <details
              class="tk-faq-card"
              name="tk-faq-accordion"
              data-category="craft"
              itemscope
              itemprop="mainEntity"
              itemtype="https://schema.org/Question"
            >
