  <!-- =========================================================================
       CLIENT-SIDE SEARCH, CATEGORY FILTER, & ACCORDION BEHAVIOR
       ========================================================================= -->
  <script>
    (function() {
      function initTkFaq() {
        var section = document.getElementById('tk-faq-section');
        if (!section) return;

        var searchInput = document.getElementById('tkFaqSearchInput');
        var searchClear = document.getElementById('tkFaqSearchClear');
        var countDisplay = document.getElementById('tkFaqCount');
        var noResults = document.getElementById('tkFaqNoResults');
        var categoryBtns = section.querySelectorAll('.tk-faq-tab-btn');
        var cards = section.querySelectorAll('.tk-faq-card');
        var totalCards = cards.length;
        var activeCategory = 'all';

        function updateFilter() {
          var query = (searchInput ? searchInput.value.trim().toLowerCase() : '');
          var visibleCount = 0;

          if (searchClear) {
            searchClear.style.display = query.length > 0 ? 'inline-flex' : 'none';
          }

          cards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category') || '';
            var matchesCategory = (activeCategory === 'all' || cardCat === activeCategory);

            var textContent = (card.innerText || card.textContent || '').toLowerCase();
            var matchesQuery = (query === '' || textContent.indexOf(query) !== -1);

            if (matchesCategory && matchesQuery) {
              card.classList.remove('is-hidden');
              visibleCount++;
            } else {
              card.classList.add('is-hidden');
              if (card.hasAttribute('open')) {
                card.removeAttribute('open');
              }
            }
          });

          if (countDisplay) {
            if (query.length > 0 || activeCategory !== 'all') {
              countDisplay.textContent = 'Showing ' + visibleCount + ' of ' + totalCards + ' inquiries';
            } else {
              countDisplay.textContent = '';
            }
          }

          if (noResults) {
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
          }
        }

        if (searchInput) {
          searchInput.addEventListener('input', updateFilter);
        }

        if (searchClear) {
          searchClear.addEventListener('click', function() {
            if (searchInput) {
              searchInput.value = '';
              searchInput.focus();
            }
            updateFilter();
          });
        }

        categoryBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            categoryBtns.forEach(function(b) { b.classList.remove('is-active'); });
            btn.classList.add('is-active');
            activeCategory = btn.getAttribute('data-cat') || 'all';
            updateFilter();
          });
        });

        cards.forEach(function(card) {
          card.addEventListener('toggle', function() {
            if (card.open) {
              cards.forEach(function(otherCard) {
                if (otherCard !== card && otherCard.open) {
                  otherCard.removeAttribute('open');
                }
              });
            }
          });
        });

        if (window.location.hash === '#faq' || window.location.hash === '#tk-faq-section') {
          setTimeout(function() {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 300);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTkFaq);
      } else {
        initTkFaq();
      }
    })();
  </script>

