      "settings": {
        "custom_liquid": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shop by Department</title>\n\n  <!-- Swiper CSS -->\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" />\n\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Harmonia+Sans:wght@400;600&display=swap');\n\n    body {\n      background: #f9f8f5;\n      font-family: 'Harmonia Sans', sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n\n    .category-section-mobile {\n      padding: ;\n      background: #f9f8f5;\n    }\n\n    \n    @media (min-width: 768px) {\n      .category-section-mobile {\n        display: none;\n      }\n    }\n\n    \n    .category-heading {\n      text-align: center;\n      font-size: 20px;\n      font-weight: 600;\n      color: #1a1a1a;\n      margin-bottom: 20px;\n      letter-spacing: 1px;\n    }\n\n    \n    .circle-wrapper {\n      width: 100%;\n      padding-top: 100%;\n      position: relative;\n      border-radius: 50%;\n      overflow: hidden;\n      background: #fff;\n      border: 2px solid rgba(212,175,55,0.35);\n      box-shadow: inset 0 0 8px rgba(0,0,0,0.08), 0 6px 16px rgba(0,0,0,0.08);\n      transition: all 0.5s ease;\n    }\n\n    .circle-wrapper img {\n      position: absolute;\n      top: 0; left: 0;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      transition: transform 0.6s ease;\n      z-index: 1;\n    }\n\n    .swiper-slide:hover .circle-wrapper {\n      transform: scale(1.05);\n      border-color: #D4AF37;\n      box-shadow: 0 12px 25px rgba(0,0,0,0.12);\n    }\n\n    .swiper-slide:hover .circle-wrapper img {\n      transform: scale(1.15);\n    }\n\n    \n    .swiper-slide p {\n      margin-top: 10px;\n      font-size: 12px;\n      font-weight: 600;\n      color: #1a1a1a;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n      text-align: center;\n    }\n\n    .swiper-slide:hover p {\n      color: #D4AF37;\n    }\n\n    .category-link {\n      display: block;\n      text-decoration: none;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"category-section-mobile\">\n  \n\n  <!-- ✅ Swiper -->\n  <div class=\"swiper categorySwiper\">\n    <div class=\"swiper-wrapper\">\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/animal-figurines\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/1.webp?v=1758372894\" alt=\"Exclusive Pieces\">\n          </div>\n          <p>Exclusive Pieces</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/glass-on-wood\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/2.webp?v=1758372894\" alt=\"Glass on Wood\">\n          </div>\n          <p>Glass on Wood</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/bird-figurines\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/3.webp?v=1758372894\" alt=\"Bird Figurines\">\n          </div>\n          <p>Bird Figurines</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/animal-figurines\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/4.webp?v=1758372894\" alt=\"Animal Figurines\">\n          </div>\n          <p>Animal Figurines</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/furniture\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/5.webp?v=1758372894\" alt=\"Furniture\">\n          </div>\n          <p>Furniture</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/hangings-1\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/6.webp?v=1758372893\" alt=\"Hangings\">\n          </div>\n          <p>Hangings</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/accessories\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/7.webp?v=1758372894\" alt=\"Accessories\">\n          </div>\n          <p>Accessories</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/wind-chimes\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/8.webp?v=1758372893\" alt=\"Wind Chimes\">\n          </div>\n          <p>Wind Chimes</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/gifting\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/9.webp?v=1758372893\" alt=\"Gifting\">\n          </div>\n          <p>Gifting</p>\n        </a>\n      </div>\n\n      <div class=\"swiper-slide\">\n        <a href=\"https://www.timberkala.com/collections/sale-1\" class=\"category-link\">\n          <div class=\"circle-wrapper\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0909/3352/6833/files/10.webp?v