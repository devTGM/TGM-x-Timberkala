<script src="{{ 'search-drawer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'page-header.js' | asset_url }}" defer="defer"></script>

{% assign transparent_header_rgb = section.settings.transparent_header_color | color_to_rgb %}

{% style %}
  :root {
    --logo-width: {{ section.settings.mobile_screen_logo_width | default: 140 }}px;
    --logo-width-mobile: {{ section.settings.mobile_screen_logo_width | default: 140 }}px;
    --logo-width-desk: {{ section.settings.large_screen_logo_width | default: 220 }}px;
    --logo-max-height-desk: {{ section.settings.large_screen_logo_max_height | default: 75 }}px;
    --logo-max-height-mob: {{ section.settings.mobile_screen_logo_max_height | default: 50 }}px;
    --header-padding-y-desk: {{ section.settings.header_padding_vertical_desktop | default: 18 }}px;
    --header-padding-y-mob: {{ section.settings.header_padding_vertical_mobile | default: 12 }}px;
    --header-max-width: {{ section.settings.header_max_width | default: '1440px' }};
    --header-bg-color: {{ section.settings.header_bg_color | default: '#ffffff' }};
    --header-text-color: {{ section.settings.header_text_color | default: '#1a1a1a' }};
    --menu-hover-color: {{ section.settings.menu_hover_color | default: '#d4af37' }};
    --header-border-color: {{ section.settings.border_color | default: '#e8e5df' }};
    --menu-font-size: {{ section.settings.menu_font_size | default: 14 }}px;
    --menu-item-spacing: {{ section.settings.menu_item_spacing | default: 26 }}px;
    --menu-font-weight: {{ section.settings.menu_font_weight | default: '500' }};
    --menu-text-transform: {{ section.settings.menu_text_transform | default: 'uppercase' }};
    --menu-letter-spacing: {{ section.settings.menu_letter_spacing | default: 1 }}px;
  }

  {% if transparent_header_rgb != 'rgba(0, 0, 0, 0.0)' %}
    header[id="shopify-section-{{ section.id }}"]{
      --color-transparent-header: {{ section.settings.transparent_header_color }};
    }
  {% endif %}

  /* ==========================================================================
     PREMIUM INLINE HEADER STYLES (Logo Left, Menu Center, Actions Right)
     ========================================================================== */
  .wt-header--inline {
    background-color: var(--header-bg-color, #ffffff) !important;
    color: var(--header-text-color, #1a1a1a) !important;
    position: relative !important;
    width: 100% !important;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
  }

  .wt-header--inline.wt-header--separator {
    border-bottom: 1px solid var(--header-border-color, #e8e5df) !important;
  }

  .wt-header--inline.wt-header--shadow {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06) !important;
  }

  .wt-header__body--inline {
    max-width: var(--header-max-width, 1440px) !important;
    margin: 0 auto !important;
    padding: var(--header-padding-y-mob, 12px) calc(var(--gap, 8px) * 2) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: relative !important;
    width: 100% !important;
    box-sizing: border-box !important;
    transition: padding 0.3s ease !important;
  }

  @media (min-width: 990px) {
    .wt-header__body--inline {
      padding: var(--header-padding-y-desk, 18px) calc(var(--gap, 8px) * 3) !important;
      display: grid !important;
      grid-template-columns: auto 1fr auto !important;
      align-items: center !important;
      gap: calc(var(--gap, 8px) * 3) !important;
    }
  }

  /* ---------------- Left Column: Logo & Mobile Hamburger ---------------- */
  .wt-header__col--left {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: calc(var(--gap, 8px) * 1.5) !important;
    z-index: 10 !important;
  }

  .wt-header__col--left .wt-header__menu-trigger {
    display: flex !important;
    align-items: center !important;
    color: inherit !important;
    margin-right: 0 !important;
    cursor: pointer !important;
    text-decoration: none !important;
    z-index: 15 !important;
    position: relative !important;
  }

  @media (min-width: 990px) {
    body:not(.mobile-nav) .wt-header__col--left .wt-header__menu-trigger {
      display: none !important;
    }
  }

  /* Mobile View (< 990px): Logo Centered in Header */
  @media (max-width: 989px) {
    .wt-header__col--left .wt-header__logo {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      max-width: calc(100% - 150px) !important;
      z-index: 5 !important;
      text-align: center !important;
    }

    .wt-header__col--left .wt-header__logo__link {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      margin: 0 auto !important;
      width: var(--logo-width-mobile, 140px) !important;
      max-width: 100% !important;
      min-height: auto !important;
      text-decoration: none !important;
      color: inherit !important;
    }

    .wt-header__col--left .wt-header__logo__img--mobile {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      max-height: var(--logo-max-height-mob, 50px) !important;
      object-fit: contain !important;
      object-position: center !important;
      margin: 0 auto !important;
    }

    .wt-header__col--left .wt-header__logo__img {
      display: none !important;
    }
  }

  /* Desktop View (>= 990px): Logo Left Aligned */
  @media (min-width: 990px) {
    .wt-header__col--left .wt-header__logo {
      position: static !important;
      transform: none !important;
      left: auto !important;
      top: auto !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      z-index: auto !important;
      text-align: left !important;
      overflow: visible !important;
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      line-height: 1;
    }

    .wt-header__col--left .wt-header__logo__link {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      width: var(--logo-width-desk, 220px) !important;
      margin: 0 !important;
      text-decoration: none !important;
      color: inherit !important;
    }

    .wt-header__col--left .wt-header__logo__img {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      max-height: var(--logo-max-height-desk, 75px) !important;
      object-fit: contain !important;
      object-position: left center !important;
      margin: 0 !important;
      transition: transform 0.3s ease !important;
    }

    .wt-header__col--left .wt-header__logo__img--mobile {
      display: none !important;
    }
  }

  /* ---------------- Center Column: Desktop Centered Navigation ---------------- */
  .wt-header__col--center {
    display: none !important;
  }

  @media (min-width: 990px) {
    body:not(.mobile-nav) .wt-header__col--center {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      min-width: 0 !important;
      width: 100% !important;
      z-index: 5 !important;
    }
  }

  .wt-header__desktop-nav {
    width: 100% !important;
    display: flex !important;
    justify-content: center !important;
  }

  .mega-menu--inline {
    width: 100% !important;
    display: flex !important;
    justify-content: center !important;
    overflow-y: visible !important;
  }

  .wt-page-nav-mega--inline {
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    position: static !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__list {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: var(--menu-item-spacing, 26px) !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__item {
    position: relative !important;
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link {
    display: inline-flex !important;
    align-items: center !important;
    padding: 8px 0 !important;
    text-decoration: none !important;
    color: var(--header-text-color, #1a1a1a) !important;
    font-size: var(--menu-font-size, 14px) !important;
    font-weight: var(--menu-font-weight, 500) !important;
    letter-spacing: var(--menu-letter-spacing, 1px) !important;
    text-transform: var(--menu-text-transform, uppercase) !important;
    transition: color 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    position: relative !important;
    white-space: nowrap !important;
    cursor: pointer !important;
    height: auto !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link:hover,
  .wt-page-nav-mega--inline .wt-page-nav-mega__link--active,
  .wt-page-nav-mega--inline .wt-page-nav-mega__item.dropdown-opened > .wt-page-nav-mega__link {
    color: var(--menu-hover-color, #d4af37) !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link__text {
    position: relative !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link__text::after {
    content: '' !important;
    position: absolute !important;
    bottom: -4px !important;
    left: 0 !important;
    right: 0 !important;
    height: 2px !important;
    background: var(--menu-hover-color, #d4af37) !important;
    transform: scaleX(0) !important;
    transform-origin: center !important;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    border-radius: 2px !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link:hover .wt-page-nav-mega__link__text::after,
  .wt-page-nav-mega--inline .wt-page-nav-mega__item.dropdown-opened > .wt-page-nav-mega__link .wt-page-nav-mega__link__text::after,
  .wt-page-nav-mega--inline .wt-page-nav-mega__link--active .wt-page-nav-mega__link__text::after {
    transform: scaleX(1) !important;
  }

  .wt-page-nav-mega--inline .wt-page-nav-mega__link .svg-icon {
    display: none !important;
  }

  /* ---------------- Dropdowns & Mega Menu in Inline Layout ---------------- */
  @media (min-width: 990px) {
    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper {
      position: absolute !important;
      top: 100% !important;
      z-index: 100 !important;
      background: #ffffff !important;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.1) !important;
      border-top: 1px solid #f0eee9 !important;
      border-bottom: 1px solid #e8e5df !important;
      max-height: 0 !important;
      overflow: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
      transition: max-height 0.35s ease, opacity 0.25s ease !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent.dropdown-opened .wt-page-nav-mega__sublist__wrapper {
      max-height: 85vh !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      overflow-y: auto !important;
    }

    /* Simple Dropdown Card */
    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--simple {
      width: auto !important;
      min-width: 240px !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      border-radius: 8px !important;
      border: 1px solid #f0eee9 !important;
      padding: 10px 0 !important;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12) !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--simple .wt-page-nav-mega__sublist {
      display: flex !important;
      flex-direction: column !important;
      padding: 8px 0 !important;
      background: transparent !important;
      margin: 0 !important;
      border: 0 !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--simple .wt-page-nav-mega__sublist__item {
      padding: 0 !important;
      width: 100% !important;
      border: 0 !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--simple .wt-page-nav-mega__sublist__link {
      display: block !important;
      padding: 10px 24px !important;
      color: #1a1a1a !important;
      font-size: 13.5px !important;
      font-weight: 500 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.8px !important;
      transition: all 0.2s ease !important;
      text-decoration: none !important;
      border: 0 !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--simple .wt-page-nav-mega__sublist__link:hover {
      background-color: #faf8f5 !important;
      color: var(--menu-hover-color, #d4af37) !important;
      padding-left: 28px !important;
    }

    /* Mega Menu Full-Width Container */
    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--mega {
      left: 0 !important;
      right: 0 !important;
      width: 100vw !important;
      margin-left: calc(50% - 50vw) !important;
    }

    body:not(.mobile-nav) .wt-header .wt-page-nav-mega__item--parent .wt-page-nav-mega__sublist__wrapper--mega > .wt-page-nav-mega__sublist {
      max-width: var(--header-max-width, 1440px) !important;
      margin: 0 auto !important;
      padding: 32px 24px !important;
    }
  }

  /* ---------------- Right Column: Search, Account, Cart ---------------- */
  .wt-header__col--right {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: calc(var(--gap, 8px) * 1.5) !important;
    z-index: 10 !important;
  }

  @media (min-width: 990px) {
    .wt-header__col--right {
      gap: calc(var(--gap, 8px) * 2.25) !important;
    }
  }

  .wt-header__col--right .wt-header__search {
    margin-right: 0 !important;
    display: flex !important;
    align-items: center !important;
  }

  .wt-header__col--right .wt-header__search-trigger {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    color: inherit !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
  }

  .wt-header__col--right .wt-header__search-trigger:hover,
  .wt-header__col--right .wt-header__panel__link:hover {
    color: var(--menu-hover-color, #d4af37) !important;
    transform: translateY(-1px) !important;
  }

  .wt-header__col--right .wt-header__panel {
    display: flex !important;
    align-items: center !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: calc(var(--gap, 8px) * 1.5) !important;
  }

  @media (min-width: 990px) {
    .wt-header__col--right .wt-header__panel {
      gap: calc(var(--gap, 8px) * 2) !important;
    }
  }

  .wt-header__col--right .wt-header__panel__item {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    margin: 0 !important;
  }

  .wt-header__col--right .wt-header__panel__link {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: inherit !important;
    text-decoration: none !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
    position: relative !important;
  }

  /* ---------------- Cart Counter Badge ---------------- */
  .wt-header__panel__counter,
  .flo-cart-icon-bubble {
    min-width: 19px !important;
    height: 19px !important;
    padding: 0 4px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #000000 !important;
    color: #d4af37 !important;
    border: 1px solid #d4af37 !important;
    border-radius: 50% !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    position: absolute !important;
    top: -6px !important;
    right: -8px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25) !important;
  }

  /* ---------------- Prevent Duplicate Drawer Menu Bar on Desktop ---------------- */
  @media (min-width: 990px) {
    .wt-drawer--nav,
    body:not(.mobile-nav) .wt-drawer--nav,
    body:not(.mobile-nav) .wt-drawer,
    body:not(.mobile-nav) .wt-header ~ .wt-drawer--nav,
    .wt-header ~ .wt-drawer--nav {
      display: none !important;
      position: fixed !important;
      transform: translateX(-100%) !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      height: 0 !important;
      min-height: 0 !important;
      max-height: 0 !important;
      overflow: hidden !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
    }
  }
{% endstyle %}

{% if section.settings.layout == 'option_inova' %}
  <!-- =========================================================================
       INOVA HEADER: MENU LEFT, LOGO CENTER, CURRENCY + ACTIONS RIGHT
       ========================================================================= -->
  <page-header
    role="banner"
    id="header"
    class="
      wt-header
      wt-header--inova
      {% if section.settings.show_shadow %} wt-header--shadow{% endif %}
      {% if section.settings.show_line_separator %} wt-header--separator{% endif %}
      {% if section.settings.sticky_header %} wt-header--sticky{% endif %}
    "
    {% if section.settings.sticky_header %}
      data-sticky="true"
    {% endif %}
  >
    <div class="wt-header__body wt-header__body--inova">
      <!-- LEFT: Mobile Menu Button + Inova Desktop Navigation -->
      <div class="wt-header__col wt-header__col--inova-left">
        <a
          href="#"
          class="wt-header__icon wt-header__menu-trigger inova-menu-trigger-mobile wt-icon"
          rel="toggle-menu"
          aria-label="{{ 'aria-label.page-header-toggle-menu' | t }}"
          aria-controls="wt-drawer-nav"
          aria-expanded="false"
          role="button"
          tabindex="0"
        >
          {% render 'icons', id: 'bars' %}
        </a>

        {%- assign inova_links_limit = section.settings.max_menu_links | default: 4 -%}
        <nav class="inova-desktop-nav" aria-label="Main Navigation">
          <ul class="inova-nav-list">
            {%- for link in section.settings.menu.links limit: inova_links_limit -%}
              <li class="inova-nav-item{% if link.links != blank %} inova-nav-item--has-children{% endif %}">
                <a href="{{ link.url }}" class="inova-nav-link{% if link.current %} inova-nav-link--active{% endif %}">
                  <span>{{ link.title | escape }}</span>
                  {% if link.links != blank %}
                    <svg class="inova-chevron-down" width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endif %}
                </a>
                {% if link.links != blank %}
                  <div class="inova-dropdown">
                    <ul class="inova-dropdown__list">
                      {% for childlink in link.links %}
                        <li class="inova-dropdown__item">
                          <a href="{{ childlink.url }}" class="inova-dropdown__link">{{ childlink.title | escape }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              </li>
            {%- endfor -%}

            {%- if section.settings.menu.links.size > inova_links_limit -%}
              <li class="inova-nav-item inova-nav-item--more inova-nav-item--has-children">
                <a href="#" class="inova-nav-link inova-nav-link--more" onclick="return false;">
                  <span>MORE</span>
                  <svg class="inova-chevron-down" width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <div class="inova-dropdown">
                  <ul class="inova-dropdown__list">
                    {% for link in section.settings.menu.links offset: inova_links_limit %}
                      <li class="inova-dropdown__item">
                        <a href="{{ link.url }}" class="inova-dropdown__link">{{ link.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      </div>

      <!-- CENTER: Centered Brand Logo -->
      <div class="wt-header__col wt-header__col--inova-center">
        <h1 itemscope itemtype="http://schema.org/Organization" class="wt-header__logo inova-header__logo">
          <a href="{{ routes.root_url }}" class="wt-header__logo__link inova-logo__link">
            {%- if section.settings.logo != blank -%}
              {%- assign large_image_size = section.settings.large_screen_logo_width | default: 220 -%}
              {%- assign large_image_size_double = large_image_size | times: 2 -%}
              <img
                srcset="{{ section.settings.logo | image_url: width: large_image_size }} 1x, {{ section.settings.logo | image_url: width: large_image_size_double }} 2x"
                src="{{ section.settings.logo | image_url: width: large_image_size }}"
                loading="lazy"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                class="wt-header__logo__img inova-logo-desk"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              >
              {%- assign mobile_image_size = section.settings.mobile_screen_logo_width | default: 140 -%}
              {%- assign mobile_image_size_double = mobile_image_size | times: 2 -%}
              <img
                srcset="{{ section.settings.logo | image_url: width: mobile_image_size }} 1x, {{ section.settings.logo | image_url: width: mobile_image_size_double }} 2x"
                src="{{ section.settings.logo | image_url: width: mobile_image_size }}"
                loading="lazy"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                class="wt-header__logo__img inova-logo-mob"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              >
            {%- else -%}
              <span class="wt-header__logo__text inova-brand-text">{{ section.settings.inova_logo_text | default: 'I N O V A' }}</span>
            {%- endif -%}
          </a>
        </h1>
      </div>

      <!-- RIGHT: Currency Selector Pill + Search + Account + Cart -->
      <div class="wt-header__col wt-header__col--inova-right">
        {%- if section.settings.show_currency_selector != false -%}
          <div class="inova-currency-pill" role="button" tabindex="0" aria-label="Currency: {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}">
            <span class="inova-pill-flag">🇮🇳</span>
            <span class="inova-pill-code">{{ localization.country.currency.iso_code | default: 'INR' }}</span>
