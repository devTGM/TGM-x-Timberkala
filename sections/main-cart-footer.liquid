{% if cart != empty %}
  <style>
    [data-section-id="{{ section.id }}"]
      {

          {% if section.settings.margin-top %}
              --section-gap-top: {{ section.settings.margin-top }}px;
          {% endif %}

          {% if section.settings.margin-bottom %}
              --section-gap-bottom: {{ section.settings.margin-bottom }}px;
          {% endif %}

      }
  </style>
  <div
    data-section-id="{{ section.id }}"
    class="wt-cart__wrapper cart-page"
    id="main-cart-footer"
    data-id="{{ section.id }}"
  >
    <div>
      <div class="wt-cart__footer">
        {%- if settings.cart_show_order_note -%}
          <collapsible-section
            class="wt-cart__note__wrapper"
          >
            <div
              class="wt-cart__note__trigger wt-collapse__trigger wt-cart__subtitle"
              role="button"
              tabindex="0"
              data-open="false"
              aria-expanded="false"
              aria-controls="CollapsibleTab-{{ section.id }}"
            >
              {{ 'sections.cart.note' | t }}
              {% render 'icons', id: 'plus' %}
            </div>

            <cart-note class="wt-cart__note wt-collapse__target" id="CollapsibleTab-{{ section.id }}">
              <label
                class="form__field"
                for="Cart-note-{{ section.id }}"
              >
                <textarea
                  class="form__field__textarea"
                  name="note"
                  form="cart"
                  id="Cart-note-{{ section.id }}"
                  placeholder=" "
                >{{ cart.note }}</textarea>
                <span class="form__field__label">
                  {{ 'sections.cart.note' | t }}
                </span>
              </label>
            </cart-note>
          </collapsible-section>
        {%- endif -%}
        <div class="wt-cart__subtitle">
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{
              'sections.cart.taxes_included_and_shipping_policy_html'
              | t: link: shop.shipping_policy.url, tabindex: 0
            }}
          {%- elsif cart.taxes_included -%}
            {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{
              'sections.cart.taxes_and_shipping_policy_at_checkout_html'
              | t: link: shop.shipping_policy.url, tabindex: 0
            }}
          {%- else -%}
            {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
          {%- endif -%}
        </div>
        <div class="wt-cart__footer__body">
          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
              {%- when 'subtotal' -%}
                {% assign discount_rate = 0.20 %}
                {% assign raw_subtotal = cart.total_price %}
                {% assign discount_amount = raw_subtotal | times: discount_rate | round %}
                {% assign final_total = raw_subtotal | minus: discount_amount %}

                <div class="js-contents">
                  {% if cart != empty %}
                    <!-- Festive Promo Box -->
                    <div style="margin: 8px 0 12px; padding: 10px 14px; background: #fffdf9 radial-gradient(ellipse 95% 125% at 50% 50%, #fffdf8 0%, #faf3e8 100%); border: 1.5px solid #d4a75e; border-radius: 9px; box-shadow: 0 2px 8px rgba(125, 15, 21, 0.05); box-sizing: border-box;">
                      <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 3px;">
                        <span style="display: inline-flex; align-items: center; gap: 5px; background: #faebd7; border: 1px dashed #c48b28; border-radius: 4px; padding: 2px 7px; font-family: monospace, -apple-system, sans-serif; font-size: 11.5px; font-weight: 800; color: #820b12; letter-spacing: 0.8px;">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                            <line x1="7" y1="7" x2="7.01" y2="7"/>
                          </svg>
                          DIWALI20
                        </span>
                        <span style="font-size: 10px; font-weight: 700; color: #15803d; background: rgba(21, 128, 61, 0.1); padding: 2px 6px; border-radius: 4px; letter-spacing: 0.2px;">✓ 20% OFF APPLIED</span>
                      </div>
                      <p style="margin: 0; font-size: 11px; color: #6d4e2d; line-height: 1.35;">Diwali Festive Offer: 20% discount is auto-applied at checkout!</p>
                    </div>

                    <!-- Pricing Breakdown -->
                    <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed #e6decb;">
                      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; color: #444;">
                        <span>Subtotal</span>
                        <span>{{ raw_subtotal | money_with_currency }}</span>
                      </div>
                      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; color: #15803d; font-weight: 600;">
                        <span>Diwali Savings (DIWALI20 · 20% OFF)</span>
                        <span>-{{ discount_amount | money_with_currency }}</span>
                      </div>
                      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; color: #15803d; font-weight: 600;">
                        <span>Pan-India Delivery</span>
                        <span>FREE</span>
                      </div>
                      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 15px; font-weight: 800; color: #1a1a1a; padding-top: 4px; border-top: 1px solid #eee8df;">
                        <span>Estimated Total</span>
                        <span>{{ final_total | money_with_currency }}</span>
                      </div>
                    </div>

                    <!-- Savings Pill -->
                    <div style="background: #eaf6ed; border: 1px solid #b8e2c2; color: #14532d; font-size: 12px; font-weight: 700; text-align: center; padding: 5px 10px; border-radius: 6px; margin: 4px 0 12px;">
                      🎉 You save {{ discount_amount | money_with_currency }} on this order!
                    </div>
                  {% else %}
                    <div class="wt-cart__subtotal " {{ block.shopify_attributes }}>
                      <div class="wt-cart__subtotal__label">
                        <span class="text">{{ 'sections.cart.subtotal' | t }}</span>
                      </div>
                      <div class="wt-cart__subtotal__value">
                        {{ cart.total_price | money_with_currency }}
                      </div>
                    </div>
                  {% endif %}

                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <div>
                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in cart.cart_level_discount_applications -%}
                          <li class="discounts__discount discounts__discount--position">
                            {%- render 'icon-discount' -%}
                            {{ discount.title }}
                            (-{{ discount.total_allocated_amount | money }})
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="wt-cart__actions" {{ block.shopify_attributes }}>
                  <noscript>
                    <button
                      aria-label="{{ 'sections.cart.update' | t }}"
                      type="submit"
                      class="cart__update-button button button--secondary"
                      form="cart"
                    >
                      {{ 'sections.cart.update' | t }}
                    </button>
                  </noscript>

                  {% comment %} <button
                    aria-label="{{ 'sections.cart.checkout' | t }}"
                    type="submit"
                    class="wt-cart__cta"
                    name="checkout"
                    {% if cart == empty %}
                      disabled
                    {% endif %}
                    form="cart"
                  >
                    {{ 'sections.cart.checkout' | t }}
                  </button> {% endcomment %}

                   <button type="button" style="width:100%; cursor:pointer;" id="checkout2" onclick="handleTimberkalaCheckout(event)" class="cart__checkout-button button" name="checkout2">
		{{ 'Checkout' }}
</button> 
                   <p style="text-align: center; font-size: 11px; color: #666; margin: 6px 0 0;">
                     🔒 Code <strong>DIWALI20</strong> automatically applies at checkout
                   </p> 

                  <a href="{{ routes.all_products_collection_url }}" class="wt-more wt-cart__back-link">
                    <span class="wt-more__text">{{ 'general.continue_shopping' | t }}</span>
                    {% render 'icons', id: 'arrow-right' %}
                  </a>
                </div>

                {%- if additional_checkout_buttons -%}
                  <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {% endfor %}
          <div id="cart-errors"></div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<script>
  if (typeof window.handleTimberkalaCheckout !== 'function') {
    window.handleTimberkalaCheckout = function(e) {
      if (e && e.preventDefault) e.preventDefault();
      var code = 'DIWALI20';
      fetch('/discount/' + code)
        .finally(function() {
          if (typeof window.handleFloCheckoutBtn === 'function') {
            window.handleFloCheckoutBtn();
          } else {
            window.location.href = '/checkout?discount=' + code;
          }
        });
    };
  }
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 40,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom-liquid.settings.custom_liquid.label",
          "info": "t:sections.custom-liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
